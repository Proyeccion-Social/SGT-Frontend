---
import { Image } from "astro:assets";
import icon from "../assets/imgs/icon.svg"; 
import ChangePasswordForm from "./islands/ChangePasswordForm";
import ChangePasswordGreeting from "./islands/ChangePasswordGreeting";
---

<div class='containerChangePassword'>
  <section class='leftSideContainer'>
    <ChangePasswordForm client:load />
  </section>
  <section class='rightSideContainer'>
    <Image src={icon} alt='Icono de cambio de contraseña' class='iconAtlas' />
    <ChangePasswordGreeting client:load />
  </section>
</div>

<style>
  .containerChangePassword {
    display: flex;
    width: 100%;
    height: 100vh;
    padding: 24px;
    gap: 24px;
  }

  .leftSideContainer {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: 1px solid #C6C6C6;
    border-radius: 24px;
    padding: 40px;
    position: relative;
  }

  .rightSideContainer {
    flex: 1;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(180deg, #8751FF 0%, #E7DCFF 100%);
    border-radius: 24px;
  }

  .iconAtlas {
    position: absolute;
    bottom: -310px;
    right: -200px;
    height: 900px;
    width: 900px;
    transform: rotate(-22.83deg);
  }

  .sideBgImage {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
  }
</style>
