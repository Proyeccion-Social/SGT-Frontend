---
import AuthDialogLayout from "@/layouts/auth/AuthDialogLayout.astro";
import ForgotPasswordCard from "./ForgotPasswordCard.astro";
import ForgotPasswordHeader from "../components/ForgotPasswordHeader.astro";
import ForgotPasswordForm from "../components/ForgotPasswordForm.astro";
import ToasterReact from "@/components/ui/ToasterReact";
---

<AuthDialogLayout
  dialogId='forgotPasswordDialog'
  dialogClass='forgotPasswordDialog'
>
  <ForgotPasswordCard>
    <ForgotPasswordHeader />
    <ForgotPasswordForm />
  </ForgotPasswordCard>
  <ToasterReact client:load isLocal />
</AuthDialogLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const forgotPasswordDialog = document.getElementById(
      "forgotPasswordDialog",
    ) as HTMLDialogElement;
    const closeButtons = forgotPasswordDialog?.querySelectorAll(
      "[data-close-dialog]",
    );

    function closeDialog() {
      forgotPasswordDialog?.classList.add("closing");
      setTimeout(() => {
        forgotPasswordDialog?.close();
        forgotPasswordDialog?.classList.remove("closing");
        document.body.style.overflow = "";
      }, 200);
    }

    closeButtons?.forEach((btn) => {
      btn.addEventListener("click", closeDialog);
    });

    forgotPasswordDialog?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        closeDialog();
      }
    });

    forgotPasswordDialog?.addEventListener("close-request", () => {
      closeDialog();
    });
  });
</script>
