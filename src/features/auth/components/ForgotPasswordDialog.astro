---
import ForgotPasswordCard from "./ForgotPasswordCard.astro";
import ForgotPasswordHeader from "./ForgotPasswordHeader.astro";
import ForgotPasswordForm from "./ForgotPasswordForm.astro";
---

<dialog id="forgotPasswordDialog" class="forgotPasswordDialog">
  <div class="dialogBackdrop" data-close-dialog></div>
  <div class="dialogContent">
    <button class="closeBtn" data-close-dialog aria-label="Cerrar">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
    <ForgotPasswordCard>
      <ForgotPasswordHeader />
      <ForgotPasswordForm />
    </ForgotPasswordCard>
  </div>  
</dialog>

<script>
  const textRecuperar = document.querySelector(".forgot-password") as HTMLElement;
  const forgotPasswordDialog = document.getElementById("forgotPasswordDialog") as HTMLDialogElement;
  const closeButtons = forgotPasswordDialog.querySelectorAll("[data-close-dialog]");

  function closeDialog() {
    forgotPasswordDialog?.classList.add("closing");
    setTimeout(() => {
      forgotPasswordDialog?.close();
      forgotPasswordDialog?.classList.remove("closing");
      document.body.style.overflow = "";
    }, 200);
  }

  textRecuperar.addEventListener("click", () => {
    forgotPasswordDialog.showModal();
    document.body.style.overflow = "hidden";
  });

  closeButtons.forEach((btn) => {
    btn.addEventListener("click", closeDialog);
  });

  // Cerrar con Escape
  forgotPasswordDialog?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      e.preventDefault();
      closeDialog();
    }
  });
</script>

<style>
  .forgotPasswordDialog {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease-out,
      visibility 0.2s ease-out;
  }

  .forgotPasswordDialog[open] {
    opacity: 1;
    visibility: visible;
  }

  .forgotPasswordDialog::backdrop {
    display: none;
  }

  .dialogBackdrop {
    position: absolute;
    inset: 0;
    background: rgba(207, 185, 255, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }

  .forgotPasswordDialog[open] .dialogBackdrop {
    opacity: 1;
  }

  .dialogContent {
    position: relative;
    z-index: 1;
    transform: scale(0.95) translateY(10px);
    opacity: 0;
    transition:
      transform 0.25s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.2s ease-out;
  }

  .forgotPasswordDialog[open] .dialogContent {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .closeBtn {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 10;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    color: #666;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .closeBtn:hover {
    background: rgba(0, 0, 0, 0.05);
    color: #1a1a1a;
  }

  /* Animación de salida */
  .forgotPasswordDialog.closing {
    opacity: 0;
  }

  .forgotPasswordDialog.closing .dialogBackdrop {
    opacity: 0;
  }

  .forgotPasswordDialog.closing .dialogContent {
    transform: scale(0.95) translateY(10px);
    opacity: 0;
  }
</style>