<form id="forgot-password-form" class="forgot-password-form">
    <div class="field">
        <label for="email">Email</label>
        <input
        id="emailForgot"
        type="email"
        placeholder="nombre@udistrital.edu.co"
        required
        />
    </div>

    <button type="submit">Enviar link de recuperación</button>
</form>

<script>
    import { sileo } from "sileo";

    const form = document.getElementById("forgot-password-form");
    const emailInput = document.getElementById("emailForgot");

    form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = emailInput.value;

    await sileo
    .promise(
        async () => {
            const response = await fetch("/api/auth/recover-password", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ email }),
            });

            if (!response.ok) {
                const errorData = await response.json().catch(() => ({}));
                throw new Error(errorData.error || "Error al enviar el correo");
            }
        },
        {
            loading: { title: "Enviando correo...", fill: "#8751ff" },
            success: { title: "Correo enviado", description: "Revisa tu bandeja de entrada para continuar el proceso.", fill: "#58d68d" },
            error: { title: "Error al enviar", description: "El correo no está registrado o ocurrió un error", fill: "#f35761" },
        },
        )
        .then(() => {
            sileo.action({
                title: "Correo enviado",
                description: "Revisa tu bandeja de entrada para continuar el proceso.",
                button: {
                title: "Ir a Outlook",
                    onClick: () => window.open("https://outlook.office.com/mail/", "_blank"),
                },
                fill: "#8751ff",
                styles: {
                    badge: { fill: "#ffffff" },
                },
            });
        })
        .catch(() => {});
    });
</script>


<style>
    .forgot-password-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 370px;
    }

    .field {
        font-family: "Open Sauce Two", system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field label {
        font-size: 14px;
        font-weight: 500;
        font-style: medium;
        color: #1a1a1a;
    }

    .field input {
        width: 100%;
        height: 48px;
        padding: 0 16px;
        font-size: 14px;
        font-weight: 400;
        border-radius: 12px;
        border: none;
        background-color: #e8e8e8;
        color: #5f5f5f;
        outline: 0;
    }

    .field input::focus{
        outline: none;
        box-shadow: 0 0 0 2px rgba(135, 81, 255, 0.25);
    }

    .forgot-password-form button {
        width: 100%;
        height: 56px;
        font-family: "Open Sauce Two", system-ui, sans-serif;
        font-size: 16px;
        font-style: bold;
        font-weight: 700;
        line-height: 100%;
        color: #ffffff;
        background-color: #8751ff;
        border-radius: 8px;
        border: none;
        cursor: pointer;
    }

    .forgot-password-form button:hover {
        background-color: #6c41cc;
    }

</style>