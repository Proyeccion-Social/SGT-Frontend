<form id="forgot-password-form" class="forgot-password-form">
    <div class="field">
        <label for="email">Email</label>
        <input
        id="emailForgot"
        type="email"
        placeholder="nombre@udistrital.edu.co"
        required
        />
    </div>

    <button type="submit">Enviar link de recuperación</button>
</form>

<script>
    const form = document.getElementById("forgot-password-form");
    const emailInput = document.getElementById("emailForgot");
    
    import { sileo } from "sileo";
    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = emailInput.value;
        console.log("Email enviado para recuperación de contraseña:", email);
        try {
            const response = await fetch("/api/auth/recover-password", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ email }),
            });
            if (response.ok) {
                sileo.action({
                    title: "Correo enviado",
                    description: "Revisa tu bandeja de entrada para continuar el proceso.",
                    button: {
                        title: "Ir a Outlook",
                        onClick: () => {
                            window.open("https://outlook.office.com/mail/", "_blank");
                        },
                    },
                    fill: "#8751ff",
                    styles: {
                        badge: { fill: "#ffffff" },
                        button: "#ffffff hover:#ffffff"
                    }
                });
            } else {
                sileo.action({
                    title: "Error al enviar",
                    description: "No se pudo enviar el correo de recuperación.",
                    button: {
                        title: "Intentar de nuevo",
                        onClick: () => emailInput.focus(),
                    },
                    fill: "#f35761",
                    styles: {
                        title: "#ffffff!",
                        description: "#ffffff!",
                        badge: { fill: "#ffffff!" },
                        button: "bg-white/10! hover:bg-white/15!"
                    }
                });
            }
        } catch (error) {
            sileo.action({
                title: "Error de red",
                description: "Ocurrió un error inesperado.",
                button: {
                    title: "Cerrar",
                    onClick: () => {},
                },
                fill: "#f35761",
                styles: {
                    title: "#ffffff!",
                    description: "#ffffff!",
                    badge: { fill: "#ffffff!" },
                    button: "bg-white/10! hover:bg-white/15!"
                }
            });
            console.error("Error al enviar el correo de recuperación:", error);
        }
    });
</script>


<style>
    .forgot-password-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 370px;
    }

    .field {
        font-family: "Open Sauce Two", system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field label {
        font-size: 14px;
        font-weight: 500;
        font-style: medium;
        color: #1a1a1a;
    }

    .field input {
        width: 100%;
        height: 48px;
        padding: 0 16px;
        font-size: 14px;
        font-weight: 400;
        border-radius: 12px;
        border: none;
        background-color: #e8e8e8;
        color: #5f5f5f;
        outline: 0;
    }

    .field input::focus{
        outline: none;
        box-shadow: 0 0 0 2px rgba(135, 81, 255, 0.25);
    }

    .forgot-password-form button {
        width: 100%;
        height: 56px;
        font-family: "Open Sauce Two", system-ui, sans-serif;
        font-size: 16px;
        font-style: bold;
        font-weight: 700;
        line-height: 100%;
        color: #ffffff;
        background-color: #8751ff;
        border-radius: 8px;
        border: none;
        cursor: pointer;
    }

    .forgot-password-form button:hover {
        background-color: #6c41cc;
    }

</style>