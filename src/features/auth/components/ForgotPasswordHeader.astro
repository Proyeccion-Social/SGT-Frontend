---
import { Image } from "astro:assets"
import icon from "../assets/imgs/icon.svg"
---

<div class="forgot-password-header">
    <article class="logo">
        <Image src={icon} alt="Logo Atlas"/>
    </article>
    <h5 class="title">Recuperamos tu contraseña</h5>
    <h6 class="subtitle">Ingresa el correo y te enviaremos el link de recuperación</h6>
</div>

<style>
    .forgot-password-header {
        display: flex;
        font-family: "Open Sauce Two", system-ui, sans-serif;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
    }

    .logo img {
        height: 121px;
        width: auto;
    }

    .title {
        font-size: 24px;
        font-style: bold;
        line-height: 24px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #1a1a1a;
        text-align: center;
        margin: 0;
    }

    .subtitle {
        font-size: 14px;
        font-weight: 400;
        letter-spacing: -0.02em;
        color: #454545;
        text-align: center;
        margin: 0;
    }
</style>