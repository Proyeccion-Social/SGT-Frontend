---
import { Image } from "astro:assets"; 
import Arrow from "../assets/imgs/Arrow.svg"
---
<div class="login-card">
    <article class="arrowText">
        <Image src={Arrow} alt="Flecha izquierda" />
        <p>Solo correos @udistrital.edu.co</p>
    </article>
    <slot/>
</div>

<style>
    .login-card {
        background: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        width: 484px;
        height: 569px;

        background: #FFFFFF;
        box-shadow: 0px 4px 37px 4px rgba(0, 0, 0, 0.1);
        border-radius: 24px;
        transition: height 0.3s ease-in-out;
        position: relative;
    }

    .arrowText {
        display: flex;
        position: absolute;
        left: -120px;
        top: -100px;

        opacity: 1;
        transition: opacity .3s ease,
            display .3s ease allow-discrete;

        @starting-style {
            opacity: 0;
        }
    }

    .arrowText.hidden {
        display: none;
        opacity: 0;
    }

    .arrowText p {
        position: absolute;
        left: 30px;
        top: 10px;
        width: 500px;

        font-family: 'Caveat';
        font-style: normal;
        font-weight: 400;
        font-size: 24px;
        line-height: 30px;

        color: #FFFFFF;


    }
</style>