---
// Login form component
/*
Componente de formulario de login en dos pasos
Step 1: Email Validation (Default)
Step 2: PAssword input (if user exists)
*/

import LoginCard from "./LoginCard.astro"
import LoginHeader from "./LoginHeader.astro"
---

<LoginCard>
  <LoginHeader />
    <form class="login-form">
      <div class="field">
        <label for="email">Email</label>
        <input 
          type="email"
          id="email"
          placeholder="nombre@usitrital.edu.co"
        />
      </div>

      <button type="submit">
        Continuar
      </button>
    </form>
</LoginCard>

<style>
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    color: #1a1a1a;
  }

  .field input {
    width: 100%;
    max-width: 370px;
    height: 48px;
    padding: 0 16px;
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    border-radius: 12px;
    border: none;
    background-color: #e8e8e8;
    color: #5f5f5f;
  }

  .field input::placeholder {
    color: #8a8a8a;
  }

  .fiel input:focus {
    outline: none;
    box-shadow: 0 0 0 2px rbga(135, 81, 255, 0.25);
  }

  button {
    width: 100%;
    max-width: 370px;
    height: 56px;
    border: none;
    border-radius: 8px;
    background-color: #8751ff;
    color: #ffffff;
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    cursor:pointer;
  }

  button:hover {
    background-color: #6C41CC;
  }
</style>
