---
// Login form component
/*
Componente de formulario de login en dos pasos
Step 1: Email Validation (Default)
Step 2: PAssword input (if user exists)
*/

import LoginCard from "./LoginCard.astro"
import LoginHeader from "./LoginHeader.astro"
---

<LoginCard>
  <div class='login-form'>
    <LoginHeader />
    <form id="loginForm">
      <input
        type="email"
        id="email"
        name="email"
        placeholder="nombre@udistrital.edu.co"
        required
      />
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Contraseña"
        style="display: none;"
      />
      <p class="error" id="error" style="display: none;"></p>
      <button type="submit">Continuar</button>
    </form>
  </div>
</LoginCard>

<style>
  .login-form {
    padding: 2rem;
  }
</style>
