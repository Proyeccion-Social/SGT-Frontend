<form id="login-form" class="login-form">
  <div class="field">
    <label for="email">Email</label>
    <input
      id="email"
      type="email"
      placeholder="nombre@udistrital.edu.co"
      required
    />
  </div>

  <div id="password-field" class="field">
    <article>
      <label for="password">Contraseña</label>
      <a href="#" class="forgot-password">¿Olvidaste tu contraseña?</a>
    </article>
    <input id="password" type="password" placeholder="Ingresa tu contraseña" />
  </div>

  <button type="submit">Continuar</button>
</form>

<script>
  import { sileo } from "sileo";

  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const passwordField = document.getElementById("password-field");
  const emailInput = document.getElementById(
    "email",
  ) as HTMLInputElement | null;
  const passwordInput = document.getElementById(
    "password",
  ) as HTMLInputElement | null;
  const loginCard = document.querySelector(".login-card") as HTMLElement | null;
  const arrowText = document.querySelector(".arrowText");

  let passwordVisible = false;

  document.addEventListener("reset-login-form", () => {
    passwordVisible = false;
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!passwordVisible) {
      await sileo
        .promise(
          async () => {
            console.log("Validating email:", emailInput.value);
            const res = await fetch("api/auth/validate-email", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                email: emailInput.value,
              }),
            });

            if (!res.ok) {
              const errorData = await res.json().catch(() => ({}));
              throw new Error(errorData.error || "Error validando email");
            }

            const data = await res.json();
            console.log(data);

            if (data.isValid) {
              passwordField?.classList.add("visible");
              arrowText?.classList.add("hidden");

              if (loginCard) loginCard.style.height = "auto";

              passwordInput?.focus();
              passwordVisible = true;
            } else {
              throw new Error("Email no válido");
            }
          },
          {
            loading: { title: "Validando email...", fill: "#8751ff" },
            success: { title: "Email válido", fill: "#58d68d" },
            error: {
              title: "Error validando email",
              description: "El email no está registrado, crea una cuenta",
              fill: "#f35761",
            },
          },
        )
        .catch((err) => {});
      return;
    }

    await sileo
      .promise(
        async () => {
          console.log("Password: ", passwordInput.value);
          const res = await fetch("api/auth/login", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              email: emailInput.value,
              password: passwordInput.value,
            }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.message || "Login failed");
          }

          console.log('[Login] data completa:', data);
          // Guardar usuario en sessionStorage para hidratar el store
          sessionStorage.setItem(
  "auth_user",
  JSON.stringify({
    user: data.user,
    token: data.token,                              // ← ADD
    requiresPasswordChange: data.requiresPasswordChange,
    requiresProfileCompletion: data.requiresProfileCompletion,
  }),
);

          // Redirigir según estado del usuario
          if (data.requiresProfileCompletion) {
            window.location.href = "/complete-profile";
          } else if (data.requiresPasswordChange) {
            window.location.href = "/change-password";
          } else {
            window.location.href = "/dashboard";
          }
        },
        {
          loading: { title: "Iniciando sesión...", fill: "#8751ff" },
          success: { title: "Sesión iniciada", fill: "#58d68d" },
          error: {
            title: "Credenciales incorrectas",
            description: `Verifica tus credenciales e intenta nuevamente`,
            fill: "#f35761",
          },
        },
      )
      .catch((err) => {});
  });
</script>

<style>
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 370px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .field input {
    width: 100%;
    /*max-width: 370px;*/
    height: 48px;
    padding: 0 16px;
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 14px;
    border-radius: 12px;
    border: none;
    background-color: #e8e8e8;
    color: #5f5f5f;
  }

  .fiel input:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(135, 81, 255, 0.25);
  }

  .field article {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .field article a {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 300;
    font-size: 12px;
    line-height: 15px;
    color: #3c3c3c;
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
  }

  .field article a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1px;
    background-color: #8751ff;
    transition: width 0.25s ease;
  }

  .field article a:hover {
    color: #8751ff;
  }

  .field article a:hover::after {
    width: 100%;
  }

  .field article a:active {
    color: #6c41cc;
  }

  .field article a:active::after {
    background-color: #6c41cc;
    width: 100%;
  }

  #password-field {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.3s ease-in-out,
      opacity 0.3s ease-in-out;
  }

  #password-field.visible {
    margin-bottom: 10px;
    opacity: 1;
    max-height: 150px;
  }

  .login-form button {
    width: 100%;
    /*max-width: 370px;*/
    height: 56px;
    border-radius: 8px;
    border: none;
    background-color: #8751ff;
    color: #ffffff;
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 20px;
    font-style: bold;
    font-weight: 700;
    line-height: 100%;
    cursor: pointer;
  }

  .login-form button:hover {
    background-color: #6c41cc;
  }

  #email:focus,
  #password:focus {
    outline: none;
  }
</style>
