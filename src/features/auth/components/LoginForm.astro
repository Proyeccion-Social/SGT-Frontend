<form id='login-form' class='login-form'>
  <div class='field'>
    <label for='email'>Email</label>
    <input
      id='email'
      type='email'
      placeholder='nombre@udistrital.edu.co'
      required
    />
  </div>

  <div id='password-field' class='field'>
    <article>
        <label for='password'>Contraseña</label>
        <a href='#' class='forgot-password'>¿Olvidaste tu contraseña?</a>
    </article>
    <input id='password' type='password' placeholder='Ingresa tu contraseña' />
  </div>

  <button type='submit'>Continuar</button>
</form>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const passwordField = document.getElementById("password-field");
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const loginCard = document.querySelector(".login-card") as HTMLElement;
  const arrowText = document.querySelector('.arrowText') as HTMLElement;
  
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!passwordField?.classList.contains("visible")) {
      passwordField?.classList.add("visible");
      arrowText.classList.add('hidden');
    if (loginCard) loginCard.style.height = "655px";
      passwordInput?.focus();
      return;
    }

    const email = emailInput?.value;
    const password = passwordInput?.value;

    console.log("Login:", email, password);
  });
</script>

<style>
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 370px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .field input {
    width: 100%;
    max-width: 370px;
    height: 48px;
    padding: 0 16px;
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 14px;
    border-radius: 12px;
    border: none;
    background-color: #e8e8e8;
    color: #5f5f5f;
  }

  .fiel input:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(135, 81, 255, 0.25);
  }

  .field article {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .field article a {
    font-family: 'Open Sauce Two';
    font-style: normal;
    font-weight: 300;
    font-size: 12px;
    line-height: 15px;
    color: #3C3C3C;
  }

  #password-field {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.3s ease-in-out,
      opacity 0.3s ease-in-out;
  }

  #password-field.visible {
    margin-bottom: 10px;
    opacity: 1;
    max-height: 150px;
  }

  .login-form button {
    width: 100%;
    max-width: 370px;
    height: 56px;
    border-radius: 8px;
    border: none;
    background-color: #8751ff;
    color: #ffffff;
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 20px;
    font-style: bold;
    font-weight: 700;
    line-height: 100%;
    cursor: pointer;
  }

  .login-form button:hover {
    background-color: #6c41cc;
  }

  #email:focus, #password:focus {
    outline: none;
  }
</style>