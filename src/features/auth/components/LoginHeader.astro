---
import { Image } from "astro:assets"
import icon from "../assets/imgs/favicon.svg"
---

<div class="login-header">
    <article class="logo">
        <Image src={icon} alt="Logo Atlas"/>
    </article>
    <h3 class="title">Inicia Sesión</h3>
    <h6 class="subtitle">Es hora de construir tu futuro</h6>
</div>

<style>
    .login-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .logo img {
        height: 121px;
        width: auto;
    }

    /* Título */
    .title {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #1a1a1a;
        text-align: center;
        margin: 0;
    }

    /* Subtítulo */
    .subtitle {
        font-size: 14px;
        font-weight: 400;
        line-height: 24px;
        color: #1a1a1a;
        text-align: center;
        margin: 0;
    }

</style>