---
import { Image } from "astro:assets";
import Arrow from "../assets/imgs/Arrow2.svg"
import SideImage from "../assets/imgs/SideImage.png"
---

<section class="registrySection">
    
    <article class="arrowText">
        <Image src={Arrow} alt="Flecha derecha" />
        <p>¡Bienvenido!</p>
    </article>
    <Image src={SideImage} alt="Imagen lateral" />
    <div class="registryCard">
        <button class="closeBtn" data-close-registry aria-label="Cerrar">
            <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
        </button>
        <slot/>
    </div>
</section>

<style>

    .registrySection {
        width: 90%;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        place-items: center;
        max-width: 968px;
        min-height: 655px;
        grid-template-rows: 655px;
        align-items: center;
        justify-content: center;
        position: relative;
        height: 100%;
        font-family: "Open Sauce Two";
    }
    

    .closeBtn {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 10;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        color: #666;
        transition:
            background 0.15s ease,
            color 0.15s ease;
  }

  .closeBtn:hover {
    background: rgba(0, 0, 0, 0.05);
    color: #1a1a1a;
  }
    .registrySection img,
    .registryCard {
        width: 100%;
        height: 100%;
    }

    .registrySection img {
        border-radius: 24px 0px 0px 24px;
    }

    .registryCard {
        border-radius: 0px 24px 24px 0px;
    }

    .registryCard {
        
        background: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0px 4px 37px 4px rgba(0, 0, 0, 0.1);
      
        transition: height 0.3s ease-in-out;
        position: relative;
    }
    .arrowText {
        display: flex;
        position: absolute;
        right: -70px;
        top: -40px;
        width: 87px;
        height: 41px;

        opacity: 1;
        transition: opacity .3s ease,
            display .3s ease allow-discrete;

        @starting-style {
            opacity: 0;
        }
    }

    .arrowText.hidden {
        display: none;
        opacity: 0;
    }

    .arrowText p {
        position: absolute;
        right: -95px;
        top: -20px;
        font-family: 'Caveat';
        font-style: normal;
        font-weight: 400;
        font-size: 24px;
        line-height: 30px;
        color: #FFFFFF;
    }

    @media (1024px <= width <= 1340px){
        .arrowText {
            right: 80px;
            top: -50px;
        }

        
    }

    @media (width >= 1024px){}
    @media (768px < width < 1024px){
        .arrowText{
            display: none;
        }
    }
    @media (width <= 768px) {
        .arrowText{
            display: none;
        }
        .registrySection {
            grid-template-columns: 1fr;
            max-width: 400px;
            grid-template-rows: repeat(2, auto); 
            grid-template-rows: 300px;
            width: 100%;

        }

        .registrySection img {
            border-radius: 24px 24px 0px 0px;
        }

        .registryCard {
            border-radius: 0px 0px 24px 24px;
        }

        .arrowText {
            display: none;
        }
    } 

</style>