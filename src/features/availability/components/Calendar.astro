---
import type { Slot } from "@/features/availability/services/availabilityService";

interface Props {
  slots: Slot[];
}

const { slots } = Astro.props;

const HOUR_START  = 7;
const HOUR_END    = 19;
const HOUR_HEIGHT = 64;
const TOTAL_HOURS = HOUR_END - HOUR_START;

const DAYS = [
  { key: "LUNES",     label: "Lunes" },
  { key: "MARTES",    label: "Martes" },
  { key: "MIERCOLES", label: "Miércoles" },
  { key: "JUEVES",    label: "Jueves" },
  { key: "VIERNES",   label: "Viernes" },
  { key: "SABADO",    label: "Sábado" },
];

const hours = Array.from({ length: TOTAL_HOURS }, (_, i) => HOUR_START + i);

function getWeekDates(): Record<string, number> {
  const today = new Date();
  const dayOfWeek = today.getDay();
  const monday = new Date(today);
  monday.setDate(today.getDate() - ((dayOfWeek + 6) % 7));
  const keys = ["LUNES","MARTES","MIERCOLES","JUEVES","VIERNES","SABADO"];
  const result: Record<string, number> = {};
  keys.forEach((key, i) => {
    const d = new Date(monday);
    d.setDate(monday.getDate() + i);
    result[key] = d.getDate();
  });
  return result;
}

const weekDates = getWeekDates();

function timeToMinutes(time: string): number {
  const [h, m] = time.split(":").map(Number);
  return h * 60 + m;
}

function getSlotStyle(slot: Slot): string {
  const startMin    = timeToMinutes(slot.startTime);
  const endMin      = slot.endTime ? timeToMinutes(slot.endTime) : startMin + 60;
  const calStartMin = HOUR_START * 60;
  const top         = ((startMin - calStartMin) / 60) * HOUR_HEIGHT;
  const height      = ((endMin - startMin) / 60) * HOUR_HEIGHT - 4;
  return `top: ${top}px; height: ${height}px;`;
}

function getSlotsByDay(dayKey: string): Slot[] {
  return slots.filter(s => s.dayOfWeek === dayKey);
}
---

<div class="calendar-outer">
  <div class="calendar-wrapper">

    <!-- Header de días -->
    <div class="calendar-header">
      <div class="time-gutter" />
      {DAYS.map(day => (
        <div class="day-header">
          <span class="day-name">{day.label}</span>
          <span class="day-number">
            {weekDates[day.key]?.toString().padStart(2, "0")}
          </span>
        </div>
      ))}
    </div>

    <!-- Cuerpo -->
    <div class="calendar-body">

      <!-- Columna de horas -->
      <div class="time-column">
        {hours.map(hour => (
          <div class="time-cell">{hour}:00</div>
        ))}
      </div>

      <!-- Columnas de días -->
      {DAYS.map(day => (
        <div class="day-column">
          {hours.map(_ => <div class="hour-cell" />)}

          {getSlotsByDay(day.key).map(slot => (
            <div
              class={`slot-block ${slot.modality === "VIRT" ? "slot-virtual" : "slot-presencial"}`}
              style={getSlotStyle(slot)}
              data-slot-id={slot.id}
              data-day={slot.dayOfWeek}
              data-start={slot.startTime}
              data-end={slot.endTime}
              data-modality={slot.modality}
            >
              <span class="slot-time">
                {slot.startTime}{slot.endTime ? ` — ${slot.endTime}` : ""}
              </span>
              <span class="slot-badge">
                {slot.modality === "VIRT" ? "Virtual" : "Presencial"}
              </span>
            </div>
          ))}
        </div>
      ))}

    </div>
  </div>
</div>

<style>
  /* — Contenedor externo con margen de 50px — */
  .calendar-outer {
    width: 100%;
    height: 100%;
  }

  /* — Calendario: no se sale del outer — */
  .calendar-wrapper {
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* — Header — */
  .calendar-header {
    display: grid;
    grid-template-columns: 56px repeat(6, 1fr);
    border-bottom: 1px solid #e5e7eb;
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .time-gutter {
    border-right: 1px solid #e5e7eb;
  }

  .day-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14px 8px 10px;
    border-right: 1px solid #e5e7eb;
    gap: 3px;
    min-width: 0;
  }

  .day-header:last-child { border-right: none; }

  .day-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .day-number {
    font-size: 1.15rem;
    font-weight: 700;
    color: #86efac;
    line-height: 1;
  }

  /* — Body — */
  .calendar-body {
    display: grid;
    grid-template-columns: 56px repeat(6, 1fr);
    overflow-y: scroll;
    max-height: 100vh;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .calendar-body::-webkit-scrollbar {
    display: no;
  }

  /* — Horas — */
  .time-column {
    border-right: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
  }

  .time-cell {
    height: 64px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 5px 8px 0 0;
    font-size: 0.68rem;
    color: #9ca3af;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    border-bottom: 1px solid #e5e7eb;
    white-space: nowrap;
  }

  /* — Días — */
  .day-column {
    position: relative;
    border-right: 1px solid #e5e7eb;
    min-width: 0;
  }

  .day-column:last-child { border-right: none; }

  .hour-cell {
    height: 64px;
    border-bottom: 1px solid #e5e7eb;
    flex-shrink: 0;
  }

  /* — Franjas — */
  .slot-block {
    position: absolute;
    left: 4px;
    right: 4px;
    border-radius: 8px;
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    cursor: pointer;
    transition: filter 0.15s ease, transform 0.15s ease;
    overflow: hidden;
    box-sizing: border-box;
  }

  .slot-block:hover {
    filter: brightness(0.93);
    transform: scaleX(0.97);
  }

  .slot-presencial {
    background: #ddd6fe;
    border-left: 3px solid #a78bfa;
  }

  .slot-presencial .slot-time,
  .slot-presencial .slot-badge {
    color: #5b21b6;
  }

  .slot-virtual {
    background: #bfdbfe;
    border-left: 3px solid #60a5fa;
  }

  .slot-virtual .slot-time,
  .slot-virtual .slot-badge {
    color: #1e40af;
  }

  .slot-time {
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .slot-badge {
    font-size: 0.62rem;
    font-weight: 500;
    opacity: 0.8;
  }
</style>