---
export interface Session {
  id: string;
  title: string;
  description: string;
  subject: string;
  status: string;
  time: string;
  timeLeft: string;
}

interface Props {
  sessions: Session[]; // Recibe un array de sesiones mockeadas
  role: "tutor" | "student";
}

const { sessions, role } = Astro.props;
---

<article
  class="session-container"
  style="view-transition-name: main-session-container;"
>
  <p class="main-title">Tus próximas sesiones</p>

  <div class="cards-stack">
    {
      sessions.map((session) => (
        <div
          class="session-card-wrapper"
          style={"view-transition-name: session-card-${session.id}"}
        >
          <div class="session-card">
            <div class="card-content">
              <div class="card-header">
                <h3>{session.title}</h3>
                <span class="badge-time">{session.timeLeft}</span>
              </div>

              <p class="description">{session.description}</p>

              <div class="card-footer">
                <div class="tags">
                  <span class="tag-subject">{session.subject}</span>
                  <span class="tag-status">{session.status}</span>
                </div>
                <span class="time-label">{session.time}</span>
              </div>
            </div>

            {role === "tutor" && (
              <div class="actions">
                <button class="btn-details">Detalles</button>
                <button class="btn-cancel">Cancelar</button>
              </div>
            )}
          </div>
        </div>
      ))
    }

    <div class="bottom-overlay">
      <a href="#" class="view-more">Ver más ↗</a>
    </div>
  </div>
</article>

<style>
  .session-container {
    background-color: #b797ff;
    border-radius: 16px;
    padding: 1.5rem 1.5rem 0 1.5rem;
    color: white;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0px 4px 4px 0px #0000000d;
  }

  .main-title {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    margin-bottom: 1.2rem;
    font-weight: 600;
  }

  .cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .cards-stack::-webkit-scrollbar {
    display: none;
  }

  .session-card {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .card-content {
    background: #f5f1ff;
    border-radius: 16px;
    border: 2px dashed #cecad6;
    padding: 15px 12px 12px 22px;
    flex: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    color: #3c3c3c;
    font-size: 1rem;
    margin: 0;
    font-weight: 700;
  }

  .badge-time {
    background: #daffaa;
    color: #749944;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 400;
    padding: 8px 6px;
    margin-left: 5px;
    height: max-content;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .description {
    font-size: 12px;
    color: #3c3c3c;
    margin: -2px 0;
    font-weight: 400;
  }

  .card-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    border-radius: 16px;
  }

  .tags {
    display: flex;
    gap: 10px;
  }

  .tag-subject {
    display: flex;
    background: #fae9b7;
    color: #91792e;
    padding: 2px 10px;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 400;
    height: auto;
    align-items: center;
  }

  .tag-status {
    background: #c6c6c6;
    color: #5f5f5f;
    padding: 2px 10px;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 400;
    height: auto;
    align-items: center;
    display: flex;
  }

  .time-label {
    color: #a3a3a3;
    font-size: 12px;
    font-weight: 300;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .btn-details,
  .btn-cancel {
    padding: 6px 12px;
    border-radius: 8px;
    border: none;
    color: white;
    font-size: 14px;
    cursor: pointer;
    font-weight: 400;
    transition: transform 0.1s;
  }

  .btn-details {
    background: #8751ff;
  }

  .btn-cancel {
    background: #f35761;
  }

  .btn-details:hover,
  .btn-cancel:hover {
    transform: scale(1.05);
  }

  .bottom-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 71px;
    background: linear-gradient(
      180deg,
      rgba(217, 217, 217, 0) 0%,
      rgba(163, 163, 163, 0.7) 50%,
      rgba(95, 95, 95, 0.7) 100%
    );
    backdrop-filter: blur(3px);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 1.5rem;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    pointer-events: none;
  }

  .view-more {
    color: white;
    cursor: pointer;
    pointer-events: auto;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    padding: 6px 20px;
    border-radius: 50px;
  }
</style>
