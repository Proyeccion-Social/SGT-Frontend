---
export interface Session {
  id: string;
  title: string;
  description: string;
  subject: string;
  status: string;
  time: string;
  timeLeft: string;
}

interface Props {
  sessions: Session[]; // Recibe un array de sesiones mockeadas
  role: "tutor" | "student";
}

const { sessions, role } = Astro.props;
---

<article
  class='session-container'
  style='view-transition-name: main-session-container;'
>
  <p class='main-title'>Tus próximas sesiones</p>

  <div class='cards-stack'>
    {
      sessions && sessions.length > 0 ? (
        sessions.map((session) => (
          <div
            class='session-card-wrapper'
            style={`view-transition-name: session-card-${session.id}`}
          >
            <div class='session-card'>
              <div class='card-content'>
                <div class='card-header'>
                  <h3>{session.title}</h3>
                  <span class='badge-time'>{session.timeLeft}</span>
                </div>

                <p class='description'>{session.description}</p>

                <div class='card-footer'>
                  <div class='tags'>
                    <span class='tag-subject'>{session.subject}</span>
                    <span class='tag-status'>{session.status}</span>
                  </div>
                  <span class='time-label'>{session.time}</span>
                </div>
              </div>

              {role === 'tutor' && (
                <div class='actions'>
                  <button class='btn-details'>Detalles</button>
                  <button class='btn-cancel'>Cancelar</button>
                </div>
              )}
            </div>
          </div>
        ))
      ) : (
        <div class='empty-state'>
          <p>No tienes ninguna tutoría pendiente</p>
        </div>
      )
    }

    {
      sessions && sessions.length > 0 && (
        <div class='bottom-overlay'>
          <a href='#' class='view-more'>
            Ver más
          </a>
        </div>
      )
    }
  </div>
</article>

<style>
  .session-container {
    background: linear-gradient(
      145deg,
      rgba(183, 151, 255, 0.85),
      rgba(140, 100, 255, 0.7)
    );
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 20px;
    padding: 1.5rem 1.5rem 0 1.5rem;
    color: white;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow:
      0 8px 32px rgba(130, 80, 255, 0.2),
      inset 0 1px 1px rgba(255, 255, 255, 0.15);
  }

  .main-title {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    margin-bottom: 1.2rem;
    font-weight: 600;
  }

  .cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .cards-stack::-webkit-scrollbar {
    display: none;
  }

  .session-card {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .card-content {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 14px;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    padding: 15px 12px 12px 22px;
    flex: 1;
    box-shadow: 0 2px 12px rgba(130, 80, 255, 0.08);
    transition: all 0.25s ease;
  }

  .card-content:hover {
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 4px 18px rgba(130, 80, 255, 0.14);
    transform: translateY(-1px);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    color: #3c3c3c;
    font-size: 1rem;
    margin: 0;
    font-weight: 700;
  }

  .badge-time {
    background: rgba(218, 255, 170, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(218, 255, 170, 0.5);
    color: #5a7a2e;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 10px;
    margin-left: 5px;
    height: max-content;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .description {
    font-size: 12px;
    color: #3c3c3c;
    margin: -2px 0;
    font-weight: 400;
  }

  .card-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    border-radius: 16px;
  }

  .tags {
    display: flex;
    gap: 10px;
  }

  .tag-subject {
    display: flex;
    background: rgba(250, 233, 183, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(250, 233, 183, 0.5);
    color: #8a7228;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    height: auto;
    align-items: center;
  }

  .tag-status {
    background: rgba(210, 210, 210, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(200, 200, 200, 0.35);
    color: #555;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    height: auto;
    align-items: center;
    display: flex;
  }

  .time-label {
    color: #a3a3a3;
    font-size: 12px;
    font-weight: 300;
  }

  .empty-state {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    min-height: 120px;
    padding: 2rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    border: 1px dashed rgba(255, 255, 255, 0.3);
    margin-bottom: 1.5rem;
  }

  .empty-state p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
    margin: 0;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .btn-details,
  .btn-cancel {
    padding: 7px 14px;
    border-radius: 10px;
    border: none;
    color: white;
    font-size: 14px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.25s ease;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .btn-details {
    background: rgba(135, 81, 255, 0.75);
    box-shadow: 0 2px 10px rgba(135, 81, 255, 0.25);
  }

  .btn-cancel {
    background: rgba(243, 87, 97, 0.7);
    box-shadow: 0 2px 10px rgba(243, 87, 97, 0.2);
  }

  .btn-details:hover {
    background: rgba(135, 81, 255, 0.9);
    box-shadow: 0 4px 16px rgba(135, 81, 255, 0.35);
    transform: translateY(-1px);
  }

  .btn-cancel:hover {
    background: rgba(243, 87, 97, 0.85);
    box-shadow: 0 4px 16px rgba(243, 87, 97, 0.3);
    transform: translateY(-1px);
  }

  .bottom-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(
      180deg,
      rgba(160, 120, 255, 0) 0%,
      rgba(183, 151, 255, 0.85) 50%,
      rgba(120, 80, 240, 0.85) 100%
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 40%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 50%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 1.2rem;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    pointer-events: none;
  }

  .view-more {
    color: white;
    cursor: pointer;
    pointer-events: auto;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.25s ease;
  }

  .view-more:hover {
    transform: translateY(-1px);
  }
</style>
