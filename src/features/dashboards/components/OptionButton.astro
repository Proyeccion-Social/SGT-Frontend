---
const { backgroundColor, title, titleColor, description } = Astro.props;
---

<button style={`background-color: ${backgroundColor};  color: ${titleColor}; `}>{title}</button>

<style>
    button {
        border-radius: 8px;
        font-size: 24px; 
        padding: 8px 12px; 
        cursor: pointer; 
        border: none; 
        font-weight: bold;
        transition: transform 0.2s ease, filter 0.2s ease;
    }

    button:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    button:active {
        transform: translateY(0px);
    }

    @media (max-width: 768px) {
        button {
            font-size: 18px;
            padding: 12px 16px;
            width: 100%;
        }
    }
</style>