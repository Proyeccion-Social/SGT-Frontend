---
import { Image } from "astro:assets";

import SidebarIcon from "./icons/SidebarIcon.svg";
import DashboardIcon from "./icons/DashboardIcon.svg";
import ConfigIcon from "./icons/ConfigIcon.svg";
import NotificationIcon from "./icons/NotificationIcon.svg";
import WindowIcon from "./icons/WindowIcon.svg";
import HistoryIcon from "./icons/HistoryIcon.svg";
import CalendarIcon from "./icons/CalendarIcon.svg";
import BinocularIcon from "./icons/BinocularIcon.svg";
import SearchIcon from "./icons/SearchIcon.svg";
import CommunityIcon from "./icons/CommunityIcon.svg";

interface Props {
  userRole: "admin" | "tutor" | "student";
}

const { userRole } = Astro.props;
const currentPath = Astro.url.pathname;
---

<aside class='sidebar' id='main-sidebar'>
  <div class='navbar-items'>
    <div class='nav-group'>
      <div class='sidebarShow'>
        <Image src={SidebarIcon} alt='Menu' class='icon' />
      </div>

      <div
        class={`dashboard-container ${currentPath === "/dashboard" ? "active-link" : ""}`}
      >
        <a href='/dashboard'>
          <Image src={DashboardIcon} alt='Dashboard' class='icon' />
          <span class='nav-label'>Dashboard</span>
        </a>
      </div>
    </div>

    <hr class='nav-divider' />

    <div class='nav-group-main'>
      {
        userRole === "student" && (
          <div class='calendar-container'>
            <a href='/availability/student/slots'>
              <Image src={CalendarIcon} alt='Calendar' class='icon' />
              <span class='nav-label'>Calendario</span>
            </a>
          </div>
        )
      }

      {
        userRole === "admin" && (
          <>
            <a href='#'>
              <Image src={WindowIcon} alt='Window' class='icon' />
              <span class='nav-label'>Gestión</span>
            </a>
            <a href='#'>
              <Image src={ConfigIcon} alt='Config' class='icon' />
              <span class='nav-label'>Configuración</span>
            </a>
          </>
        )
      }

      {
        userRole === "tutor" && (
          <>
            <a
              href='/availability/tutor/slots'
              class={
                currentPath.startsWith("/availability/tutor")
                  ? "active-link"
                  : ""
              }
            >
              <Image src={WindowIcon} alt='Slots' class='icon' />
              <span class='nav-label'>Tu Disponibilidad</span>
            </a>
            <a href='#'>
              <Image src={ConfigIcon} alt='Config' class='icon' />
              <span class='nav-label'>Configuración</span>
            </a>
            <div
              class={`history-container ${currentPath.startsWith("/history") ? "active-link" : ""}`}
            >
              <a href='/history'>
                <Image src={HistoryIcon} alt='History' class='icon' />
                <span class='nav-label'>Historial</span>
              </a>
            </div>
          </>
        )
      }

      {
        userRole === "student" && (
          <>
            <div
              class={`history-container ${currentPath.startsWith("/history") ? "active-link" : ""}`}
            >
              <a href='/history'>
                <Image src={HistoryIcon} alt='History' class='icon' />
                <span class='nav-label'>Historial</span>
              </a>
            </div>
            <a
              href='/search'
              class={currentPath.startsWith("/search") ? "active-link" : ""}
            >
              <Image src={SearchIcon} alt='Search' class='icon' />
              <span class='nav-label'>Buscar</span>
            </a>
            <a href='#'>
              <Image src={BinocularIcon} alt='Binocular' class='icon' />
              <span class='nav-label'>Explorar</span>
            </a>
            <a href='#'>
              <Image src={CommunityIcon} alt='Community' class='icon' />
              <span class='nav-label'>Comunidad</span>
            </a>
          </>
        )
      }
      <div class='notification-container'>
        <a href='#'>
          <Image src={NotificationIcon} alt='Notification' class='icon' />
          <span class='notification-label'>Notificaciones</span>
        </a>
      </div>
    </div>
  </div>

  <div class='navbar-footer'>
    <div class='navbar-header'>
      <img src='/favicon.svg' alt='Logo' />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 80px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 0px 0px 0px;
    transition:
      width 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
      padding-left 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    position: relative;
    z-index: 50;
    background: #f6f1ff;
    overflow: visible;
  }

  .navbar-header {
    margin-bottom: auto;
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-left: 0;
    height: auto;
    transition: padding-left 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .sidebar.expanded .navbar-header {
    padding-left: 10px;
    justify-content: center;
  }

  .navbar-header img {
    width: 100px;
    max-width: none;
    height: auto;
    position: relative;
    transform: rotate(20deg);
    left: -16px;
    bottom: -18px;
  }

  /* Contenedores de Navegación */
  .navbar-items {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;

    margin-bottom: auto;
    transition: align-items 0s;
  }

  .navbar-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .nav-group,
  .nav-group-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .nav-group {
    gap: 28px;
  }

  .nav-divider {
    width: 50%;
    border: none;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    margin: 8px 0;
    align-self: center;
  }

  .sidebar.expanded .navbar-items,
  .sidebar.expanded .navbar-footer,
  .sidebar.expanded .nav-group,
  .sidebar.expanded .nav-group-main {
    align-items: flex-start;
  }

  /* Estilos generales para enlaces y contenedores de iconos */
  .nav-group > a,
  .nav-group-main > a,
  .navbar-footer > a {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    transition:
      width 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
      padding-left 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
      background-color 0.2s ease;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
  }

  .calendar-container,
  .dashboard-container,
  .notification-container,
  .history-container,
  .logout-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    transition:
      width 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
      padding-left 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
      background-color 0.2s ease;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    overflow: hidden;
  }

  .calendar-container a,
  .dashboard-container a,
  .notification-container a,
  .history-container a,
  .logout-container button {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .sidebar.expanded .nav-group > a,
  .sidebar.expanded .nav-group-main > a,
  .sidebar.expanded .navbar-footer > a,
  .sidebar.expanded .calendar-container,
  .sidebar.expanded .dashboard-container,
  .sidebar.expanded .notification-container,
  .sidebar.expanded .history-container,
  .sidebar.expanded {
    width: 90%;
    justify-content: flex-start;
    padding-left: 10px;
    gap: 16px;
  }

  .sidebar.expanded .calendar-container a,
  .sidebar.expanded .dashboard-container a,
  .sidebar.expanded .notification-container a,
  .sidebar.expanded .history-container a,
  .sidebar.expanded {
    justify-content: flex-start;
  }

  /* Ajustes específicos de contenedores con fondo */
  .calendar-container {
    background: #b797ff;
    border: 0.5px solid rgba(0, 0, 0, 0.1);
    box-shadow: inset 0px 3.2px 13px #e7dcff;
  }

  .notification-container {
    background: #e7dcff;
    width: 40px;
    height: 40px;
  }

  /* Iconos */
  .icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  /* Labels (Texto) — position absolute when collapsed so icons stay centered */
  .nav-label,
  .notification-label {
    font-size: 0.95rem;
    font-weight: 500;
    color: #89878f;
    white-space: nowrap;
    overflow: hidden;
    position: absolute;
    left: 44px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .notification-label {
    color: #9acc5b;
  }

  .sidebar.expanded .nav-label,
  .sidebar.expanded .notification-label {
    position: static;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.35s cubic-bezier(0.25, 0.1, 0.25, 1) 0.15s;
  }

  /* Active link highlight */
  .active-link,
  .dashboard-container.active-link,
  .history-container.active-link {
    background: #e7dcff;
    border-radius: 8px;
  }

  a.active-link {
    background: #e7dcff;
    border-radius: 8px;
  }
</style>
