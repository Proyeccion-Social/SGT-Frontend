---
import { Image } from "astro:assets";
import littleMan from "./icons/little-man.png";

interface Props {
  value: string | number;
  description: string;
}

const { value, description } = Astro.props;
---

<div class="stat-card">
  <div class="content">
    <span class="value">{value}</span>
    <p class="description">{description}</p>
  </div>
  
  <div class="decorative-avatar">
    <Image src={littleMan} alt="decoración" />
  </div>
</div>

<style>
  .stat-card {
    background-color: #F3F0FF;
    border: 2px dashed #A855F7;
    border-radius: 24px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    text-align: center;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1/1;
    margin: 0 auto;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .value {
    font-size: clamp(60px, 8vw, 100px);
    font-weight: 700;
    color: #8751FF;
    display: block;
    font-family: 'Cabinet Grotesk variable', sans-serif;
    font-style: bold;
    line-height: 1;
  }

  .description {
    font-family: 'Caveat', sans-serif;
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 700;
    font-style: bold;
    color: #818181;
    margin: 0;
  }

  .decorative-avatar {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: clamp(40px, 5vw, 60px);
    height: auto;
  }

  .decorative-avatar img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
</style>