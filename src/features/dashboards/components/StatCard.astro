---
import { Image } from "astro:assets";
import littleMan from "./icons/little-man.png";

interface Props {
  value: string | number;
  description: string;
  role: 'tutor' | 'student';
}

const { value, description, role } = Astro.props;
---

<div class="stat-card">
  <div class="content">
    <span class="value">{value}</span>
    <p class="description">{description}</p>
  </div>
  
  <div class="decorative-avatar">
    <Image src={littleMan} alt="decoración" />
  </div>
</div>

<style>
  .stat-card {
    background-color: #F3F0FF;
    border: 2px dashed #A855F7;
    border-radius: 24px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    text-align: center;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  .value {
    font-size: 6rem; /* Tamaño grande para el número */
    font-weight: 800;
    color: #A855F7;
    line-height: 1;
    display: block;
  }

  .description {
    font-family: 'Kalam', 'Comic Sans MS', cursive; /* Fuente manuscrita */
    font-size: 1.8rem;
    color: #666;
    margin-top: 10px;
    line-height: 1.2;
  }

  .decorative-avatar {
    position: absolute;
    bottom: 0;
    right: 10px;
    width: 60px;
    height: 60px;
  }

  .decorative-avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>