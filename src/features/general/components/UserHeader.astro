---
import { Image } from "astro:assets";
import RoleChangeIcon from "@/features/dashboards/components/icons/RoleChangeIcon.svg";
import { UserRole } from "@/constants/roles";
import UserMenuDropdown from "./islands/UserMenuDropdown";
interface Props {
    userRole: UserRole;
}

const { userRole } = Astro.props;
---

<div class="user-header">
    {
        (userRole === UserRole.TUTOR || userRole === UserRole.ADMIN) && (
            <button class="role-change-button">
                <Image src={RoleChangeIcon} alt="Change Role" />
            </button>
        )
    }
    <div id="profileIconTUTORIAL">
    <UserMenuDropdown client:load />
    </div>
</div>

<style>
    .user-header {
        position: absolute;
        align-self: flex-end;
        display: flex;
        align-items: center;
        gap: 12px;
        padding-right: 30px;
        top: 48px;
        margin-left: auto;
        z-index: 10;
        right: 20px
    }

    @media (max-width: 768px) {
        .user-header {
            position: fixed;
            top: 1rem;
            right: 1rem;
            padding: 0.5rem;
            padding-right: 0.5rem;
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-radius: 12px;
            z-index: 100;
        }
    }

    .role-change-button {
        background-color: #f5f1ff;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 29px;
        height: 29px;
    }
</style>
