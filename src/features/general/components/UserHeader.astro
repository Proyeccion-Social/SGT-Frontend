---
import { Image } from "astro:assets";
import RoleChangeIcon from "@/features/dashboards/components/icons/RoleChangeIcon.svg";
import { UserRole } from "@/constants/roles";
import UserMenuDropdown from "./islands/UserMenuDropdown";
interface Props {
    userRole: UserRole;
}

const { userRole } = Astro.props;
---

<div class="user-header">
    {
        (userRole === UserRole.TUTOR || userRole === UserRole.ADMIN) && (
            <button class="role-change-button">
                <Image src={RoleChangeIcon} alt="Change Role" />
            </button>
        )
    }
    <UserMenuDropdown client:load />
</div>

<style>
    .user-header {
        position: sticky;
        align-self: flex-end;
        display: flex;
        align-items: center;
        gap: 12px;
        padding-right: 30px;
        top: 2rem;
        margin-left: auto;
    }

    .role-change-button {
        background-color: #f5f1ff;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 29px;
        height: 29px;
    }
</style>
