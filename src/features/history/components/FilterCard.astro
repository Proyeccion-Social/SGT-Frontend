---

<div class="filter-wrapper">
  <div>
    <h2 class="title">Tu <span> historial</span> de sesiones</h2>
  </div>
  <div class="segmented-control">
    <label class="segment-label active" data-filter="all">
      <input type="radio" name="history_filter" checked value="all" />
      <span>Todas</span>
    </label>
    <label class="segment-label" data-filter="scheduled">
      <input type="radio" name="history_filter" value="scheduled" />
      <span>Proximas</span>
    </label>
    <label class="segment-label" data-filter="completed">
      <input type="radio" name="history_filter" value="completed" />
      <span>Completadas</span>
    </label>
    <label class="segment-label" data-filter="cancelled">
      <input type="radio" name="history_filter" value="cancelled" />
      <span>Canceladas</span>
    </label>
    <label class="segment-label" data-filter="noshow">
      <input type="radio" name="history_filter" value="noshow" />
      <span>No asistió</span>
    </label>
  </div>
</div>

<style>
.filter-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 2rem;
  margin-top: 0rem;
}

.segmented-control {
  width: 643px;
  display: inline-flex;
  border: 1px solid rgba(231, 220, 255, 1);
  border-radius: 18px;
  overflow: hidden;
  background-color: rgba(231, 220, 255, 1);
  padding: 0.2rem;
  gap: 0.2rem;  
}

.segment-label {
  cursor: pointer;
  padding: 0.5rem 1.5rem;
  font-weight: 500;
  color: #475569;
  border-radius: 16px;
  position: relative;
  text-align: center;
  transition: background-color 0.2s, color 0.2s;
  /*border-right: 1px solid #cbd5e1;*/
  user-select: none;
}

.segment-label:last-child {
  border-right: none;
}

.segment-label input[type="radio"] {
  display: none;
}

.segment-label.active {
  background-color: rgba(183, 151, 255, 1); /* color azul claro basado en la imagen */
  color: #1e293b;
}

.segment-label:hover:not(.active) {
  background-color: rgba(218, 255, 170, 1);
}

.title {
  font-family: "Open Sauce Two", system-ui, sans-serif;
  font-size: 2.8rem;
  font-weight: bold;
  color: #1e293b;
  span {
    font-size: 3.5rem;
    font-family: 'Caveat', cursive;
    color: #9966FF;
  }
}
</style>

<script>
  const labels = document.querySelectorAll('.segment-label');
  const radios = document.querySelectorAll('input[name="history_filter"]');
  
  radios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const filterValue = target.value;

      // Actualizar estilo activo
      labels.forEach(label => {
        if (label.contains(target)) {
          label.classList.add('active');
        } else {
          label.classList.remove('active');
        }
      });

      // Notificar a Blocks u ocultarlos directamente
      const sections = document.querySelectorAll('.history-section');

sections.forEach(section => {
const sectionId = (section as HTMLElement).dataset.sectionId;
  if (filterValue === 'all' || sectionId === filterValue) {
    section.classList.remove('hidden');
  } else {
    section.classList.add('hidden');
  }
});
    });
  });
</script>


