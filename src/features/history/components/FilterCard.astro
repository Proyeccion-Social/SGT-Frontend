---
const { currentStatus = "all"} = Astro.props;
---

<div class="filter-wrapper">
  <!-- Scroll container aislado, solo para el control -->
  <div class="scroll-container">
    <div class="segmented-control">
      <label class={`segment-label ${currentStatus === 'all' ? 'active' : ''}`} data-filter="all">
        <input type="radio" name="history_filter" checked={currentStatus === 'all'} value="all" />
        <span>Todas</span>
      </label>
      <label class={`segment-label ${currentStatus === 'SCHEDULED' ? 'active' : ''}`} data-filter="scheduled">
        <input type="radio" name="history_filter" checked={currentStatus === 'SCHEDULED'} value="SCHEDULED" />
        <span>Proximas</span>
      </label>
      <label class={`segment-label ${currentStatus === 'COMPLETED' ? 'active' : ''}`} data-filter="completed">
        <input type="radio" name="history_filter" checked={currentStatus === 'COMPLETED'} value="COMPLETED" />
        <span>Completadas</span>
      </label>
      <label class={`segment-label ${currentStatus === 'CANCELLED' ? 'active' : ''}`} data-filter="cancelled">
        <input type="radio" name="history_filter" checked={currentStatus === 'CANCELLED'} value="CANCELLED" />
        <span>Canceladas</span>
      </label>
      <label class={`segment-label ${currentStatus === 'NO_SHOW' ? 'active' : ''}`} data-filter="noshow">
        <input type="radio" name="history_filter" checked={currentStatus === 'NO_SHOW'} value="NO_SHOW" />
        <span>No asistió</span>
      </label>
    </div>
  </div>
</div>

<style>
.filter-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 12px;
  width: 100%;
  box-sizing: border-box;
  /* Sin overflow aquí para no cortar dropdowns hijos */
}

/* Este div es el único que hace scroll, aislado del resto */
.scroll-container {
  width: 100%;
  overflow-x: auto;
  overflow-y: visible;
  scrollbar-width: none;
  -ms-overflow-style: none;
  -webkit-overflow-scrolling: touch;
  padding: 0.25rem 1rem;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}

.scroll-container::-webkit-scrollbar {
  display: none;
}

.segmented-control {
  display: inline-flex;
  border: 1px solid #e8e8e8;
  border-radius: 28px;
  overflow: hidden;
  padding: 0.2rem;
  gap: 0.2rem;
  flex-shrink: 0;
}

.segment-label {
  cursor: pointer;
  padding: 0.5rem 1.5rem;
  font-weight: 500;
  color: var(--text-body);
  border-radius: 24px;
  position: relative;
  text-align: center;
  transition: background-color 0.2s, color 0.2s;
  user-select: none;
  white-space: nowrap;
  flex-shrink: 0;
}

.segment-label:last-child {
  border-right: none;
}

.segment-label input[type="radio"] {
  display: none;
}

.segment-label.active {
  background-color: rgba(183, 151, 255, 1);
  color: #1e293b;
}

.segment-label:hover:not(.active) {
  background-color: rgba(218, 255, 170, 1);
}

.title {
  font-family: "Open Sauce Two", system-ui, sans-serif;
  font-size: 2.8rem;
  font-weight: bold;
  color: #1e293b;
  span {
    font-size: 3.5rem;
    font-family: 'Caveat', cursive;
    color: #9966FF;
  }
}

@media (max-width: 640px) {
  .segment-label {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
}

@media (max-width: 400px) {
  .segment-label {
    padding: 0.4rem 0.75rem;
    font-size: 0.8125rem;
  }
}
</style>

<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener('astro:page-load', () => {
    
    const labels = document.querySelectorAll('.segment-label');
    const radios = document.querySelectorAll('input[name="history_filter"]');
    
    radios.forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const filterValue = target.value;
        
        labels.forEach(label => {
          if (label.contains(target)) {
            label.classList.add('active');
          } else {
            label.classList.remove('active');
          }
        });
        
        navigate(`?limit=10&status=${filterValue}`);
      });
    });

  });
</script>