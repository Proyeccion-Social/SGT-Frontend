---
import SessionsBlock from "./SessionsBlock.astro";
import { getUserIdFromCookie } from "@/features/auth/utils/authUtils";
import { getHistory } from "@/features/history/services/getHistory";

const currentStatus = Astro.url.searchParams.get("status") || "all";
const page = Astro.url.searchParams.get("page") || "1";
const limit = Astro.url.searchParams.get("limit");

let userId = getUserIdFromCookie(Astro.cookies);
if (!userId) {
  return Astro.redirect("/");
}

const token = Astro.cookies.get("access_token")?.value;
if (!token) {
  return Astro.redirect("/?session=expired");
}

const payload = JSON.parse(atob(token.split(".")[1]));
const role: "STUDENT" | "TUTOR" =
  payload.role === "TUTOR" ? "TUTOR" : "STUDENT";

const history = await getHistory({
  token,
  role,
  page: Number(page),
  limit: limit ? Number(limit) : 10,
  status: currentStatus !== "all" ? currentStatus : undefined,
});
---

<div class='history-layout'>
  <div class='search-page'>
    <SessionsBlock
      data={history}
      currentStatus={currentStatus}
      userId={userId}
    />
  </div>
</div>

<style>
  /* Se renderiza dentro del <main> de DashboardLayout, que ya define su
     propia altura: usar 100% evita duplicar el alto en móvil. */
  .history-layout {
    display: flex;
    height: 100%;
    overflow-y: hidden;
    background: #f6f1ff;
  }
  .search-page {
    position: relative;
    display: flex;
    justify-content: start;
    width: 100%;
    overflow-y: hidden;
    overflow-x: hidden;
  }
</style>
