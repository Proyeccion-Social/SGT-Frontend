---
import SessionCard from "./SessionCard.astro";

const { title, sessions } = Astro.props;
---

{sessions && sessions.length > 0 && (
  <div class="container">
    <!-- <h2>{title}</h2> -->

    <div class="grid">
      {sessions.map((session) => (
        <SessionCard session={session} />
        <hr class="separation-line"/>
      ))}
    </div>
  </div>
)}


<style>
  .separation-line{
    border: 0;                /* Elimina el borde por defecto */
  height: 1px;              /* Grosor de la línea */
  width: 70%;               /* Ancho de la línea */
  /* Degradado: Transparente -> Color -> Transparente */
  background-image: linear-gradient(to right, transparent, #9e9e9e, transparent);
  }
  .container {
    margin-bottom: 1rem;
  }
    .grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: center;
        align-items: center;
    }
</style>