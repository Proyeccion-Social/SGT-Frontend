---
import SessionEvaluationCard from "./SessionEvaluationCard.astro";

const { session, questionnaire } = Astro.props;
console.log(session);
---

<dialog
  id={`session-dialog-${session.sessionId || session.id}`}
  class="sessionCard-dialog"
>
  <div class="card relative-card">
    <button class="close-sessioncard-btn" type="button" aria-label="Cerrar"
      >✕</button
    >
    <div class="info-session">
      <div class="bar-session-1">
        <div class="status">
          {/* 🔹 Estado */}
          <p class={`status status-${session.status.toLowerCase()}`}>
            {
              session.status === "COMPLETED"
                ? "Completada"
                : session.status === "CANCELLED"
                  ? "Cancelada"
                  : session.status === "NO_SHOW"
                    ? "No asistió"
                    : session.status === "SCHEDULED"
                      ? "Programada"
                      : session.status  
            }
          </p>
        </div>

        <div class="date-time">
          {/* 🔹 Fecha y hora */}
          <p>
            {session.scheduledDate}
            <br />
            {session.startTime}
          </p>
          {
            session.status === "SCHEDULED" && (
              <>
                <hr />
                <p class="countdown">Empieza en {session.timeUntilSession}</p>
              </>
            )
          }
        </div>

        <div class="duration-session">
          {/* 🔹 Duración */}
          <p><strong>Duración:</strong> {session.duration} h</p>
        </div>

        <div>
          {
            session.status === "COMPLETED" && session.rating?.overall !== undefined && (
              <div class="rating">
                <p>
                  <strong>Tu calificación:</strong> {session.rating.overall} ⭐
                </p>
              </div>
            )
            
          }

          {
            session.status === "COMPLETED" && (!session.rating || session.rating.canRate) && (
              <div class="evaluation-section">
                <button
                  class="btn-open-eval"
                  data-session-id={session.id}
                >
                  <strong>Calificar Sesión</strong>
                </button>
                <div >
                  <SessionEvaluationCard session={session} questionnaire={questionnaire} />
                </div>
              </div>
            )
          }
        </div>
      </div>
      <div class="bar-session-2">
        {/* 🔹 Titulo */}
        {session.title && <h3 class="title">{session.title}</h3>}
        {/* 🔹 Descripción */}
        {
          session.description && (
            <p class="description">
              <strong>Descripcion:</strong> {session.description}
            </p>
          )
        }

        {/* 🔹 Materia */}
        <p>
          <strong>Materia:</strong>
          {session.subject?.name}
          {session.subject?.code && ` (${session.subject.code})`}
        </p>

        {/* 🔹 Modalidad */}
        <p>
          <strong>Modalidad:</strong>
          {session.modality}
        </p>

        {/* 🔹 Ubicación (solo presencial) */}
        {
          session.modality === "PRES" && session.location && (
            <p>
              <strong>Ubicación:</strong> {session.location}
            </p>
          )
        }
        {
          session.modality === "VIRT" && session.virtualLink && (
            <p>
              <strong>Enlace:</strong> {session.virtualLink}
            </p>
          )
        }
      </div>
    </div>
    <div class="tutor-info">
      {/* 🔹 Header */}
      <div class="header">
        <img
          src={session.tutor?.photo ?? "/default-avatar.png"}
          alt="Tutor"
          class="avatar"
          loading="lazy"
          decoding="async"
        />
        <div class="tutor-name">
          <!-- <h3>{session.title ?? "Sesión"}</h3> -->
          <p><strong>Tutor:</strong> {session.tutor?.name}</p>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  let controller;

document.addEventListener("astro:page-load", () => {


    controller?.abort(); // limpia el listener anterior
  controller = new AbortController();


  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const btn = target.closest(".btn-open-eval") as HTMLButtonElement;
    if (!btn) return;

    const sessionId = btn.dataset.sessionId;
    if (!sessionId) return;

    const dialog = document.getElementById(
      `eval-dialog-${sessionId}`
    ) as HTMLDialogElement;

    dialog?.showModal();
  }, { signal: controller.signal });

    const closeBtns = document.querySelectorAll(".close-sessioncard-btn");
    closeBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const dialog = (e.currentTarget as HTMLElement).closest(
          "dialog.sessionCard-dialog",
        ) as HTMLDialogElement;
        if (dialog) {
          dialog.close();
        }
      }, { signal: controller.signal });
    });
  });
</script>

<style>
  .card {
    border-radius: 16px;
    display: flex;
    flex: 1;
    flex-direction: row;
    gap: 0.5rem;
    width: auto;
    justify-content: space-evenly;
    background-color: rgba(255, 255, 255, 0.8);
    padding: 1rem 2rem;
    border-radius: 18px;
    border: 1px solid #e2e8f0;
    color: #334155;
    transition: background-color 0.2s;
  }

  .sessionCard-dialog {
    border: none;
    border-radius: 16px;
    padding: 20px; /* Padding for the close button space */
    background: white;
    margin: auto;
    overflow: visible;
  }
  .sessionCard-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }
  .relative-card {
    position: relative;
  }
  .close-sessioncard-btn {
    position: absolute;
    z-index: 10;
    top: -15px;
    right: -15px;
    background: white;
    color: #ff4d4f;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .close-sessioncard-btn:hover {
    background: #f1f5f9;
    transform: scale(1.1);
  }

  .info-session {
    display: flex;
    flex-direction: row;
    width: auto;
    gap: 0.5rem;
    justify-content: start;
  }
  .bar-session-1 {
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    width: 160px;
    padding: 0.5rem 1rem;
  }
  .status {
    width: 160px;
  }
  .status > p {
    background-color: #f8fafc7d;
    border-style: solid;
    border-width: 1px;
    padding: 0.5rem 1rem;
    border-radius: 16px;
    cursor: pointer;
    font-weight: bold;
    transition: background-color 0.2s;
    width: 160px;
  }

  .date-time {
    background-color: rgba(218, 255, 170, 0.886);
    border: 1px solid rgba(218, 255, 170, 0.886);
    padding: 0.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border-radius: 16px;
    cursor: pointer;
    font-weight: 500;
    color: #334155;
    transition: background-color 0.2s;
    width: 160px;
    hr {
      border: 1px solid rgb(114, 114, 114);
    }
  }
  .duration-session {
    border: 1px solid #cbd5e1;
    padding: 0.5rem 1rem;
    border-radius: 16px;
    cursor: pointer;
    font-weight: 500;
    color: #334155;
    transition: background-color 0.2s;
    width: 160px;
  }

  .rating {
    border: 1px solid #cbd5e1;
    padding: 0.5rem 1rem;
    border-radius: 16px;
    cursor: pointer;
    font-weight: 500;
    color: #334155;
    transition: background-color 0.2s;
    width: 160px;
  }

  .btn-open-eval {
    background-color: rgba(205, 255, 142, 1);
    border: none;
    padding: 0.7rem 0.5rem;
    border-radius: 16px;
    cursor: pointer;
    font-weight: 500;
    width: 160px;
    color: #334155;
    transition: background-color 0.2s;
  }

  .bar-session-2 {
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: start;
    text-align: left;
    padding: 0.5rem 1rem;
    gap: 0.5rem;
    width: 320px;
  }

  .title {
    font-weight: bold;
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .btn-open-eval:hover {
    background-color: rgba(159, 116, 255, 1);
    color: white;
  }
  .tutor-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.5rem 0;
    border-radius: 16px;
    font-weight: 500;
    color: #334155;
    transition: background-color 0.2s;
  }
  .header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  .avatar {
    width: 160px;
    height: 160px;
    border-radius: 16px;
  }
  .eval-dialog {
    border: none;
    border-radius: 8px;
    padding: 0;
    background: transparent;
    margin: auto; /* Centrar universalmente */
  }
  .eval-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  :global(.status-completed) {
    color: rgba(23, 42, 255, 0.85);
    border-color: rgba(23, 42, 255, 0.85);
  }
  :global(.status-cancelled) {
    color: rgba(255, 202, 45, 1);
    border-color: rgba(255, 202, 45, 1);
  }
  :global(.status-no_show) {
    color: rgba(255, 80, 80, 1);
    border-color: rgba(255, 80, 80, 1);
  }
  :global(.status-scheduled) {
    color: rgba(135, 81, 255, 1);
    border-color: rgba(135, 81, 255, 1);
  }
</style>
