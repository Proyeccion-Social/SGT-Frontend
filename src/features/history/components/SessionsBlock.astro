---
import { SessionsPagination } from "./SessionsPagination.tsx";
import HistorySessionManager from "./HistorySessionManager.tsx";
import { HistoryFilters } from "./HistoryFilters.tsx";
import CalendarAdd from "../assets/calendar-add.svg";
import { Image } from "astro:assets";

const { data, currentStatus, userId } = Astro.props;

const sessions = data.data;
const statistics = data.statistics;
const pagination = data.meta;
---

<div class='block-container'>
  <div class='headerTitle'>
    <h2 class='title'>Tu<span>historial</span> de sesiones</h2>
  </div>

  <div class='sections-container'>
    <section class='history-search-bar'>
      <div class='search-bar-row'>
        <input
          type='text'
          id='history-search'
          class='search-input'
          placeholder='Buscar por título de la sesión'
        />
        <HistoryFilters client:only='react' currentStatus={currentStatus} />
      </div>
      <div class='pagination-container'>
        <SessionsPagination
          currentPage={pagination.page}
          totalPages={pagination.totalPages}
          currentUrl={Astro.url.href}
          client:load
        />
      </div>
    </section>
    {
      sessions.length === 0 && (
        <div class='sessions-empty-state'>
          <Image src={CalendarAdd} alt='No sessions' class='empty-icon' />
          <p class='empty-title'>¡Aún no tienes sesiones registradas!</p>
          <p class='empty-subtitle'>
            Empieza tu camino: busca un tutor y agenda tu primera sesión.
          </p>
          <a href='/search' class='empty-cta'>
            Buscar tutores
          </a>
        </div>
      )
    }

    <div class={`table-container${sessions.length === 0 ? " hidden" : ""}`}>
      <!-- Desktop table -->
      <table class='table-header desktop-only'>
        <thead>
          <tr>
            <th class='tableHeader'>Fecha</th>
            <th class='tableHeader'>Título</th>
            <th class='tableHeader'>Materia</th>
            <th class='tableHeader'>Estado</th>
          </tr>
        </thead>
      </table>
      <div class='table-wrapper'>
        <!-- Desktop table body -->
        <table class='desktop-only'>
          <tbody>
            {
              sessions.map((session) => (
                <tr
                  class='history-section'
                  data-section-id={session.status}
                  data-session-id={session.id}
                >
                  <td class='tableDate'>{session.scheduledDate}</td>
                  <td>
                    <span class='title-column'>
                      <span
                        class={`modality-tag ${session.modality === "PRES" || session.modality === "PRESENCIAL" ? "modality-pres" : "modality-virt"}`}
                      >
                        {session.modality === "PRES" ||
                        session.modality === "PRESENCIAL"
                          ? "Presencial"
                          : "Virtual"}
                      </span>
                      {session.title}
                    </span>
                  </td>
                  <td>
                    <span class='subject-name' data-subject-name={session.subject.name}>{session.subject.name}</span>
                  </td>
                  <td>
                    {(() => {
                      if (session.status === "CANCELLED") return "Cancelada";
                      if (session.status === "CANCELLED_BY_STUDENT")
                        return "Cancelada por el estudiante";
                      if (session.status === "CANCELLED_BY_TUTOR")
                        return "Cancelada por el tutor";
                      if (
                        session.participants.find(
                          (participant) => participant.id === userId,
                        )?.status === "ABSENT"
                      )
                        return "Completada - No asistió";
                      if (session.status === "COMPLETED") return "Completada";
                      if (session.status === "SCHEDULED") return "Programada";
                      if (session.status === "PENDING_TUTOR_CONFIRMATION")
                        return "Pendiente de confirmación por el tutor";
                      if (session.status === "PENDING_STUDENT_CONFIRMATION")
                        return "Pendiente de confirmación por el estudiante";
                      return session.status;
                    })()}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <!-- Mobile cards -->
        <div class='mobile-cards mobile-only'>
          {
            sessions.map((session) => {
              const statusLabel = (() => {
                if (session.status === "CANCELLED") return "Cancelada";
                if (session.status === "CANCELLED_BY_STUDENT") return "Cancelada por el estudiante";
                if (session.status === "CANCELLED_BY_TUTOR") return "Cancelada por el tutor";
                if (session.participants.find((p) => p.id === userId)?.status === "ABSENT") return "Completada - No asistió";
                if (session.status === "COMPLETED") return "Completada";
                if (session.status === "SCHEDULED") return "Programada";
                if (session.status === "PENDING_TUTOR_CONFIRMATION") return "Pendiente del tutor";
                if (session.status === "PENDING_STUDENT_CONFIRMATION") return "Pendiente del estudiante";
                return session.status;
              })();

              const isPresencial = session.modality === "PRES" || session.modality === "PRESENCIAL";

              return (
                <div
                  class='mobile-session-card history-section'
                  data-section-id={session.status}
                  data-session-id={session.id}
                >
                  <div class='mobile-card-top'>
                    <span class='mobile-card-date'>{session.scheduledDate}</span>
                    <span class={`modality-tag ${isPresencial ? "modality-pres" : "modality-virt"}`}>
                      {isPresencial ? "Presencial" : "Virtual"}
                    </span>
                  </div>
                  <p class='mobile-card-title title-column'>
                    {session.title}
                  </p>
                  <div class='mobile-card-bottom'>
                    <span class='subject-name'>{session.subject.name}</span>
                    <span class='mobile-card-status'>{statusLabel}</span>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    {
      sessions.length > 0 && sessions.length < 3 && (
        <div class='sessions-low-hint'>
          <svg
            width='16'
            height='16'
            viewBox='0 0 24 24'
            fill='none'
            stroke='#b797ff'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
          >
            <circle cx='12' cy='12' r='10' />
            <line x1='12' y1='8' x2='12' y2='12' />
            <line x1='12' y1='16' x2='12.01' y2='16' />
          </svg>
          <span>
            ¿Quieres más sesiones? <a href='/search'>Encuentra un tutor</a> y
            sigue aprendiendo.
          </span>
        </div>
      )
    }

    <HistorySessionManager client:load />
  </div>
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import { useSubjectStore } from "@/store/subjectStore";

  document.addEventListener("astro:page-load", () => {
    // Apply subject colors from store
    const { colorMap } = useSubjectStore.getState();
    document.querySelectorAll<HTMLElement>(".subject-name[data-subject-name]").forEach((el) => {
      const name = el.dataset.subjectName || "";
      const colors = colorMap[name];
      if (colors?.color && colors.color !== "transparent") {
        el.style.backgroundColor = colors.color;
        el.style.borderColor = colors.borderColor;
        el.style.border = `1px solid ${colors.borderColor}`;
      }
    });

    const tableBody = document.querySelector("tbody");

    // --- Row click → open session dialog (desktop table rows) ---
    tableBody?.addEventListener("click", (e) => {
      const row = (e.target as HTMLElement).closest(
        ".history-section",
      ) as HTMLElement;
      if (!row) return;

      const sessionId = row.dataset.sessionId;
      if (sessionId) {
        document.dispatchEvent(
          new CustomEvent("open-session-dialog", {
            detail: { sessionId },
          }),
        );
      }
    });

    // --- Mobile card clicks ---
    const mobileCards = document.querySelector(".mobile-cards");
    mobileCards?.addEventListener("click", (e) => {
      const card = (e.target as HTMLElement).closest(
        ".history-section",
      ) as HTMLElement;
      if (!card) return;

      const sessionId = card.dataset.sessionId;
      if (sessionId) {
        document.dispatchEvent(
          new CustomEvent("open-session-dialog", {
            detail: { sessionId },
          }),
        );
      }
    });

    // --- Prevenir scroll fuera del table-wrapper ---
    const blockContainer = document.querySelector(".block-container");
    const tableWrapper = document.querySelector(".table-wrapper");

    blockContainer?.addEventListener(
      "wheel",
      (e) => {
        if (!tableWrapper?.contains(e.target as Node)) {
          e.preventDefault();
        }
      },
      { passive: false },
    );

    blockContainer?.addEventListener(
      "touchmove",
      (e) => {
        if (!tableWrapper?.contains(e.target as Node)) {
          e.preventDefault();
        }
      },
      { passive: false },
    );

    // --- Client-side filtering: search text + subject ---
    let activeSubjects: string[] = [];

    const searchInput = document.getElementById(
      "history-search",
    ) as HTMLInputElement | null;
    const rows = document.querySelectorAll<HTMLElement>(".history-section");

    function applyClientFilters() {
      const query = (searchInput?.value || "").trim().toLowerCase();

      rows.forEach((row) => {
        const title = (
          row.querySelector(".title-column")?.textContent || ""
        ).toLowerCase();
        const subject = (
          row.querySelector(".subject-name")?.textContent || ""
        ).toLowerCase();

        const matchesTitle = !query || title.includes(query);
        const matchesSubject =
          activeSubjects.length === 0 ||
          activeSubjects.some((s) => subject === s.toLowerCase());

        row.style.display = matchesTitle && matchesSubject ? "" : "none";
      });
    }

    // Debounced search input
    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyClientFilters, 200);
    });

    // Listen for filter changes from the React HistoryFilters component
    document.addEventListener("history-filters-changed", ((e: CustomEvent) => {
      const detail = e.detail || {};

      // Status → navigate (server-side filtering)
      const newStatus = detail.status;
      const currentUrl = new URL(window.location.href);
      const currentStatus = currentUrl.searchParams.get("status") || "all";

      if (newStatus && newStatus !== currentStatus) {
        const url = new URL(window.location.href);
        if (newStatus === "all") {
          url.searchParams.delete("status");
        } else {
          url.searchParams.set("status", newStatus);
        }
        url.searchParams.set("limit", "10");
        url.searchParams.delete("page");
        navigate(url.pathname + url.search);
        return;
      }

      // Subject → client-side filtering
      activeSubjects = detail.subjects || [];
      applyClientFilters();
    }) as EventListener);
  });
</script>

<style>
  /* ─── Responsive breakpoints ─── */
  /* Mobile: < 640px | Tablet: 640px–1024px | Desktop: > 1024px */

  .desktop-only {
    display: table;
  }
  .mobile-only {
    display: none !important;
  }

  @media (max-width: 768px) {
    .desktop-only {
      display: none !important;
    }
    .mobile-only {
      display: flex !important;
    }
  }

  /* ─── Layout base ─── */
  .headerTitle {
    width: 100%;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100px;
    flex-shrink: 0;
  }

  .sections-container {
    position: relative;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .title {
    font-style: normal;
    font-weight: 500;
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    span {
      color: #9f74ff;
      font-family: "Caveat";
      font-size: 60px;
      font-weight: 600;
      padding: 0 8px;
    }
  }

  @media (max-width: 768px) {
    .headerTitle {
      height: auto;
      padding: 16px 16px 8px;
      padding-top: max(42px, env(safe-area-inset-top));
      margin-bottom: 20px;
    }
    .title {
      font-size: 26px;
      line-height: 42px;
    }
    .title span {
      font-size: 34px;
    }
  }

  @media (max-width: 430px) {
    .headerTitle {
      padding: 12px 12px 6px;
      padding-top: max(42px, env(safe-area-inset-top));
      margin-bottom: 20px;
    }
    .title {
      font-size: 17px;
      line-height: 28px;
      display: none;
    }
    .title span {
      font-size: 26px;
    }
  }

  /* ─── Search bar ─── */
  .history-search-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 16px;
    width: 90%;
    justify-content: center;
    flex-shrink: 0;
  }

  .search-bar-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .search-input {
    padding: 20px;
    box-sizing: border-box;
    flex: 1;
    height: 48px;
    border-radius: 16px;
    border: 0.4px solid var(--neutral-200);
    outline: none;
    background: rgba(256, 256, 256, 0.6);
    width: 400px;
  }

  .search-input::placeholder {
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 15px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #a3a3a3;
  }

  @media (max-width: 768px) {
    .history-search-bar {
      flex-direction: row;
      align-items: center;
      width: 95%;
      gap: 0.5rem;
    }

    .search-bar-row {
      flex: 1;
      min-width: 0;
    }

    .search-input {
      width: 100%;
      font-size: 14px;
    }

    .pagination-container {
      display: flex;
      justify-content: center;
      flex-shrink: 0;
    }
  }

  .pagination-container {
    display: flex;
    justify-content: end;
  }

  /* ─── Subject tag ─── */
  .subject-name {
    font-family: "Cabinet Grotesk Variable";
    font-size: 12px;
    border-radius: 16px;
    background-color: rgba(183, 151, 255, 1);
    color: rgb(25, 25, 25);
    padding: 4px 10px;
    font-weight: 400;
  }

  /* ─── Title column ─── */
  .title-column {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    overflow: hidden;
  }

  /* ─── Modality tags ─── */
  .modality-tag {
    background: rgba(210, 210, 210, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(200, 200, 200);
    color: var(--text-body);
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    height: auto;
    align-items: center;
    display: flex;
    font-family: "Cabinet Grotesk Variable";
    white-space: nowrap;
    flex-shrink: 0;
  }

  .modality-pres {
    background-color: #f3edff;
    color: #9f74ff;
    border: 1px dashed #9f74ff;
  }

  .modality-virt {
    background-color: #e6ffc7;
    color: #9acc5b;
    border: 1px dashed #9acc5b;
  }

  /* ─── Desktop table ─── */
  .tableDate {
    font-style: italic;
    font-weight: 500;
    font-size: 14px;
  }

  .table-container {
    width: 100%;
    border-top: 1px solid var(--neutral-200);
    overflow: hidden;
  }

  .table-wrapper {
    height: 60vh;
    overflow-y: scroll;
    overscroll-behavior: contain;
    border-radius: 0px 0px 32px 32px;
  }

  .table-wrapper::-webkit-scrollbar {
    width: 6px;
    height: 40px;
  }

  .table-wrapper::-webkit-scrollbar-thumb {
    background: #e7dcff;
    border-radius: 12px;
  }

  .table-header {
    margin-right: 17px;
  }

  table {
    table-layout: fixed;
    border-spacing: 0;
    letter-spacing: -0.02em;
    width: 100%;
  }

  th:nth-child(1) { width: 12%; }
  th:nth-child(2) { width: 40%; }
  th:nth-child(3) { width: 24%; }
  th:nth-child(4) { width: 24%; }
  td:nth-child(1) { width: 12%; }
  td:nth-child(2) { width: 40%; }
  td:nth-child(3) { width: 24%; }
  td:nth-child(4) { width: 24%; }

  th,
  td {
    background-color: #ffffff;
    padding: 10px 20px;
    height: 52px;
    text-align: left;
    border-bottom: 1px solid var(--neutral-100);
    color: var(--neutral-default);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.02em;
    font-size: 14px;
    font-weight: 500;
  }

  th {
    font-weight: 600;
    font-size: 0.85rem;
    font-weight: bold;
    letter-spacing: -0.02em;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tr:hover td {
    background-color: var(--primary-50);
    cursor: pointer;
  }

  .tableHeader {
    font-size: 14px;
    letter-spacing: -0.02em;
    color: var(--primary-400);
    font-weight: 700;
  }

  /* ─── Mobile cards ─── */
  .mobile-cards {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-session-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--neutral-100);
    background: #fff;
    cursor: pointer;
    transition: background 0.15s ease;
    text-align: left;
  }

  .mobile-session-card:last-child {
    border-bottom: none;
  }

  .mobile-session-card:active {
    background-color: #8851ff18;
  }

  @media (hover: hover) {
    .mobile-session-card:hover {
      background-color: #8851ff18;
    }
  }

  .mobile-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .mobile-card-date {
    font-style: italic;
    font-weight: 500;
    font-size: 12px;
    color: var(--neutral-400, #a3a3a3);
    flex-shrink: 0;
  }

  .mobile-card-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--neutral-default);
    letter-spacing: -0.02em;
    line-height: 1.4;
    white-space: normal;
    overflow: visible;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: flex-start;
  }

  .mobile-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .mobile-card-status {
    font-size: 12px;
    font-weight: 500;
    color: var(--neutral-400, #6b6b6b);
    letter-spacing: -0.01em;
    text-align: right;
  }

  /* ─── Mobile layout overrides ─── */
  @media (max-width: 768px) {
    .block-container {
      justify-content: flex-start; /* sin centrado vertical */
    }

    .sections-container {
      flex: 1;
      min-height: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      margin-top: 60px;
    }

    .table-container {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .table-wrapper {
      flex: 1;           /* ocupa todo el espacio restante */
      height: auto;      /* anula el 60vh del desktop */
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-bottom: 85px; /* 👈 importante también aquí */
    }
  }

  /* ─── Block container ─── */
  .block-container {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
    border-radius: 32px 0px 0px 32px;
    border: 1px solid var(--neutral-200);
    background: #fff;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .block-container {
      border-radius: 20px;
      margin: 0 8px;
      border: 1px solid var(--neutral-200);
    }
  }

  @media (max-width: 480px) {
    .block-container {
      border-radius: 16px;
      margin: 0 4px;
    }
  }

  /* ─── Empty / low-sessions states ─── */
  .sessions-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 65dvh;
    border-top: 1px solid var(--neutral-200);
    gap: 10px;
    margin-bottom: 16px;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .sessions-empty-state img {
    width: 52px;
    height: auto;
  }

  .empty-title {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 500;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #3c3c3c;
    text-align: center;
  }

  .empty-subtitle {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: var(--neutral-400);
    text-align: center;
  }

  .empty-cta {
    justify-content: center;
    align-items: center;
    padding: 8px 16px;
    gap: 10px;
    background: #9f74ff;
    border-radius: 16px;
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-top: 16px;
  }

  .empty-cta:hover {
    background: #9f74ff;
    color: #fff;
    transform: scale(1.02);
  }

  @media (max-width: 480px) {
    .empty-title {
      font-size: 17px;
    }
    .empty-subtitle {
      font-size: 14px;
    }
    .sessions-empty-state {
      height: 55dvh;
    }
  }

  /* ─── Low hint banner ─── */
  .sessions-low-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px 20px;
    border-top: 1px solid var(--neutral-200);
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 13px;
    color: #a3a3a3;
    position: absolute;
    width: 100%;
    bottom: 0px;
  }

  .sessions-low-hint a {
    color: #9f74ff;
    font-weight: 600;
    text-decoration: none;
  }

  .sessions-low-hint a:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .sessions-low-hint {
      font-size: 12px;
      padding: 10px 12px;
      text-align: center;
      flex-wrap: wrap;
    }
  }

  .hidden {
    display: none;
  }
</style>

{/* ====== Estilos globales para los componentes React ====== */}
<style is:global>
  .sdm-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99998;
    background: rgba(207, 185, 255, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
