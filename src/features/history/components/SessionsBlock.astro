---
import { SessionsPagination } from "./SessionsPagination.tsx";
import HistorySessionManager from "./HistorySessionManager.tsx";
import { HistoryFilters } from "./HistoryFilters.tsx";
import CalendarAdd from "../assets/calendar-add.svg";
import { Image } from "astro:assets";

const { data, currentStatus, userId } = Astro.props;

const sessions = data.data;
const statistics = data.statistics;
const pagination = data.meta;
---

<div class='block-container'>
  <div class='headerTitle'>
    <h2 class='title'>Tu<span>historial</span> de sesiones</h2>
  </div>

  <div class='sections-container'>
    <section class='history-search-bar'>
      <div class='search-bar-row'>
        <input
          type='text'
          id='history-search'
          class='search-input'
          placeholder='Buscar por título de la sesión'
        />
        <HistoryFilters client:only='react' currentStatus={currentStatus} />
      </div>
      <div class='pagination-container'>
        <SessionsPagination
          currentPage={pagination.page}
          totalPages={pagination.totalPages}
          currentUrl={Astro.url.href}
          client:load
        />
      </div>
    </section>
    {
      sessions.length === 0 && (
        <div class='sessions-empty-state'>
          <Image src={CalendarAdd} alt='No sessions' class='empty-icon' />
          <p class='empty-title'>¡Aún no tienes sesiones registradas!</p>
          <p class='empty-subtitle'>
            Empieza tu camino: busca un tutor y agenda tu primera sesión.
          </p>
          <a href='/search' class='empty-cta'>
            Buscar tutores
          </a>
        </div>
      )
    }

    <div class={`table-container${sessions.length === 0 ? " hidden" : ""}`}>
      <table class='table-header'>
        <thead>
          <tr>
            <th class='tableHeader'>Fecha</th>
            <th class='tableHeader'>Título</th>
            <th class='tableHeader'>Materia</th>
            <th class='tableHeader'>Estado</th>
          </tr>
        </thead>
      </table>
      <div class='table-wrapper'>
        <table>
          <tbody>
            {
              sessions.map((session) => (
                <tr
                  class='history-section'
                  data-section-id={session.status}
                  data-session-id={session.id}
                >
                  <td class='tableDate'>{session.scheduledDate}</td>
                  <td>
                    <span class='title-column'>
                      <span
                        class={`modality-tag ${session.modality === "PRES" || session.modality === "PRESENCIAL" ? "modality-pres" : "modality-virt"}`}
                      >
                        {session.modality === "PRES" ||
                        session.modality === "PRESENCIAL"
                          ? "Presencial"
                          : "Virtual"}
                      </span>
                      {session.title}
                    </span>
                  </td>
                  <td>
                    <span class='subject-name' data-subject-name={session.subject.name}>{session.subject.name}</span>
                  </td>
                  <td>
                    {(() => {
                      if (session.status === "CANCELLED") return "Cancelada";
                      if (session.status === "CANCELLED_BY_STUDENT")
                        return "Cancelada por el estudiante";
                      if (session.status === "CANCELLED_BY_TUTOR")
                        return "Cancelada por el tutor";
                      if (
                        session.participants.find(
                          (participant) => participant.id === userId,
                        )?.status === "ABSENT"
                      )
                        return "Completada - No asistió";
                      if (session.status === "COMPLETED") return "Completada";
                      if (session.status === "SCHEDULED") return "Programada";
                      if (session.status === "PENDING_TUTOR_CONFIRMATION")
                        return "Pendiente de confirmación por el tutor";
                      if (session.status === "PENDING_STUDENT_CONFIRMATION")
                        return "Pendiente de confirmación por el estudiante";
                      return session.status;
                    })()}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    {
      sessions.length > 0 && sessions.length < 3 && (
        <div class='sessions-low-hint'>
          <svg
            width='16'
            height='16'
            viewBox='0 0 24 24'
            fill='none'
            stroke='#b797ff'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
          >
            <circle cx='12' cy='12' r='10' />
            <line x1='12' y1='8' x2='12' y2='12' />
            <line x1='12' y1='16' x2='12.01' y2='16' />
          </svg>
          <span>
            ¿Quieres más sesiones? <a href='/search'>Encuentra un tutor</a> y
            sigue aprendiendo.
          </span>
        </div>
      )
    }

    <HistorySessionManager client:load />
  </div>
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import { useSubjectStore } from "@/store/subjectStore";

  document.addEventListener("astro:page-load", () => {
    // Apply subject colors from store
    const { colorMap } = useSubjectStore.getState();
    document.querySelectorAll<HTMLElement>(".subject-name[data-subject-name]").forEach((el) => {
      const name = el.dataset.subjectName || "";
      const colors = colorMap[name];
      if (colors?.color && colors.color !== "transparent") {
        el.style.backgroundColor = colors.color;
        el.style.borderColor = colors.borderColor;
        el.style.border = `1px solid ${colors.borderColor}`;
      }
    });

    const tableBody = document.querySelector("tbody");

    // --- Row click → open session dialog ---
    tableBody?.addEventListener("click", (e) => {
      const row = (e.target as HTMLElement).closest(
        ".history-section",
      ) as HTMLElement;
      if (!row) return;

      const sessionId = row.dataset.sessionId;
      if (sessionId) {
        document.dispatchEvent(
          new CustomEvent("open-session-dialog", {
            detail: { sessionId },
          }),
        );
      }
    });

    // --- Client-side filtering: search text + subject ---
    let activeSubjects: string[] = [];

    const searchInput = document.getElementById(
      "history-search",
    ) as HTMLInputElement | null;
    const rows = document.querySelectorAll<HTMLElement>(".history-section");

    function applyClientFilters() {
      const query = (searchInput?.value || "").trim().toLowerCase();

      rows.forEach((row) => {
        const title = (
          row.querySelector(".title-column")?.textContent || ""
        ).toLowerCase();
        const subject = (
          row.querySelector(".subject-name")?.textContent || ""
        ).toLowerCase();

        const matchesTitle = !query || title.includes(query);
        const matchesSubject =
          activeSubjects.length === 0 ||
          activeSubjects.some((s) => subject === s.toLowerCase());

        row.style.display = matchesTitle && matchesSubject ? "" : "none";
      });
    }

    // Debounced search input
    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyClientFilters, 200);
    });

    // Listen for filter changes from the React HistoryFilters component
    document.addEventListener("history-filters-changed", ((e: CustomEvent) => {
      const detail = e.detail || {};

      // Status → navigate (server-side filtering)
      const newStatus = detail.status;
      const currentUrl = new URL(window.location.href);
      const currentStatus = currentUrl.searchParams.get("status") || "all";

      if (newStatus && newStatus !== currentStatus) {
        const url = new URL(window.location.href);
        if (newStatus === "all") {
          url.searchParams.delete("status");
        } else {
          url.searchParams.set("status", newStatus);
        }
        url.searchParams.set("limit", "10");
        url.searchParams.delete("page");
        navigate(url.pathname + url.search);
        return;
      }

      // Subject → client-side filtering
      activeSubjects = detail.subjects || [];
      applyClientFilters();
    }) as EventListener);
  });
</script>

<style>
  .headerTitle {
    width: 100%;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 200px;
  }

  .sections-container {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: end;
  }

  .title {
    font-style: normal;
    font-weight: 500;
    position: relative;
    top: 20%;
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    span {
      color: #9f74ff;
      font-family: "Caveat";
      font-size: 52px;
      font-weight: 600;
      padding: 0 8px;
    }
  }
  .pagination-container {
    display: flex;
    justify-content: end;
  }

  .subject-name {
    font-family: "Cabinet Grotesk Variable";
    font-size: 12px;
    border-radius: 16px;
    background-color: rgba(183, 151, 255, 1);
    color: rgb(25, 25, 25);
    padding: 4px 10px;
    font-weight: 400;
  }

  .title-column {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    overflow: hidden;
  }

  .modality-tag {
    background: rgba(210, 210, 210, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(200, 200, 200);
    color: var(--text-body);
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    height: auto;
    align-items: center;
    display: flex;
    font-family: "Cabinet Grotesk Variable";
  }

  .modality-pres {
    background-color: #f3edff;
    color: #9f74ff;
    border: 1px dashed #9f74ff;
  }

  .tableDate {
    font-style: italic;
    font-weight: 500;
    font-size: 14px;
  }

  .modality-virt {
    background-color: #e6ffc7;
    color: #9acc5b;
    border: 1px dashed #9acc5b;
  }

  .table-container {
    width: 100%;
    border-top: 1px solid var(--neutral-200);
    overflow: hidden;
  }

  .table-wrapper {
    height: 60vh;
    overflow-y: scroll;
    border-radius: 0px 0px 32px 32px;
  }

  .table-wrapper::-webkit-scrollbar {
    width: 6px;
    height: 40px;
  }

  .table-wrapper::-webkit-scrollbar-thumb {
    background: #e7dcff;
    border-radius: 12px;
  }

  .table-header {
    margin-right: 17px;
  }

  table {
    table-layout: fixed;
    border-spacing: 0;
    letter-spacing: -0.02em;
    width: 100%;
  }

  th:nth-child(1) {
    width: 12%;
  }
  th:nth-child(2) {
    width: 40%;
  }
  th:nth-child(3) {
    width: 24%;
  }
  th:nth-child(4) {
    width: 24%;
  }

  td:nth-child(1) {
    width: 12%;
  }
  td:nth-child(2) {
    width: 40%;
  }
  td:nth-child(3) {
    width: 24%;
  }
  td:nth-child(4) {
    width: 24%;
  }

  th,
  td {
    background-color: #ffffff;
    padding: 10px 20px;
    height: 52px;
    text-align: left;
    border-bottom: 1px solid var(--neutral-100);
    color: var(--neutral-default);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.02em;
    font-size: 14px;
    font-weight: 500;
  }

  th {
    font-weight: 600;
    font-size: 0.85rem;
    font-weight: bold;
    letter-spacing: -0.02em;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tr:hover td {
    background-color: var(--primary-50);
    cursor: pointer;
  }

  .tableHeader {
    font-size: 14px;
    letter-spacing: -0.02em;
    color: var(--primary-400);
    font-weight: 700;
  }

  .block-container {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
    border-radius: 32px 0px 0px 32px;
    border: 1px solid var(--neutral-200);
    background: #fff;
  }

  /* ---  bar styles --- */
  .history-search-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 16px;
    width: 90%;
    justify-content: center;
  }

  .search-bar-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .search-input {
    padding: 20px;
    box-sizing: border-box;
    flex: 1;
    height: 48px;
    border-radius: 16px;
    border: 0.4px solid var(--neutral-200);
    outline: none;
    background: rgba(256, 256, 256, 0.6);
    width: 400px;
  }

  .search-input::placeholder {
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 15px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #a3a3a3;
  }

  .hidden {
    display: none;
  }

  /* ─── Empty / low-sessions states ─── */
  .sessions-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 65dvh;
    border-top: 1px solid var(--neutral-200);
    gap: 10px;
    margin-bottom: 16px;
  }

  .sessions-empty-state img {
    width: 52px;
    height: auto;
  }

  .empty-title {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 500;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #3c3c3c;
  }

  .empty-subtitle {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    /* or 125% */
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;

    color: var(--neutral-400);
  }

  .empty-cta {
    justify-content: center;
    align-items: center;
    padding: 8px 16px;
    gap: 10px;
    background: #9f74ff;
    border-radius: 16px;
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-top: 16px;
  }

  .empty-cta:hover {
    background: #9f74ff;
    color: #fff;
    transform: scale(1.02);
  }

  .sessions-low-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px 20px;
    border-top: 1px solid var(--neutral-200);
    font-family: "Open Sauce Two", system-ui, sans-serif;
    font-size: 13px;
    color: #a3a3a3;
    position: absolute;
    width: 100%;
  }

  .sessions-low-hint a {
    color: #9f74ff;
    font-weight: 600;
    text-decoration: none;
  }

  .sessions-low-hint a:hover {
    text-decoration: underline;
  }
</style>

{/* ====== Estilos globales para los componentes React ====== */}
<style is:global>
  .sdm-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99998;
    background: rgba(207, 185, 255, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sdm-content {
    z-index: 99999;
    position: relative;
  }

  /* --- SessionCardView --- */
  @keyframes scaleUpFade {
    0% {
      opacity: 0;
      transform: translateY(15px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .sc-card {
    position: relative;
    border-radius: 16px;
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    justify-content: space-evenly;
    background-color: rgba(255, 255, 255, 0.95);
    padding: 1rem 2rem;
    border: 1px solid #e2e8f0;
    color: var(--text-body);
    animation: scaleUpFade 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .sc-close-btn {
    position: absolute;
    z-index: 10;
    top: -15px;
    right: -15px;
    background: white;
    color: #ff4d4f;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .sc-close-btn:hover {
    background: #f1f5f9;
    transform: scale(1.1);
  }

  .sc-info {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    justify-content: start;
  }

  .sc-col-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    width: 160px;
    padding: 0.5rem 1rem;
  }

  .sc-status-wrapper {
    width: 160px;
  }
  .sc-status {
    background-color: #f8fafc7d;
    border-style: solid;
    border-width: 1px;
    padding: 0.5rem 1rem;
    border-radius: 16px;
    font-weight: bold;
    width: 160px;
  }

  .sc-date-time {
    background-color: rgba(218, 255, 170, 0.886);
    border: 1px solid rgba(218, 255, 170, 0.886);
    padding: 0.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border-radius: 16px;
    font-weight: 500;
    color: var(--text-body);
    width: 160px;
  }
  .sc-date-time hr {
    border: 1px solid rgb(114, 114, 114);
  }

  .sc-duration,
  .sc-rating {
    border: 1px solid #cbd5e1;
    padding: 0.5rem 1rem;
    border-radius: 16px;
    font-weight: 500;
    color: var(--text-body);
    width: 160px;
  }

  .sc-btn-eval {
    background-color: rgba(205, 255, 142, 1);
    border: none;
    padding: 0.7rem 0.5rem;
    border-radius: 16px;
    cursor: pointer;
    font-weight: 500;
    width: 160px;
    color: var(--text-body);
    transition: background-color 0.2s;
  }
  .sc-btn-eval:hover {
    background-color: rgba(159, 116, 255, 1);
    color: white;
  }

  .sc-col-center {
    display: flex;
    flex-direction: column;
    justify-content: start;
    text-align: left;
    padding: 0.5rem 1rem;
    gap: 0.5rem;
    width: 320px;
  }

  .sc-title {
    font-weight: bold;
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .sc-col-tutor {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.5rem 0;
    gap: 0.7rem;
  }

  .sc-avatar {
    width: 160px;
    height: 160px;
    border-radius: 16px;
  }

  /* Status colors */
  .status-completed {
    color: rgba(23, 42, 255, 0.85);
    border-color: rgba(23, 42, 255, 0.85);
  }
  .status-cancelled {
    color: rgba(255, 202, 45, 1);
    border-color: rgba(255, 202, 45, 1);
  }
  .status-no_show {
    color: rgba(255, 80, 80, 1);
    border-color: rgba(255, 80, 80, 1);
  }
  .status-scheduled {
    color: rgba(135, 81, 255, 1);
    border-color: rgba(135, 81, 255, 1);
  }
</style>
