---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  iconSrc: ImageMetadata;
  bgSrc?: ImageMetadata | null;
  url: string;
  account: string;
  font: string;
}

const { iconSrc, bgSrc, url, account, font } = Astro.props;

const bgStyle = bgSrc
  ? `background-image: url(${bgSrc.src}); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : `background-color: white;`;
---
<a href={url} target="_blank" rel="noopener noreferrer">
  <article class='cardCommunity' style={bgStyle}>
    <div class='content'>
      <div class='imageContainer'>
        <Image src={iconSrc} alt={account} class='icon' />
      </div>
      <h4
        style={`font-family: ${font}; ${font === "Open Sauce Two" ? "color: #1a1a1a;" : ""}`}
      >
        {account}
      </h4>
    </div>
  </article>
</a>

<style>
  .cardCommunity {
    width: 200px;
    height: auto;
    aspect-ratio: 268 / 250;
    box-shadow: 0px 4px 10px 3px rgba(0, 0, 0, 0.1);
    border-radius: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    box-sizing: border-box;
    transition: all 0.3s ease;
  }

  .cardCommunity:hover {
    transform: translateY(-2px);
    box-shadow: 0px 8px 20px 5px rgba(0, 0, 0, 0.1);
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    padding: 16px;
    box-sizing: border-box;
    text-align: center;
    font-style: normal;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .content h4 {
    font-size: 20px;
    margin: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .imageContainer {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: auto;
    aspect-ratio: 1 / 1;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    backdrop-filter: blur(9.4px);
    -webkit-backdrop-filter: blur(9.4px);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .content img {
    width: 60px;
    height: auto;
    max-width: 100%;
  }

  @media (768px < width < 1024px) {
    .cardCommunity {
      width: clamp(160px, 40vw, 180px);
      height: auto;
    }

    .content {
      gap: clamp(10px, 2vw, 16px);
      padding: clamp(12px, 2.5vw, 16px);
    }

    .content h4 {
      font-size: clamp(16px, 2.6vw, 20px);
    }

    .imageContainer {
      width: clamp(64px, 45%, 120px);
    }

    .content img {
      width: clamp(34px, 40%, 70px);
      height: auto;
    }
  }

  @media (width <= 768px) {
    .cardCommunity {
      width: clamp(140px, 70vw, 280px);
      height: auto;
    }

    .content {
      gap: clamp(12px, 3vw, 20px);
      padding: clamp(16px, 4vw, 24px);
    }

    .content h4 {
      font-size: clamp(16px, 5vw, 24px);
      line-height: 1.15;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .content img {
      width: clamp(64px, 18vw, 100px);
      height: auto;
    }

    .imageContainer {
      width: clamp(100px, 30vw, 160px);
    }
  }
</style>
