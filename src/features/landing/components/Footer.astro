---
import { Image } from "astro:assets";
import GreenHeart from "../assets/icons/Green Heart.svg"
---

<footer>
  <div class="contact">
    <article>
      <p>
        Diseñado por <span><a target="_blank" href="https://www.linkedin.com/in/cristian-bonilladev/">Cristian</a></span>
      </p>
      <Image src={GreenHeart} alt="Green Heart" />
    </article>
    <p class="credit-desktop">
      Desarrollado por 
      <span><a target="_blank" href="https://www.linkedin.com/in/dancmo/">Daniel</a></span>, 
      <span><a target="_blank" href="https://www.linkedin.com/in/luna-alejandra-sandoval-rodr%C3%ADguez-8b4563256/">Luna</a></span>, 
      <span><a target="_blank" href="https://www.linkedin.com/in/johan-bermeo/">Johan</a></span>, 
      <span><a target="_blank" href="https://www.linkedin.com/in/carlosesangronis/">Carlos</a></span>, 
      <span><a target="_blank" href="https://www.linkedin.com/in/judlozanol/">Juan</a></span>, 
      <span><a target="_blank" href="https://www.linkedin.com/in/hailen/">Luis</a></span>, 
      <span><a target="_blank" href="https://www.linkedin.com/in/devin-alzate/">Devin</a></span>
    </p>
    <div class="credit-mobile">
      <p>De estudiantes para estudiantes. Por <a target="_blank" href="https://instagram.com/proysocialud">Proyección Social</a></p>
      <Image src={GreenHeart} alt="Green Heart" />
    </div>
  </div>
</footer>

<style>
  footer {
    width: 97%;
    height: 48px;
    margin: auto;
    background: var(--primary-200);
    border-radius: 16px 16px 0px 0px;
    display: flex;
    align-items: center;
  }

  .contact {
    font-family: 'Open Sauce Two';
    font-style: normal;
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    padding: 0px 24px;
    color: var(--text-body);
    gap: 7px;
    justify-content: space-between;
    width: 100%;
  }

  .contact article {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact p {
    margin-top: 4px;
  }

  .credit-mobile {
    display: none;
    font-family: "Cabinet Grotesk Variable";
    font-size: 14px;
  }

  .contact a {
    color: #1A1A1A;
    letter-spacing: -0.02em;
    font-size: 18px;
    font-weight: 800;
    font-family: "Cabinet Grotesk Variable";
  }

  img {
    width: 20px;
    height: 20px;
    position: relative;
    top: 2px;
    left: -4px;
  }

  @media (768px < width <= 1024px) {
    footer {
      height: auto;
      min-height: 48px;
    }

    .contact {
      font-size: 13px;
    }

    .contact a {
      font-size: 15px;
    }
  }

  @media (width <= 768px) {
    footer {
      height: auto;
      padding: 8px 0;
    }

    .contact {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 6px;
      font-size: 12px;
      padding: 0;
    }

    .contact article {
      display: none;
    }

    .contact a {
      font-size: 14px;
    }

    .credit-desktop {
      display: none;
    }

    .credit-mobile {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4px;
    }

    .credit-mobile p {
      font-size: 12px;
    }

    img {
      top: 0;
      left: 0;
      width: 16px;
      height: 16px;
    }

  }
</style>
