---
import { Image } from "astro:assets";
import CardImage from "./CardImage.astro";
import ButtonCta from "./ButtonCta.astro";
import Marked from "../assets/imgs/Marked.png";
import CardTuto1 from "../assets/imgs/CardTuto1.png";
import CardTuto2 from "../assets/imgs/CardTuto2.png";
---

<header>
  <div class='headerText'>
    <h1>Aprende con quienes ya pasaron por lo mismo</h1>
    <p>
      Conecta con tutores, agenda sesiones presenciales o virtuales, y forma
      parte de la comunidad
    </p>
    <Image
      src={Marked}
      alt='Marked'
    />
  </div>
  <div class='ctaButtons'>
    <ButtonCta />
    <a data-open-registry>O regístrate</a>
  </div>
  <section class='cards'>
    <CardImage
      position='left'
      imgSrc={CardTuto1}
      title='Tutorías Personalizadas'
      rotation={-10}
    />
    <CardImage
      position='right'
      imgSrc={CardTuto2}
      title='Sesiones Grupales'
      rotation={10}
    />
  </section>
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    position: relative;
    height: 100%;
    justify-content: center;
    margin-bottom: 50px;
    font-family: "Open Sauce Two";
    letter-spacing: -0.02em;
    color: #1a1a1a;
  }

  .headerText {
    width: 905px;
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }

  .headerText h1 {
    font-style: normal;
    font-weight: 700;
    font-size: 60px;
    line-height: 72px;
    z-index: 1;
  }

  .headerText p {
    text-wrap: balance;
    width: 500px;
    font-style: normal;
    font-weight: 400;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.02em;

    color: #3c3c3c;
  }

  .headerText :global(img) {
    width: 269px;
    height: auto;
    aspect-ratio: 269 / 73;
    position: absolute; 
    left: 115px; 
    top: 75px;
  }

  .cards {
    position: absolute;
    width: 100%;
    height: 300px;
    /* top: 0;
    left: 0; */
    pointer-events: none;
  }

  .cards:first-child {
    left: -220px;
  }

  .ctaButtons {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ctaButtons a {
    font-family: "Cabinet Grotesk Variable";
    font-style: normal;
    font-weight: 400;
    font-size: 12px;
    line-height: 15px;
    text-decoration-line: underline;
    color: #1a1a1a;
    cursor: pointer;
  }

  @media (width <= 1264px) {
    header {
      margin-top: 60px;
    }
    
    .cards {
      position: relative;
      display: flex;
      justify-content: center;
      height: auto;
      margin-top: 0px;
    }

    .cards :global(img) {
      position: relative !important;
      left: auto !important;
      right: auto !important;
      top: auto !important;
      bottom: auto !important;
      margin-right: -15px;
    }

    .cards :global(img:last-child) {
      margin-right: 0;
    }
  }

  @media (width <= 750px) {
    .headerText {
      width: 90%;
      padding: 0 16px;
    }

    .headerText h1 {
      font-size: 56px;
      line-height: 56px;
    }

    .headerText p {
      width: 100%;
      font-size: 16px;
      line-height: 20px;
    }

    .headerText :global(img) {
      width: 240px;
      left: 150px; 
      top: 60px;
    }
  }

  @media (width <= 730px) {
    .headerText {
      width: 90%;
      padding: 0 12px;
    }

    .headerText h1 {
      font-size: 48px;
      line-height: 48px;
    }

    .headerText p {
      width: 100%;
      font-size: 16px;
      line-height: 20px;
    }

    .headerText :global(img) {
      width: 210px;
      left: 8%; 
      top: 50px;
    }
  }

  @media (width <= 682px) {
    .headerText {
      width: 90%;
      padding: 0 12px;
    }

    .headerText h1 {
      font-size: 40px;
      line-height: 42px;
    }

    .headerText p {
      width: 100%;
      font-size: 16px;
      line-height: 20px;
    }

    .headerText :global(img) {
      width: 180px;
      left: 70px; 
      top: 45px;
    }
  }

  @media (width <= 669px) {
    .headerText :global(img) {
      width: 180px;
      left: 6% 
      top: 50px;
    }
  }

  @media (width <= 465px){
    .headerText{
      width: 100%;
      padding: 0 16px;
    }

    .headerText h1 {
      font-size: 32px;
      line-height: 32px;
    }

    .headerText p {
      font-size: 14px;
      line-height: 18px;
      margin-top: -10px;
    }
  }
</style>
