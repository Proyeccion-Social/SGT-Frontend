---
import { Image } from "astro:assets";
import { INTERACT_CONSTS } from "../utils/InteractConsts";

const entries = Object.entries(INTERACT_CONSTS);
const defaultKey = "Modalidades";
---

<section class='interactContainer'>
  <div class='interactBgWrapper'>
    {
      entries.map(([key, value]) => (
        <Image
          src={value.imgSrcBg}
          alt={value.title}
          class:list={["interact-bg", { active: key === defaultKey }]}
          data-key={key}
        />
      ))
    }
  </div>

  <div class='interactContent'>
    {
      entries.map(([key, value]) => (
        <div
          class:list={["interact-text", { active: key === defaultKey }]}
          data-key={key}
        >
          <h2>{value.title}</h2>
          <p>{value.description}</p>
        </div>
      ))
    }
  </div>

  <nav class='interactMenu'>
    {
      entries.map(([key, value]) => (
        <button
          class:list={["interact-option", { active: key === defaultKey }]}
          data-key={key}
        >
          <Image src={value.iconSrc} alt={key} />
          <span>{key}</span>
        </button>
      ))
    }
  </nav>
</section>

<style>
  .interactBgWrapper {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .interactContainer {
    position: relative;
    width: 1340px;
    height: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin: 200px auto;
  }

  .interact-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }
  .interact-bg.active {
    opacity: 1;
  }

  .interactContent {
    position: relative;
    width: 100%;
    margin-bottom: 150px;
  }

  .interactContent h2 {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 700;
    font-size: 60px;
    line-height: 72px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin-bottom: 24px;
  }

  .interactContent p {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 400;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
  }

  .interact-text {
    position: absolute;
    inset: 0;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-in-out;
  }
  .interact-text.active {
    opacity: 1;
    pointer-events: auto;
  }

  .interact-option {
    transition: all 0.2s ease-in-out;
    display: flex;
    align-items: center;
    padding: 8px;
    gap: 5px;
    width: 162px;
    height: 40px;
    border-radius: 8px;
    justify-content: center;

    font-family: "Cabinet Grotesk Variable";
    font-style: normal;
    font-weight: 700;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    background-color: transparent;
    border: 0px solid transparent;
  }

  .interact-option.active {
    background: rgba(255, 255, 255, 0.3);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(10.9px);
    -webkit-backdrop-filter: blur(10.9px);
    border: 1px solid rgba(255, 255, 255, 0.29);
  }

  .interactMenu {
    position: absolute;
    bottom: 80px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
    height: 40px;
  }

  @media (width <= 1343px) {
    .interactContainer {
      width: 90%;
      aspect-ratio: 12 / 10;
      padding: 0 20px;
      
    }
    .interact-bg {
      object-fit: none;
    }
  }


</style>

<script>
  const options = document.querySelectorAll(".interact-option");
  const backgrounds = document.querySelectorAll(".interact-bg");
  const texts = document.querySelectorAll(".interact-text");

  options.forEach((option) => {
    option.addEventListener("click", () => {
      const key = option.getAttribute("data-key");

      // Update active states
      options.forEach((o) => o.classList.remove("active"));
      backgrounds.forEach((bg) => bg.classList.remove("active"));
      texts.forEach((t) => t.classList.remove("active"));

      option.classList.add("active");
      document
        .querySelector(`.interact-bg[data-key="${key}"]`)
        ?.classList.add("active");
      document
        .querySelector(`.interact-text[data-key="${key}"]`)
        ?.classList.add("active");
    });
  });
</script>
