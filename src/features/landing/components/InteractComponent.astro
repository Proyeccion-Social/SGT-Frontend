---
import { Image } from "astro:assets";
import { INTERACT_CONSTS } from "../utils/InteractConsts";

const entries = Object.entries(INTERACT_CONSTS);
const defaultKey = "Modalidades";
---

<section class='interactContainer'>
  <div class='interactBgWrapper'>
    {
      entries.map(([key, value]) => (
        <Image
          src={value.imgSrcBg}
          alt={value.title}
          class:list={["interact-bg", { active: key === defaultKey }]}
          data-key={key}
        />
      ))
    }
  </div>
 
  <div class='interactContent'>
    {
      entries.map(([key, value]) => (
        <div
          class:list={["interact-text", { active: key === defaultKey }]}
          data-key={key}
        >
          <h2>{value.title}</h2>
          <p>{value.description}</p>
        </div>
      ))
    }
  </div>

  <nav class='interactMenu'>
    {
      entries.map(([key, value]) => (
        <button
          class:list={["interact-option", { active: key === defaultKey }]}
          data-key={key}
        >
          <Image src={value.iconSrc} alt={key} />
          <span>{key}</span>
        </button>
      ))
    }
  </nav>
</section>

<style>
  .interactBgWrapper {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

 .interactContainer {
  position: relative;
  width: 100%;
  max-width: 1340px;   /* límite en desktop */
  min-height: 600px;
  aspect-ratio: 1340 / 800;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin: 200px auto;
  padding: 0 20px;
}

  .interact-bg {
    position: absolute;
    
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }
  .interact-bg.active {
    opacity: 1;
  }

  .interactContent {
    position: relative;
    width: 100%;
    margin-bottom: 150px;
  }

  .interactContent h2 {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 700;
    font-size: clamp(32px, 5vw, 60px);
    line-height: 72px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin-bottom: 24px;
  }

  .interactContent p {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 400;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
  }

  .interact-text {
    position: absolute;
    inset: 0;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-in-out;
  }
  .interact-text.active {
    opacity: 1;
    pointer-events: auto;
  }

  .interact-option {
    transition: all 0.2s ease-in-out;
    display: flex;
    align-items: center;
    padding: 8px;
    gap: 5px;
    width: 162px;
    height: 40px;
    border-radius: 8px;
    justify-content: center;

    font-family: "Cabinet Grotesk Variable";
    font-style: normal;
    font-weight: 700;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    background-color: transparent;
    border: 0px solid transparent;
  }

  .interact-option.active {
    background: rgba(255, 255, 255, 0.3);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(10.9px);
    -webkit-backdrop-filter: blur(10.9px);
    border: 1px solid rgba(255, 255, 255, 0.29);
  }

  .interactMenu {
    position: absolute;
    bottom: 80px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
    height: 40px;
  }

 @media (768px < width < 1024px)  {
    .interactContainer {
      width: 90%;
      padding: 0 20px;
      min-height: 500px;
      margin: 100px auto;
      height: auto;  
    }
    .interact-bg {
      object-fit: contain;
    }

    .interactMenu {
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      height: auto;
      
    }
  }

  @media (width <= 768px) {

    .interactContainer {
      width: 90%;
      aspect-ratio: auto;
      min-height: 500px;
      height: auto;
      margin: 100px auto;
      padding: 50px 20px 32px;
      gap: 60px;
    }

    .interactBgWrapper {
      border-radius: 32px;
      overflow: hidden;
    }

    .interact-bg {
      border-radius: 32px;
      object-fit: cover;
    }

    /* En mobile, el texto no debe ser absolute para que el contenedor crezca */
    .interactContent {
      margin-bottom: 0;
    }

    .interact-text {
      position: static;
      inset: auto;
      opacity: 1;
      pointer-events: auto;
      transition: none;
    }

    .interact-text:not(.active) {
      display: none;
      opacity: 0;
      pointer-events: none;
    }

    /* El menú tampoco debe ser absolute en mobile (si no, no suma altura) */
    .interactMenu {
      position: static;
      bottom: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      height: auto;
    }

    .interact-option {
      width: auto;
      height: auto;
      font-size: 16px;
      padding: 6px 12px;
    }

    .interactContent h2 {
      line-height: 1.1;
      margin-bottom: 20px;
    }
  }

</style>

<script>
  const options = document.querySelectorAll(".interact-option");
  const backgrounds = document.querySelectorAll(".interact-bg");
  const texts = document.querySelectorAll(".interact-text");

  options.forEach((option) => {
    option.addEventListener("click", () => {
      const key = option.getAttribute("data-key");

      // Update active states
      options.forEach((o) => o.classList.remove("active"));
      backgrounds.forEach((bg) => bg.classList.remove("active"));
      texts.forEach((t) => t.classList.remove("active"));

      option.classList.add("active");
      document
        .querySelector(`.interact-bg[data-key="${key}"]`)
        ?.classList.add("active");
      document
        .querySelector(`.interact-text[data-key="${key}"]`)
        ?.classList.add("active");
    });
  });
</script>
