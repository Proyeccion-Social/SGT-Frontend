---
import FullLogo from "./FullLogo.astro"
---

<nav class="navBar">
    <FullLogo />

    <button class="hamburger" id="menuToggle">
        ☰
    </button>
    <div class="navMenu">
        <ul class="navLinks">
            <li><a href="#features">Cómo funciona</a></li>
            <li><a href="#pricing">Comunidad</a></li>
            <li><a href="#contact">Impacto</a></li>
        </ul>
        <button data-open-login class="data-open-login">¡Comienza!</button>
    </div>
</nav>

<script>
    const nav = document.querySelector('.navBar');
    
    window.addEventListener('scroll', () => {
        if (window.scrollY > 30) {
            nav?.classList.add('scrolled');
        } else {
            nav?.classList.remove('scrolled');
        }
    });


    const hamburger = document.querySelector('.hamburger');
    const navLinks = document.querySelector('.navLinks');
    const navMenu = document.querySelector('.navMenu');

    hamburger?.addEventListener('click', () => {
        navMenu?.classList.toggle('active');
    });
</script>

<style>
    .navBar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 660px;
        height: 54px;
        padding: 12px 12px;
        background: rgba(255, 255, 255, 0.4);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(12.4px);
        -webkit-backdrop-filter: blur(12.4px);
        border: 1px solid rgba(255, 255, 255, 0.19);
        border-radius: 24px;

        font-family: "Cabinet Grotesk Variable";
        font-style: normal;
        font-weight: 400;
        font-size: 16px;
        line-height: 32px;
        letter-spacing: -0.02em;
        position: fixed;
        top: 40px;
        transition: top 0.3s ease;
        
        z-index: 10000;
    }

    .navBar.scrolled {
        top: 20px;
    }

    .hamburger{
        display: none;
    }
    .navMenu {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 80px;
        
    }
    
    .navLinks {
        font-size: 16px;
        display: flex;
        gap: 8px;
        color: #1A1A1A;
        margin-right: 20px;
        justify-content: center;
        align-items: center;
        margin-top: 1px;
    }

    .menu-toggle {
        display: none;
        font-size: 50px;
        cursor: pointer;
        color: #1A1A1A;
        background: none;
        border: none;
    }

    li {
        list-style: none;
    }

    li a {
        text-decoration: none;
        color: #1A1A1A;
        
    }

    button {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0px 12px;
        width: 97px;
        height: 32px;
        background: #CDFF8E;
        border-radius: 16px;
        font-weight: 500;
        color: #1A1A1A;
        border: none;  
    }
    
    /* ==== Laptop ==== */
    @media (width <= 1024px) {
        .navBar {
            top: 30px;
        }
        .navLinks {
            font-size: 16px;
        }
    }

    /* ==== Tablet ==== */
  @media (640px < width < 1024px)  {
        .navMenu {
            gap: 35px;
        }
        .navLinks {
            
            font-size: 16px;

        }

        .navBar {
            width: 560px;
            left: 50%;
            transform: translateX(-50%);
        }

        .navBar button {
            width: 80px;
            font-size: small;
        }
    }


    /* ==== Móvil ==== */
    @media (width <= 640px) {
        .navBar {
            width: 90%;
            top: 25px;
        }

        .hamburger {
            display: block;
        }

        .navMenu {
            font-size: 14px;
            gap: 12px;
            display: flex;
            justify-content: space-around;
            position: absolute;
            top: 110%;
            right: 0;
            width: 100%;
            height: auto;
            background: rgba(255, 255, 255, 0.4);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(12.4px);
            -webkit-backdrop-filter: blur(12.4px);
            border: 1px solid rgba(255, 255, 255, 0.19);
            border-radius: 24px;
            padding: 12px;
            opacity: 0;
            transition: all 0.3s ease-out;
            pointer-events: none;

            flex-wrap: wrap;
            
        }

        .navLinks {
                font-size: clamp(0.8rem, 3.5vw, 1rem);
                font-style: bold;
                display: flex;
                flex-direction: row;
                margin: 0;
            flex-wrap: wrap;
            gap: 8px 12px;
        }

        .data-open-login {
                display: block;
                padding: 0;
                
            }

        .navMenu.active {
            
            
            opacity: 1;
            transition: all 0.3s ease-out;

            pointer-events: auto;

            
            
            
        }

    }

</style>