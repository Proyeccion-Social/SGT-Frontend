---
import FullLogo from "./FullLogo.astro"
---

<nav class="navBar">
    <FullLogo />
    <ul class="navLinks">
        <li><a href="#features">Cómo funciona</a></li>
        <li><a href="#pricing">Comunidad</a></li>
        <li><a href="#contact">Impacto</a></li>
    </ul>
    <button data-open-login>¡Comienza!</button>
</nav>

<script>
    const nav = document.querySelector('.navBar');
    
    window.addEventListener('scroll', () => {
        if (window.scrollY > 30) {
            nav?.classList.add('scrolled');
        } else {
            nav?.classList.remove('scrolled');
        }
    });
</script>

<style>
    .navBar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 660px;
        height: 54px;
        padding: 12px 12px;
        background: rgba(255, 255, 255, 0.4);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(12.4px);
        -webkit-backdrop-filter: blur(12.4px);
        border: 1px solid rgba(255, 255, 255, 0.19);
        border-radius: 24px;

        font-family: "Cabinet Grotesk Variable";
        font-style: normal;
        font-weight: 400;
        font-size: 16px;
        line-height: 32px;
        letter-spacing: -0.02em;
        position: fixed;
        top: 40px;
        transition: top 0.3s ease;
        
        z-index: 10000;
    }

    .navBar.scrolled {
        top: 20px;
    }

    .navLinks {
        display: flex;
        gap: 8px;
        color: #1A1A1A;
        margin-right: 20px;
        justify-content: center;
        align-items: center;
        margin-top: 1px;
    }

    li {
        list-style: none;
    }

    li a {
        text-decoration: none;
        color: #1A1A1A;
        
    }

    button {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0px 12px;
        width: 97px;
        height: 32px;
        background: #CDFF8E;
        border-radius: 16px;
        font-weight: 500;
        color: #1A1A1A;
        border: none;  
    }

    @media (width <= 692px) {
        .navBar {
            width: 560px;
            left: 50%;
            transform: translateX(-50%);
        }

        .button {
            width: 80px;
            font-size: small;
        }
    }

    @media (width <= 460px) {
        .navBar {
            width: 90%;
        }

        .navLinks {
            font-size: 14px;
        }
    }

</style>