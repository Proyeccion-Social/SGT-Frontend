---
import Nav from "./Nav.astro";
import Header from "./Header.astro";
import Video from "./Video.astro";
import { Image } from "astro:assets";
import Arrow from "../assets/imgs/Arrow1.png";
import PrincipalBg from "../assets/imgs/PrincipalBg.png";
---

<section>
  <div
    class='principalPage'
    style={`background-image: url(${PrincipalBg.src});`}
  >
    <Nav />
    <div class='arrow'>
      <Image src={Arrow} alt='Arrow' />
      <p>By: Proyección Social</p>
    </div>
    <Header />
    <Video />
  </div>
</section>

<style>
  .principalPage {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 97%;
    margin-top: 40px;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 24px;
    position: relative;
  }

  .arrow {
    position: absolute;
    top: 12vh;
    left: 20vw;
    font-family: "Caveat";
    display: flex;
    flex-direction: column;
    /* align-items: center; */
    gap: 4px;
  }

  section {
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>
