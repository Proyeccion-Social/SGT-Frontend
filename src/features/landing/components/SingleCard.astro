---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  imgSrc: ImageMetadata;
  title: string;
  header: String;
  headerSubtitle: String;
  bg: ImageMetadata;
}

const { imgSrc, title, header, headerSubtitle, bg } = Astro.props;
---

<article class="cardContainer" style={`background-image: url(${bg.src}); background-size: cover; background-position: center; background-repeat: no-repeat;`}>
    <header class="cardHeader">
        <h4>{header}</h4>
        <p>{headerSubtitle}</p>
    </header>
    <div class="cardImage">
        <Image
          src={imgSrc}
          alt={title}
        />
    </div>
</article>


<style>
    .cardContainer {
        width: 362px;
        height: 380px;
        border: 8px solid #E8E8E8;
        border-radius: 32px;
        display: grid;
        place-items: center;
        position: relative;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr 1fr;
        overflow: hidden;
    }

    .cardHeader {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-wrap: balance;
    }

    .cardHeader h4 {
        font-family: 'Open Sauce Two';
        font-style: normal;
        font-weight: 600;
        font-size: 32px;
        line-height: 56px;
        letter-spacing: -0.02em;
        color: #1A1A1A;
    }

    .cardHeader p {
        font-family: 'Open Sauce Two';
        font-style: normal;
        font-weight: 400;
        font-size: 16px;
        line-height: 20px;
        letter-spacing: -0.02em;
        color: #3C3C3C;
    }

    .cardImage {
        object-fit: cover;
    }

    .cardImage img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media (width <= 768px) {
        .cardContainer {
            width: 100%;
            max-width: 362px;
        }
    }
</style>
