---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  imgSrc: ImageMetadata;
  title: string;
  header: String;
  headerSubtitle: String;
  bg: ImageMetadata;
  imageFit?: 'cover' | 'contain';
}

const { imgSrc, title, header, headerSubtitle, bg, imageFit = 'cover' } = Astro.props;
---

<article class="cardContainer">
    <Image class="cardBg" src={bg} alt="" />
    <header class="cardHeader">
        <h4>{header}</h4>
        <p>{headerSubtitle}</p>
    </header>
    <div class={`cardImage cardImage--${imageFit}`}>
        <Image
          src={imgSrc}
          alt={title}
        />
    </div>
</article>


<style>
    .cardContainer {
        width: 362px;
        height: 380px;
        border: 8px solid #E8E8E8;
        border-radius: 32px;
        display: grid;
        place-items: center;
        position: relative;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr 1fr;
        overflow: hidden;
    }

    .cardBg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: 0;
    }

    .cardHeader {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-wrap: balance;
        position: relative;
        z-index: 1;
    }

    .cardHeader h4 {
        font-family: 'Open Sauce Two';
        font-style: normal;
        font-weight: 600;
        font-size: 32px;
        line-height: 56px;
        letter-spacing: -0.02em;
        color: #1A1A1A;
    }

    .cardHeader p {
        font-family: 'Open Sauce Two';
        font-style: normal;
        font-weight: 400;
        font-size: 16px;
        line-height: 20px;
        letter-spacing: -0.02em;
        color: #3C3C3C;
    }

    .cardImage {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 85%;
        margin: 0 auto 20px;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.10);
        position: relative;
        z-index: 1;
    }

    .cardImage img {
        width: 100%;
        height: 150px;
        object-fit: cover;
        object-position: top left;
        display: block;
    }

    /* Variante contain: para imágenes compactas que no deben recortarse */
    .cardImage--contain {
        box-shadow: none;
        background: transparent;
        padding: 12px 16px;
        width: 90%;
    }

    .cardImage--contain img {
        height: auto;
        max-height: 110px;
        object-fit: contain;
        object-position: center;
        width: 100%;
        filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.13));
    }

    @media (width <= 768px) {
        .cardContainer {
            width: 100%;
            max-width: 362px;
        }

        .cardImage {
            width: 88%;
            margin-bottom: 16px;
        }

        .cardImage img {
            height: 130px;
        }

        .cardImage--contain img {
            max-height: 90px;
        }
    }
</style>
