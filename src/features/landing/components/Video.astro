---
import { Image } from 'astro:assets';
import VideoImg from "../assets/imgs/Video.png"
import VideoImg2 from "../assets/imgs/Video2.png"
---

<section class="videoSection">
    <Image class="videoImage videoImage--desktop" src={VideoImg} alt="Video" />
    <Image class="videoImage videoImage--mobile" src={VideoImg2} alt="Video" />
</section>

<style>
    .videoSection {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        
        position: absolute;
        bottom: -140px;
    }

    .videoImage {
        width: 100%;
        height: auto;
    }

    .videoImage--mobile {
        display: none;
    }
    @media ( 768px < width < 1024px) {
        .videoSection {
            bottom: 0px;
        }
    }
    @media (width <= 768px) {
        .videoSection {
            bottom: -50px;
        }

        .videoImage--desktop {
            display: none;
        }

        .videoImage--mobile {
            display: block;
            
        }
    }
</style>