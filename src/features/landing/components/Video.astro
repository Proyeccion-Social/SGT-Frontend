---
import { getImage } from 'astro:assets';
import VideoDesktop from "../assets/imgs/Video.png"
import VideoMobile from "../assets/imgs/Video2.png"

const desktopImage = await getImage({ src: VideoDesktop });
const mobileImage = await getImage({ src: VideoMobile });
---

<section class="video-section">
    <picture class="video-picture">
        <source media="(width <= 768px)" srcset={mobileImage.src} />
        <img class="video-image" src={desktopImage.src} alt="Video" />
    </picture>
</section>

<style>
    .video-section {
        display: flex;
        justify-content: center;
        align-items: flex-start;

        position: absolute;
        bottom: -150px;
    }

    /* El picture no participa del layout: el img se comporta como
       hijo directo del section y los width en % se resuelven contra el. */
    .video-picture {
        display: contents;
    }

    .video-image {
        width: 72%;
        height: auto;
    }

    @media ( 768px < width < 1024px) {
        .video-section {
            bottom: 0px;
        }

        .video-image {
            width: 100%;
        }
    }

    @media (width <= 768px) {
        .video-section {
            bottom: -50px;
        }

        .video-image {
            width: 100%;
        }
    }
</style>
