---
export const prerender = false;

import SearchBar from "@/features/search/components/SearchBar.astro";
import TutorList from "@/features/search/components/TutorList.astro";
import TutorDetail from "@/features/search/components/TutorDetail.astro";
---

<div class='search-page'>
  <article class='searchContent'>
    <SearchBar />
  </article>
  <article class='tutorListContent'>
    <TutorList />
    <TutorDetail />
  </article>
</div>

<style>
  .tutorListContent {
    width: 723px;
  }

  .search-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 32px 0px 0px 32px;
    border: 1px solid var(--neutral-200);
    overflow-y: auto;
    justify-content: center;
    align-items: center;
    gap: 60px;
    width: 100%;
    height: 100%;
  }

  .search-content {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .search-content {
      flex-direction: column;
    }
  }

  @media (max-width: 499px) {
    .search-page {
      height: 100dvh;
      overflow: hidden;
      justify-content: center;
      align-items: center;
      gap: 0;
      padding: 0;
      border-radius: 0;
      flex-direction: column;
    }

    .searchContent {
      flex-shrink: 0;
      width: 100%;
      padding: 24px 12px 20px;
    }

    .tutorListContent {
      width: 100%;
      height: 300px;
      overflow-y: auto;
      padding: 0 12px 0;
      scrollbar-width: none;
      flex: none;
    }

    .tutorListContent::-webkit-scrollbar {
      display: none;
    }
  }
</style>
