---
import searchIcon from "@/features/search/assets/search.png";
import filter from "@/features/search/assets/filter.png";
import arrow from "@/features/search/assets/arrow.png";
---

<section class="title-section" id="title-section">
  <h1 class="page-title">¡Los<span class="highlight">mejores</span> de la facultad!</h1>
  <img src={arrow.src} class="arrow"/>
  <p class="arrow-text">Tutores</p>
  <div class="bg-difumination"> </div>
</section>

<section class="search-bar">
  <div class="search-bar-row">
    <div class="search-input-container">  
      <input
        type="text"
        id="name-filter"
        class="search-input"
        placeholder="Buscar por nombre del tutor"
      />
      <button id="search-btn" class="search-button" type="button">
        <img src={searchIcon.src} alt="Buscar" />
      </button>
      <button id="filter-btn" class="filter-button" type="button">
        <img src={filter.src} alt="Filtrar" />
      </button>
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById("search-btn")?.addEventListener("click", () => {
    applyFilters();
    document.getElementById("title-section")?.classList.add("hide");
  });

  async function applyFilters() {
    const checked = Array.from(
      document.querySelectorAll('input[name="modalities"]:checked'),
    ).map((el) => el.value);

    const nameQuery = document
      .getElementById("name-filter")
      .value.trim()
      .toLowerCase();

    const subjectId = document.getElementById("subject-filter").value;

    let tutors = [];

    /* ---------------- FETCH TUTORES ---------------- */

    if (subjectId) {
      const res = await fetch(
        `/api/search/tutors/subject?subjectId=${encodeURIComponent(subjectId)}`,
      );

      const data = await res.json();
      tutors = data.data ?? [];
    } else {
      const res = await fetch("/api/search");

      const data = await res.json();
      tutors = data.data ?? data ?? [];
    }

    /* ---------------- FILTRO MODALIDAD ---------------- */

    if (checked.length > 0) {
      tutors = tutors.filter((t) => {
        const modalities = t.modality || t.modalities || [];
        return checked.some((m) => modalities.includes(m));
      });
    }

    /* ---------------- FILTRO NOMBRE ---------------- */

    if (nameQuery) {
      tutors = tutors.filter((t) => {
        const name = (t.tutorName || t.name || t.fullName || "").toLowerCase();
        return name.includes(nameQuery);
      });
    }

    /* ---------------- TRAER PERFIL COMPLETO ---------------- */

    const profilePromises = tutors.map((t) => {
      const id = t.tutorId || t.id;

      return fetch(`/api/search/${encodeURIComponent(id)}`)
        .then((res) => (res.ok ? res.json() : t))
        .catch(() => t);
    });

    const enrichedTutors = await Promise.all(profilePromises);

    console.log("Enriched tutors:", enrichedTutors);

    document.dispatchEvent(
      new CustomEvent("tutors-updated", { detail: enrichedTutors }),
    );
  }
</script>

<style>
  .title-section {
    margin-top: 220px;
    margin-bottom: 70px;
    display: flex;
    justify-content: center;
    opacity: 1;
    transition:
      margin-top 0.4s ease,
      margin-bottom 0.4s ease,
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .title-section.hide {
    margin-top: 0;
    margin-bottom: 0;
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
  }

  .page-title {
    text-align: center;
    font-family: "Open Sauce Two";
    font-size: 52px;
    letter-spacing: -0.02em;
    color: #1a1a1a;
  }

  .search-bar {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 0.75rem;
  }

  .search-bar-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .search-input {
    padding-left: 20px;
    box-sizing: border-box;
    width: 723px;
    height: 72px;
    background: rgba(245, 241, 255, 0.77);
    box-shadow: 0px 4px 9px 2px rgba(135, 81, 255, 0.2);
    border-radius: 40px;
  }

  .search-input-container {
    position: relative;
    display: flex;
    align-items: center;
  }



  .search-button {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    left: 660px;
    padding: 12px;
    background: #9f74ff;
    border-radius: 50%;
    border: none;
  }

  .filter-button {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 5px;
    gap: 10px;

    position: absolute;
    width: 28px;
    left: 620px;

    background: #e8e8e8;
    border-radius: 8px;
    border-color: transparent;
  }

  .arrow {
    /* Tutores */

position: absolute;
width: 75px;

left: 670px;
top: 205px;

color: #E8E8E8;


  }

  .arrow-text {
    /* Tutores */

position: absolute;
width: 80px;

left: 745px;
top: 180px;

font-family: 'Caveat';

font-size: 32px;


color: #E8E8E8;

  }

  .highlight {
    color: #9f74ff;
    font-family: 'Caveat';  
    font-size: 70px;
    padding: 0 10px;
  }

  .bg-difumination {
/* Rectangle 10 */

position: absolute;
z-index: -1;
left: 15%;
right: 10%;
top: 25%;
bottom: 10.63%;

background: radial-gradient(50% 50% at 50% 50%, #CFB9FF 0%, rgba(243, 237, 255, 0) 63%);



  }

  .search-button:hover {
    background: var(--color-moradops-600);
  }
</style>
