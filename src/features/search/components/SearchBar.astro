
---
interface Subject {
  id: string;
  name: string;
}


const url = new URL("/api/search", Astro.url);
const subjectsUrl = new URL("/api/search/subjects", Astro.url);
const subjectsRes = await fetch(subjectsUrl);
const subjectsData = await subjectsRes.json();
const subjects = subjectsData.data ?? [];

import searchIcon from "@/features/search/assets/search.png";
---
 <section class="title-section" id="title-section">
  <h1 class="page-title">¡Los mejores de la facultad!</h1>
</section>
<section class="search-bar">
  <div class="search-bar-row">
    <input
      type="text"
      id="name-filter"
      class="search-input"
      placeholder="Buscar por nombre del tutor"
    />
    <button id="search-btn" class="search-button" type="button" ><img src={searchIcon.src} alt="Buscar" /></button>

    <select id="subject-filter" class="search-select">
      <option value="">Todas las materias</option>
      {subjects.map((subject) => (
        <option value={subject.id}>{subject.name}</option>
      ))}
    </select>

  </div>

  <div class="search-modalities">
    <label class="modality-label">
      <input type="checkbox" name="modalities" value="VIRT" checked />
      Online
    </label>
    <label class="modality-label">
      <input type="checkbox" name="modalities" value="PRES" checked />
      Presencial
    </label>
  </div>
</section>


<script is:inline>


  document.getElementById("search-btn")
    ?.addEventListener("click", () => {
    applyFilters();
    document.getElementById("title-section")?.classList.add("hide");
  });
    


    

  async function applyFilters() {
    const checked = Array.from(
      document.querySelectorAll('input[name="modalities"]:checked')
    ).map(el => el.value);

    const nameQuery = document.getElementById("name-filter").value.trim().toLowerCase();
    const subjectId = document.getElementById("subject-filter").value;

    let tutors;

    if (subjectId) {
      const res = await fetch(`/api/search/tutors/subject?subjectId=${encodeURIComponent(subjectId)}`);
      const data = await res.json();
      tutors = data.data ?? [];
    } else {
      let url = "/api/search";
      if (checked.length === 1) url += `?modality=${encodeURIComponent(checked[0])}`;
      const res = await fetch(url);
      tutors = await res.json();
    }

    if (checked.length === 1) {
      tutors = tutors.filter(t => (t.modality || []).includes(checked[0]));
    }

      /*if (checked.length === 0) {
    document.getElementById("tutor-list").innerHTML = "";
    return;
  } */

    if (nameQuery) {
      tutors = tutors.filter(t => {
        const name = (t.tutorName || t.name || t.fullName || "").toLowerCase();
        return name.includes(nameQuery);
      });
    }

    document.dispatchEvent(new CustomEvent("tutors-updated", { detail: tutors }));
  }
</script>

