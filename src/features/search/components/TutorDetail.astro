---
import { Image } from "astro:assets";
import profile from "@/features/search/assets/profile.png";

import star from "@/features/search/assets/star-simple.svg";
import fullStar from "@/features/search/assets/star-full.svg";
import starUnfilled from "@/features/search/assets/star-full-unfilled.svg";
import starSimpleUnfilled from "@/features/search/assets/star-simple-unfilled.svg";
import active from "@/features/search/assets/active.svg"
import arrow from "@/features/search/assets/arrow-detail.svg"
import closeSvg from "@/features/search/assets/close.svg"
import schedule from "@/features/search/assets/schedule.svg"

---

<dialog id="tutor-detail-section"
  data-star={star.src}
  data-star-full={fullStar.src}
  data-star-unfilled={starUnfilled.src}
  data-star-simple-unfilled={starSimpleUnfilled.src}
>
  <button id="close-dialog-btn" class="closeDialogBtn" aria-label="Cerrar">
    <Image src={closeSvg} alt="Cerrar modal" />
  </button>
  <section class="upSectionDetail">
    <div class="leftSideDetail">
      <Image src={profile} alt="" class="profileImgShadow" />
      <Image src={profile} alt="" class="profileImg" />
      <div class="badgeActive">
        <Image src={active} alt="" class="activeIcon" />
        <p>Activo</p>
      </div>
    </div>
    <div class="rightSideDetail">
      <!-- <p class="informativeText">
        Racha de 15 semanas dando al menos una tutoría
      </p> -->
      <a href="/sessions">
        <button class="scheduleBtn">
          <Image src={schedule} alt="Agendar tutoría" />
          Agendar una tutoría
        </button>
      </a>
      <h2 class="tutorName" id="tutor-name"></h2>
      <div class="containerTutorSubjects" id="tutor-subjects"></div>
      <div class="tutorRating">
        <div class="stars" id="tutor-stars">

        </div>
        <div class="totalRatings">
          <Image src={arrow} alt="" class="arrowRatings" />
          <p class="labelTotalRatings" id="tutor-total-ratings"></p>
        </div>
      </div>
    </div>
  </section>
  <section class="downSectionDetail">
    <div class="tutor-slots-container">
      <h3 class="section-title">Horarios disponibles</h3>
      <ul id="tutor-slots" class="slots-list"></ul>
    </div>
  </section>  
</dialog>

<script>
  import { useSubjectStore } from "@/store/subjectStore";

  const el = (id: string) => document.getElementById(id);

  document.addEventListener("astro:page-load", () => {
    const dialog = el("tutor-detail-section") as HTMLDialogElement | null;
    if (!dialog) return;
    const dialogEl: HTMLDialogElement = dialog;

    // Cerrar haciendo click en el fondo (overlay) nativo del dialog
    dialogEl.addEventListener("click", (e) => {
      if (e.target === dialogEl) dialogEl.close();
    });

    el("close-dialog-btn")?.addEventListener("click", () => {
      dialogEl.close();
    });

    async function loadTutor(id: string) {
      try {
        const [profileRes, slotsRes] = await Promise.all([
          fetch(`/api/search/${encodeURIComponent(id)}`),
          fetch(`/api/search/${encodeURIComponent(id)}/availability`)
        ]);

        const tutor = await profileRes.json();
        const { availableSlots = [] } = await slotsRes.json();
        const { colorMap } = useSubjectStore.getState();

        const subjectsHTML = tutor.subjects?.map((s: { name: string }) => {
          const colors = colorMap[s.name];
          const bg = colors?.color && colors.color !== "transparent" ? colors.color : "#E6FFC7";
          const border = colors?.borderColor && colors.borderColor !== "transparent" ? colors.borderColor : "transparent";
          return `<div class="tutorSubjects" style="background:${bg};border-color:${border}"><p>${s.name}</p></div>`;
        }).join("") ?? "";

        const slotsHTML = availableSlots
          .map((slot: { dayOfWeek: string; startTime: string; endTime: string; modality: string }) =>
            `<li>
              <span class="slot-day">${slot.dayOfWeek}</span>
              <span class="slot-time">${slot.startTime} – ${slot.endTime}</span>
              <span class="slot-modality">${slot.modality}</span>
            </li>`
          )
          .join("");

        el("tutor-name")!.textContent = tutor.name;
        el("tutor-subjects")!.innerHTML = subjectsHTML;
        el("tutor-total-ratings")!.textContent = `${tutor.totalRatings} valoraciones`;

        const rating = Math.round(tutor.averageRating ?? 0);
        let starsHTML = '';

        const starSrc = dialogEl.getAttribute("data-star");
        const starFullSrc = dialogEl.getAttribute("data-star-full");
        const starUnfilledSrc = dialogEl.getAttribute("data-star-unfilled");
        const starSimpleUnfilledSrc = dialogEl.getAttribute("data-star-simple-unfilled");

        for (let i = 1; i <= 5; i++) {
          if (i <= rating) {
            if (i === 5) {
              starsHTML += `<img src="${starFullSrc}" alt="star" style="width: 45px; height: 45px; align-self: center;" />`;
            } else {
              starsHTML += `<img src="${starSrc}" alt="star" style="width: 31px; height: 29px; align-self: center;" />`;
            }
          } else {
            if (i === 5) {
              starsHTML += `<img src="${starUnfilledSrc}" alt="star" style="width: 45px; height: 45px; align-self: center;" />`;
            } else {
              starsHTML += `<img src="${starSimpleUnfilledSrc}" alt="star" style="width: 31px; height: 29px; align-self: center;" />`;
            }
          }
        }

        el("tutor-stars")!.innerHTML = starsHTML;
        el("tutor-slots")!.innerHTML = slotsHTML || '<li class="no-slots">Sin horarios disponibles</li>';

        dialogEl.showModal();
      } catch (error) {
        console.error("Error cargando tutor:", error);
      }
    }

    (window as any).loadTutor = loadTutor;
  });
</script>

<style>
  #tutor-detail-section {
    width: 680px;
    border-radius: 22.4px;
    border: none;
    outline: none;
    position: relative;
  }

  /* ── Boton Cerrar ── */
  .closeDialogBtn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 50%;
    transition: background 0.2s, transform 0.2s;
    z-index: 10;
  }
  .closeDialogBtn:hover {
    transform: scale(1.1);
  }

  #tutor-detail-section[open] {
    display: flex;
    flex-direction: column;
    margin: auto;
    animation: modalFadeIn 0.3s cubic-bezier(0.32, 0.72, 0, 1) forwards;
  }

  @keyframes modalFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  #tutor-detail-section::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
  }

  #tutor-detail-section[open]::backdrop {
    animation: backdropFadeIn 0.3s ease forwards;
  }

  @keyframes backdropFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .upSectionDetail {
    width: 100%;
    border: 1px solid #e7dcff;
    border-bottom: none;
    border-radius: 22.4px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 32px 28px 32px;
    background: rgba(256, 256, 256, 0.5);
    backdrop-filter: blur(34.3px);
    position: relative;
  }

  .upSectionDetail::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, #FFFFFF 0%, rgba(0, 0, 0, 0) 54%, #FFFFFF 100%);
    border-radius: 0 0 22.4px 22.4px;
  }

  .leftSideDetail {
    width: 108px;
    height: 108px;
    display: flex;
    position: relative;
    align-self: flex-start;
  }

  .profileImgShadow {
    position: absolute;
    top: 8px;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    filter: blur(16px);
    opacity: 0.7;
    z-index: 0;
  }

  .profileImg {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    z-index: 1;
  }

  .badgeActive {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 2px 6px;
    gap: 3px;
    background: #FFFFFF;
    border-radius: 22.4px;
    position: absolute;
    bottom: 6px;
    left: 6px;
    z-index: 2;
  }

  .activeIcon {
    width: 9px;
    height: 9px;
  }

  .badgeActive p {
    font-family: 'Cabinet Grotesk Variable';
    font-style: normal;
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: -0.02em;
    color: var(--text-headings);
  }

  .rightSideDetail {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 24px;
    border: 1px solid var(--neutral-200);
    border-radius: 20px;
    position: relative;
  }

  .informativeText {
    font-family: 'Open Sauce Two';
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.02em;
    color: #C6C6C6;
    margin-bottom: 2px;
  }

  .tutorName {
    font-family: 'Open Sauce Two';
    font-style: normal;
    font-weight: 700;
    font-size: 32px;
    line-height: 36px;
    letter-spacing: -0.02em;
    color: #1A1A1A;
  }

  .containerTutorSubjects {
    width: 100%;
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .scheduleBtn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--primary-400);
    width: fit-content;
    position: absolute;
    top: 24px;
    right: 24px;
    padding: 8px 8px;
    background: #DAFFAA;
    border-radius: 8px;
    font-style: normal;
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: -0.02em;
    color: #4D662E;
    transition: all 0.2s ease;
  }

  .scheduleBtn img {
    width: 20px;
    height: 20px;
  }

  .scheduleBtn:hover {
    background: #C6E88B;
  }

  @media (max-width: 499px) {
    #tutor-detail-section {
      width: calc(100vw - 24px);
      border-radius: 16px;
    }

    .upSectionDetail {
      padding: 20px;
      gap: 12px;
      border-radius: 16px;
    }

    .leftSideDetail {
      width: 88px;
      height: 88px;
    }

    .tutorName {
      font-size: 24px;
      line-height: 28px;
    }

    .rightSideDetail {
      padding: 16px;
      border-radius: 14px;
    }

    .scheduleBtn {
      font-size: 12px;
      padding: 6px;
      top: 16px;
      right: 16px;
    }

    .containerTutorSubjects {
      gap: 6px;
      margin-bottom: 6px;
    }
  }

  @media (max-width: 399px) {
    #tutor-detail-section {
      width: calc(100vw - 16px);
      border-radius: 12px;
    }

    .upSectionDetail {
      padding: 14px;
      gap: 10px;
      border-radius: 12px;
    }

    .leftSideDetail {
      width: 72px;
      height: 72px;
    }

    .profileImg {
      border-radius: 10px;
    }

    .profileImgShadow {
      border-radius: 10px;
    }

    .badgeActive p {
      font-size: 10px;
    }

    .activeIcon {
      width: 7px;
      height: 7px;
    }

    .tutorName {
      font-size: 20px;
      line-height: 24px;
    }

    .rightSideDetail {
      padding: 12px;
      gap: 8px;
      border-radius: 10px;
    }

    .scheduleBtn {
      font-size: 11px;
      padding: 5px 6px;
      top: 12px;
      right: 12px;
      gap: 4px;
    }

    .scheduleBtn img {
      width: 14px;
      height: 14px;
    }

    .containerTutorSubjects {
      gap: 4px;
      margin-bottom: 4px;
    }
  }
</style>

<style is:global>
  .tutorSubjects {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 2.8px 8.4px;
    background: #E6FFC7;
    border-radius: 22.4px;
  }

  .tutorSubjects p {
    font-family: 'Cabinet Grotesk Variable';
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    color: var(--text-body);
  }

  .tutorRating {
    display: flex;
    width: 100%
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .stars {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    gap: 4px;
    background: var(--primary-100);
    border-radius: 16px;
  }

  .totalRatings {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .totalRatings p {
    position: relative;
    top: -10px;
    left: 4px;
    font-family: 'Caveat';
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.02em;
    color: #9F74FF;
  }

  .downSectionDetail {
    width: 100%;
    flex-direction: column;
    gap: 10px;
    display: none;
  }

  @media (max-width: 439px) {
    .stars img {
      width: 24px !important;
      height: 24px !important;
    }

    .stars {
      padding: 8px 14px;
      gap: 3px;
    }
  }

  @media (max-width: 389px) {
    .stars img {
      width: 18px !important;
      height: 18px !important;
    }

    .stars {
      padding: 6px 10px;
      gap: 2px;
    }
  }


</style>