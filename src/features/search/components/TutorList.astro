---

---

<section id='tutor-list-section' class='tutor-list-section' hidden>
  <div id='accordion-container' class='accordion-container'></div>

  <!-- Empty state -->
  <div id='tutor-empty-state' class='tutor-empty-state' hidden>
    <svg
      width='48'
      height='48'
      viewBox='0 0 24 24'
      fill='none'
      stroke='#a3a3a3'
      stroke-width='1.5'
      stroke-linecap='round'
      stroke-linejoin='round'
    >
      <circle cx='11' cy='11' r='8'></circle>
      <path d='m21 21-4.3-4.3'></path>
    </svg>
    <p class='empty-title'>No se encontraron tutores</p>
    <p class='empty-subtitle'>Intenta con otro nombre o ajusta los filtros</p>
  </div>

  <template id='accordion-panel-template'>
    <div class='accordion-panel' data-tutor-id='' tabindex='0'>
      <img class='panel-photo' src='' alt='' />
      <div class='panel-overlay'></div>
      <div class='panel-content'>
        <h1 class='panel-tutor-name'></h1>
        <button class='panel-cta' type='button'>Ver perfil completo</button>
      </div>
    </div>
  </template>
</section>

<style>
  .tutor-list-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    border-radius: 16px;
  }

  .tutor-list-header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 48px;
    margin-bottom: 24px;
    max-width: 1000px;
    width: 100%;
  }

  .tutor-list-title {
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 400;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: #3c3c3c;
  }

  /* ─── Accordion Container ─── */
  .accordion-container {
    display: flex;
    gap: 8px;
    width: 100%;
    max-width: 1000px;
    height: 250px;
    overflow: hidden;
    border-radius: 20px;
  }

  /* ─── Individual Panel ─── */
  .accordion-panel {
    position: relative;
    flex: 0.6;
    min-width: 0;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .accordion-panel.active {
    flex: 4;
  }

  /* ─── Photo ─── */
  .panel-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    background: var(--color-negrops-100, #e8e8e8);
  }

  /* ─── Dark gradient overlay (active panel, bottom) ─── */
  .panel-overlay {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.35) 40%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .accordion-panel.active .panel-overlay {
    opacity: 1;
  }

  /* Subtle darkening on collapsed panels */
  .accordion-panel:not(.active)::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.1) 40%,
      transparent 60%
    );
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  /* ─── Empty State ─── */
  .tutor-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1000px;
    height: 250px;
    border-radius: 20px;
    border: 1px dashed var(--color-negrops-200, #d4d4d4);
    background: rgba(243, 237, 255, 0.25);
    gap: 8px;
  }

  .empty-title {
    font-family: "Open Sauce Two";
    font-weight: 600;
    font-size: 16px;
    color: #3c3c3c;
    margin: 0;
  }

  .empty-subtitle {
    font-family: "Open Sauce Two";
    font-weight: 400;
    font-size: 14px;
    color: #a3a3a3;
    margin: 0;
  }

  /* ─── Content (only visible on active panel) ─── */
  .panel-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
  }

  .accordion-panel.active .panel-content {
    opacity: 1;
    pointer-events: auto;
  }

  /* ─── Tutor Name ─── */
  .panel-tutor-name {
    font-family: "Open Sauce Two";
    font-weight: 700;
    font-size: 20px;
    line-height: 26px;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.panel-subject-tag) {
    font-family: "Open Sauce Two";
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    color: #1a1a1a;
    background: rgba(250, 233, 183, 0.9);
    border: none;
    border-radius: 999px;
    padding: 3px 12px;
    backdrop-filter: blur(8px);
    white-space: nowrap;
  }

  /* ─── CTA Button ─── */
  .panel-cta {
    align-self: flex-start;
    font-family: "Open Sauce Two";
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    color: #1a1a1a;
    background: #fff;
    border: none;
    border-radius: 999px;
    padding: 7px 18px;
    cursor: pointer;
    transition:
      background 0.2s,
      transform 0.2s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .panel-cta:hover {
    background: var(--color-verdeps-100);
    transform: scale(1.02);
  }

  .panel-cta:active {
    transform: scale(0.98);
  }

  @media (max-width: 768px) {
    .accordion-container {
      flex-direction: column;
      height: auto;
      max-height: none;
      overflow: visible;
      gap: 8px;
      border-radius: 16px;
      scroll-snap-type: none;
      scrollbar-width: none;
      padding: 8px;
    }

    /* Cada card: altura fija, ancho completo, sin expansión flex */
    .accordion-panel,
    .accordion-panel.active {
      flex: none !important;
      width: 100%;
      height: 110px;
      border-radius: 12px;
      scroll-snap-align: start;
      transition: none;
    }

    .panel-photo {
      border-radius: 12px;
    }

    /* Overlay siempre visible en mobile */
    .panel-overlay {
      border-radius: 12px;
      opacity: 1 !important;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.75) 0%,
        rgba(0, 0, 0, 0.2) 60%,
        transparent 100%
      );
    }

    /* Contenido siempre visible en mobile */
    .panel-content {
      opacity: 1 !important;
      pointer-events: auto !important;
      padding: 10px 14px;
      gap: 6px;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .panel-tutor-name {
      font-size: 15px;
      line-height: 20px;
      flex: 1;
      min-width: 0;
    }

    .panel-cta {
      font-size: 12px;
      padding: 6px 14px;
      flex-shrink: 0;
    }

    .tutor-empty-state {
      height: 180px;
    }
  }
</style>

<script is:inline>
  (function () {
    var currentTutors = [];
    var MAX_PANELS = 9;

    if (window.__tutorsCleanup) window.__tutorsCleanup();

    function createAccordionPanel(tutor, isActive) {
      console.log("Creating panel for tutor:", tutor);
      var template = document.getElementById("accordion-panel-template");
      if (!template) return null;

      var clone = template.content.cloneNode(true);
      var panel = clone.querySelector(".accordion-panel");
      panel.dataset.tutorId = tutor.tutorId || tutor.id;

      if (isActive) panel.classList.add("active");

      var img = panel.querySelector(".panel-photo");
      img.src = tutor.photo;
      img.alt = tutor.tutorName || tutor.name || "Tutor";

      panel.querySelector(".panel-tutor-name").textContent =
        tutor.tutorName || tutor.name || tutor.fullName || "Tutor";

      return clone;
    }

    function setActivePanel(container, targetPanel) {
      var panels = container.querySelectorAll(".accordion-panel");
      panels.forEach(function (p) {
        p.classList.remove("active");
      });
      targetPanel.classList.add("active");
    }

    function renderAccordion(tutors) {
      var container = document.getElementById("accordion-container");
      if (!container) return;
      container.innerHTML = "";

      var displayed = tutors.slice(0, MAX_PANELS);

      displayed.forEach(function (tutor, index) {
        var panel = createAccordionPanel(tutor, index === 0);
        if (panel) container.appendChild(panel);
      });

      // Click / hover handlers
      container.querySelectorAll(".accordion-panel").forEach(function (panel) {
        panel.addEventListener("click", function () {
          setActivePanel(container, panel);
        });
        panel.addEventListener("mouseenter", function () {
          setActivePanel(container, panel);
        });
      });

      // CTA button → loadTutor
      container.querySelectorAll(".panel-cta").forEach(function (btn) {
        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          var panel = btn.closest(".accordion-panel");
          if (panel && panel.dataset.tutorId) {
            loadTutor(panel.dataset.tutorId);
          }
        });
      });
    }

    // ── Evento: tutors-updated ──
    function onTutorsUpdated(e) {
      var payload = e.detail;
      var tutors = Array.isArray(payload) ? payload : payload.tutors || [];
      currentTutors = tutors;

      var section = document.getElementById("tutor-list-section");
      var container = document.getElementById("accordion-container");
      var emptyState = document.getElementById("tutor-empty-state");

      // Always show the section once loaded
      if (section) section.hidden = false;

      if (tutors.length === 0) {
        if (container) container.hidden = true;
        if (emptyState) emptyState.hidden = false;
      } else {
        if (container) container.hidden = false;
        if (emptyState) emptyState.hidden = true;
        renderAccordion(tutors);
      }
    }

    document.addEventListener("tutors-updated", onTutorsUpdated);

    // Cleanup para View Transitions
    window.__tutorsCleanup = function () {
      document.removeEventListener("tutors-updated", onTutorsUpdated);
    };
  })();
</script>
