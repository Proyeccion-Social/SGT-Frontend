---
interface Tutor {
  tutorId: string;
  tutorName?: string;
  name?: string;
}
---

<section id="tutor-list-section" class="tutor-list-section" hidden>
  <h2 class="tutor-list-title">Resultados</h2>
  <ul id="tutor-list" class="tutor-list"></ul>

  <template id="tutor-item-template">
    <li class="tutor-list-item">
      <button class="tutor-list-button" data-tutor-id=""></button>
    </li>
  </template>
</section>


<script is:inline>
  document.getElementById("tutor-list")
    ?.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-tutor-id]");
      if (btn) loadTutor(btn.dataset.tutorId);
    });

  document.addEventListener("tutors-updated", (e) => {
    const tutors = e.detail;
    const section = document.getElementById("tutor-list-section");
    const list = document.getElementById("tutor-list");
    const template = document.getElementById("tutor-item-template");
    if (!list || !template || !section) return;

    list.innerHTML = "";
    tutors.forEach(tutor => {
      const clone = template.content.cloneNode(true);
      const btn = clone.querySelector(".tutor-list-button");
      btn.dataset.tutorId = tutor.tutorId || tutor.id;
      btn.textContent = tutor.tutorName || tutor.name || tutor.fullName || "Tutor";
      list.appendChild(clone);
    });

    section.hidden = false;
  });
</script>

<style>
  .tutor-list-section {
    flex: 1;
    min-width: 0;
  }

  .tutor-list-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-negrops-700);
    margin: 0 0 0.75rem;
  }

  .tutor-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 1rem;
  }

  .tutor-list-item {
    margin: 0;
  }

  .tutor-list-button {
    width: 100%;
    padding: 0.75rem 1rem;
    text-align: left;
    background: var(--color-color-white);
    border: 1px solid red;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--color-negrops-700);
    transition: background 0.15s, border-color 0.15s;
  }

  .tutor-list-button:hover {
    background: var(--color-moradops-50);
    border-color: var(--color-moradops-300);
  }

  .tutor-list-button:focus-visible {
    outline: 2px solid var(--color-moradops-500);
    outline-offset: 2px;
  }
</style>

