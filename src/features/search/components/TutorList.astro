---
interface Tutor {
  tutorId: string;
  tutorName?: string;
  name?: string;
}

interface Props {
  tutors: Tutor[];
}

const { tutors } = Astro.props;
---

<section class="tutor-list-section">
  <h2 class="tutor-list-title">Resultados</h2>
  <ul id="tutor-list" class="tutor-list">
    {
      tutors.map((tutor) => (
        <li class="tutor-list-item">
          <button
            class="tutor-list-button"
            data-tutor-id={tutor.tutorId}
          >
            {tutor.tutorName || tutor.name}
          </button>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .tutor-list-section {
    flex: 1;
    min-width: 0;
  }

  .tutor-list-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-negrops-700);
    margin: 0 0 0.75rem;
  }

  .tutor-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tutor-list-item {
    margin: 0;
  }

  .tutor-list-button {
    width: 100%;
    padding: 0.75rem 1rem;
    text-align: left;
    background: var(--color-color-white);
    border: 1px solid var(--color-negrops-100);
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--color-negrops-700);
    transition: background 0.15s, border-color 0.15s;
  }

  .tutor-list-button:hover {
    background: var(--color-moradops-50);
    border-color: var(--color-moradops-300);
  }

  .tutor-list-button:focus-visible {
    outline: 2px solid var(--color-moradops-500);
    outline-offset: 2px;
  }
</style>

<script is:inline>
  document.getElementById("tutor-list")
    ?.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-tutor-id]");
      if (btn) loadTutor(btn.dataset.tutorId);
    });
</script>
