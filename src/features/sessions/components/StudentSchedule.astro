---
import WeeklyCalendar from "@/features/availability/components/Calendar.astro";
import SchedulingWizard from "@/features/sessions/components/SchedulingWizard";
import { getWeekRangeFromOffset } from "@/features/availability/utils/dateUtils";
import { SubjectSelector } from "@/features/sessions/components/SubjectSelector";
import { getAllSubjects } from "@/features/search/services/getAllSubjects";
import { getTutorSlotsDetailedSSR } from "@/features/availability/services/availabilityService";
import UserIcon from "@/features/dashboards/components/icons/UserIcon.svg";
import { Image } from "astro:assets";

import nextWeekIcon from "../assets/next-week.svg";
import previousWeekIcon from "../assets/previous-week.svg";

// Leer offset desde query params — igual que la vista del tutor
const token = Astro.cookies.get("access_token")?.value!;
const offsetParam = Astro.url.searchParams.get("offset");
const subjectIdParam = Astro.url.searchParams.get("subjectId");
const weekOffset = offsetParam ? parseInt(offsetParam, 10) : 0;

const { monday, weekRangeStr, prevOffset, nextOffset } =
  getWeekRangeFromOffset(weekOffset);

const weekReference = [
  monday.getFullYear(),
  String(monday.getMonth() + 1).padStart(2, "0"),
  String(monday.getDate()).padStart(2, "0"),
].join("-");

// 1. Traer materias para el selector (SSR)
const subjectsData = await getAllSubjects(token).catch(() => ({ data: [] }));
const initialSubjects = subjectsData.data ?? subjectsData ?? [];

// 2. Traer slots y perfiles de tutores en una sola llamada
let slots: import("@/features/availability/services/availabilityService").Slot[] =
  [];
let tutorProfiles: Record<
  string,
  import("@/features/availability/services/availabilityService").TutorProfileInfo
> = {};

try {
  const result = await getTutorSlotsDetailedSSR(
    {
      onlyAvailable: true,
      weekStart: weekReference,
      ...(subjectIdParam ? { subjectIds: [subjectIdParam] } : {}),
    },
    token,
  );
  slots = result.slots;
  tutorProfiles = result.tutorProfiles;
} catch (err) {
  console.error("[StudentSchedule] ERROR en getTutorSlotsDetailedSSR:", err);
}

// Filtrar por materia si viene en la URL (el endpoint ya filtra, pero como salvaguarda)
if (subjectIdParam) {
  slots = slots.filter((s) => s.subjectId === subjectIdParam);
}

const subjectQuery = subjectIdParam ? `&subjectId=${subjectIdParam}` : "";
---

<div class='schedule-container'>
  <div class='schedule-header'>
    <div class='header-left'>
      <div class='header-title'>
        <h1>Tu Semana</h1>
      </div>
      <!-- Navegación de semanas y filtros -->
      <div class='nav-actions'>
        <div class='week-nav'>
          <span class='date-range'>{weekRangeStr}</span>
          <div class="nav-actions-specific">
            <div class="week-nav-side-week">
              {
                weekOffset > 0 ? (
                  <a
                    href={`?offset=${prevOffset}${subjectQuery}`}
                    class='week-nav__arrow'
                    aria-label='Semana anterior'
                  >
                    <Image src={previousWeekIcon} alt='Previous Week' />
                  </a>
                ) : (
                  <span class='week-nav__arrow week-nav__arrow--disabled'>
                    <Image src={previousWeekIcon} alt='Previous Week' />
                  </span>
                )
              }
              {
                weekOffset < 1 ? (
                  <a
                    href={`?offset=${nextOffset}${subjectQuery}`}
                    class='week-nav__arrow week-nav__arrow-1'
                    aria-label='Semana siguiente'
                  >
                    <Image src={nextWeekIcon} alt='Next Week' />
                  </a>
                ) : (
                  <span class='week-nav__arrow week-nav__arrow-1 week-nav__arrow--disabled'>
                    <Image src={nextWeekIcon} alt='Next Week' />
                  </span>
                )
              }
            </div>
            <article class='container-subjects-filter'>
              <SubjectSelector
                client:load
                initialSubjects={initialSubjects}
                initialSelectedId={subjectIdParam}
              />
            </article>
          </div>
  
        </div>
      </div>
    </div>
    <div class='legend'>
      <p>Tutorías disponibles esta semana</p>
    </div>
  </div>

  <div class='calendar-scroll-area'>
    <!-- Pasar monday como baseDate para que el calendario muestre la semana correcta -->
    <WeeklyCalendar slots={slots} mode='student' baseDate={monday} />
  </div>

  <SchedulingWizard
    client:only='react'
    slots={slots}
    tutorProfiles={tutorProfiles}
  />
</div>

<style>
  @import "@/styles/variables.css";

  /* ── Contenedor raíz ── */
  .schedule-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 32px 0px 0px 32px;
    border: 1px solid var(--neutral-200);
    overflow: hidden;
    min-width: 0;
  }

  .week-nav__arrow--disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .week-nav {
    display: flex;
    align-items: center;
    position: relative;
    top: 4px;
    /* gap: 14px; */
  }

  .week-nav__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--secondary-100);
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    transition: background 0.15s ease;
  }

  .week-nav__arrow-1 {
    margin-left: 8px;
  }

  .week-nav__arrow:hover {
    background: var(--secondary-200);
  }

  .legend {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    background: linear-gradient(
      90deg,
      #fff5dc,
      #e8f8e0,
      #f0ffd6,
      #dff0ff,
      #ede0ff,
      #ffe8d4
    );
    width: fit-content;
  }

  .legend p {
    font-weight: 400;
    font-style: normal;
    font-size: 13px;
    color: #3c3c3c;
    padding: 5px 14px;
    font-family: "Cabinet Grotesk Variable", sans-serif;
  }

  /* ── Columna derecha ── */
  .content-wrapper {
    flex: 1;
    display: flex;
    padding: 19px 20px 20px 0;
    min-width: 0;
    overflow: hidden; /* punto de contención — igual que en layout de tutor */
  }

  /* ── Panel blanco ── */
  .dashboard-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 16px;
    overflow: hidden; /* contiene el calendario — NO overflow-y: auto aquí */
    min-width: 0;
  }

  /* ── Encabezado (sticky, no scrollea) ── */
  .schedule-header {
    display: flex;
    align-items: flex-start;
    width: 100%;
    padding: 50px 50px 40px 50px;
    box-sizing: border-box;
    flex-shrink: 0; /* nunca se comprime */
    border-bottom: 1px solid var(--neutral-200);
    flex-direction: column;
    gap: 8px;
  }

  .header-left {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
  }

  .header-title {
    display: flex;
    align-items: center;
  }

  .nav-actions, .nav-actions-specific {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .header-title h1 {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-moradops-400);
    margin: 0;
    letter-spacing: -0.02em;
    font-family: "Open Sauce Two";
    font-style: normal;
    /* font-weight: 600; */
    line-height: 32px;
    letter-spacing: -0.02em;
    color: #9f74ff;
  }

  .date-range {
    font-size: 14px;
    font-family: "Open Sauce Two";
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: var(--neutral-default);
  }

  .week-nav-side-week {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 12px;
  }

  .badge {
    display: inline-block;
    background-color: #e2d5ff;
    width: fit-content;
    color: #3c3c3c;
    font-size: 13px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .avatar {
    width: 60px;
    height: 60px;
    border-radius: 100%;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* ── Área del calendario — scroll solo vertical, igual que .calendar-container ── */
  .calendar-scroll-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden; /* bloquea scroll horizontal aquí adentro */
    min-width: 0;
  }

  .calendar-scroll-area::-webkit-scrollbar {
    width: 6px;
  }

  .calendar-scroll-area::-webkit-scrollbar-thumb {
    background: #e7dcff;
    border-radius: 10px;
  }


  @media (max-width: 768px) {
    .schedule-header {
      padding: 24px 20px 16px;
      gap: 10px;
    }
    .schedule-container {
      border-radius: 0;
    }

    .header-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .nav-actions-specific {
      flex-wrap: wrap;
      gap: 10px;
    }

    .header-title h1 {
      font-size: 32px;
      line-height: 36px;
    }

    .date-range {
      /* display: none; */
      font-size: 14px;
      bottom: 0;
    }

    .legend {
      display: none;
    }

    .week-nav {
      top: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .week-nav-side-week {
      margin-left: 0;
    }

    .nav-actions-specific{
      margin-top: 20px;
    }
  }
</style>

<style is:global>
  @media (max-width: 768px) {
    .notification-floating {
      display: none !important;
    }
  }
</style>
