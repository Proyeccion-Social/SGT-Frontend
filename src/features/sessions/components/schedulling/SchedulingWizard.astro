---
import type { CreateSessionDTO, Modality } from '../../types/session.types';
import TutorSelection from './TutorSelection.astro';
import Availability from './Availability.astro';
import Details from './Details.astro';
import Preview from './Preview.astro';

interface Props {
  initialData?: Partial<CreateSessionDTO>;
  modalidadesPermitidas: Modality[];
}

const { initialData = {}, modalidadesPermitidas } = Astro.props;

// Para pasar al script como string
const modalidadesJson = JSON.stringify(modalidadesPermitidas);
const initialDataJson = JSON.stringify(initialData);
---

<div
  id="wizard-root"
  class="space-y-6"
  data-step="1"
  data-modalidades={modalidadesJson}
  data-initial={initialDataJson}
>
  <!-- Header -->
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-semibold">Agendar tutoría</h2>
    <p id="wizard-step-indicator" class="text-sm text-gray-500">
      Paso 1 de 4
    </p>
  </div>

  <!-- Contenido de pasos -->
  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div class="wizard-step" data-step="1">
      <TutorSelection
        initialTutorId={initialData.tutorId}
        initialSubjectId={initialData.subjectId}
      />
    </div>

    <div class="wizard-step hidden" data-step="2">
      <Availability data={initialData} />
    </div>

    <div class="wizard-step hidden" data-step="3">
      <Details data={initialData} />
    </div>

    <div class="wizard-step hidden" data-step="4">
      <Preview data={initialData} isSubmitting={false} />
    </div>

    <p
      id="wizard-error"
      class="mt-4 text-sm text-red-600 hidden"
    ></p>
  </div>

  <!-- Navegación inferior global (opcional) -->
  <div class="flex items-center justify-between">
    <button
      id="wizard-back"
      type="button"
      class="rounded-md border border-gray-300 px-4 py-2 text-sm"
      disabled
    >
      Atrás
    </button>

    <button
      id="wizard-next"
      type="button"
      class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white disabled:opacity-50"
    >
      Siguiente
    </button>
  </div>
</div>

<script>
  type Modality = 'ONLINE' | 'IN_PERSON';

  interface CreateSessionDTO {
    tutorId: string;
    date: string;
    duration: number;
    title: string;
    description: string;
    modality: Modality;
    type?: string;
    subjectId?: string;
  }

  const REQUIRED_FIELDS: (keyof CreateSessionDTO)[] = [
    'tutorId',
    'date',
    'duration',
    'title',
    'description',
    'modality',
  ];

  const root = document.getElementById('wizard-root') as HTMLElement;
  const stepIndicator = document.getElementById('wizard-step-indicator') as HTMLParagraphElement | null;
  const stepElems = Array.from(
    document.querySelectorAll<HTMLElement>('.wizard-step'),
  );
  const backBtn = document.getElementById('wizard-back') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('wizard-next') as HTMLButtonElement | null;
  const errorEl = document.getElementById('wizard-error') as HTMLParagraphElement | null;

  if (!root) {
    throw new Error('wizard-root no encontrado');
  }

  const totalSteps = 4;
  let currentStep = Number(root.dataset.step || '1');

  const modalidadesPermitidas: Modality[] = JSON.parse(
    root.dataset.modalidades || '[]',
  );

  let sessionData: Partial<CreateSessionDTO> = {};
  try {
    sessionData = JSON.parse(root.dataset.initial || '{}');
  } catch {
    sessionData = {};
  }

  let isSubmitting = false;

  function setError(message: string | null) {
    if (!errorEl) return;
    if (!message) {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    } else {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
  }

  function updateStepUI() {
    stepElems.forEach((el) => {
      const stepVal = Number(el.dataset.step);
      if (stepVal === currentStep) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    if (stepIndicator) {
      stepIndicator.textContent = `Paso ${currentStep} de ${totalSteps}`;
    }

    if (backBtn) {
      backBtn.disabled = currentStep === 1;
    }

    if (nextBtn) {
      nextBtn.disabled = currentStep === totalSteps || !canGoToStep(currentStep + 1);
    }
  }

  function canGoToStep(target: number): boolean {
    if (target <= 1) return true;

    if (target >= 2) {
      if (!sessionData.tutorId) return false;
    }

    if (target >= 3) {
      if (!sessionData.date || !sessionData.duration || !sessionData.modality) {
        return false;
      }
    }

    if (target >= 4) {
      if (!sessionData.title || !sessionData.description) return false;
    }

    return true;
  }

  function goToStep(step: number) {
    if (step < 1 || step > totalSteps) return;
    if (!canGoToStep(step)) return;
    currentStep = step;
    root.dataset.step = String(currentStep);
    setError(null);
    updateStepUI();
  }

  async function submitSession() {
    setError(null);

    for (const field of REQUIRED_FIELDS) {
      if (!sessionData[field]) {
        setError('Por favor completa todos los campos requeridos antes de confirmar.');
        return;
      }
    }

    if (
      modalidadesPermitidas.length &&
      sessionData.modality &&
      !modalidadesPermitidas.includes(sessionData.modality)
    ) {
      setError('La modalidad seleccionada no está permitida para este tutor.');
      return;
    }

    if (isSubmitting) return;
    isSubmitting = true;

    try {
      const res = await fetch('/sessions', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(sessionData),
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        setError(data.message || 'No se pudo agendar la sesión. Intenta de nuevo más tarde.');
        isSubmitting = false;
        return;
      }

      setError(null);
      // TODO: redirigir a dashboard/historial según convenga
      window.location.href = '/dashboard';
    } catch (e: any) {
      setError(e?.message || 'Ocurrió un error inesperado al agendar la sesión.');
    } finally {
      isSubmitting = false;
    }
  }

  // Eventos desde los steps
  document.addEventListener('wizard:step1-completed', (event) => {
    const { tutorId, subjectId } = (event as CustomEvent<{
      tutorId: string;
      subjectId?: string;
    }>).detail;

    sessionData = {
      ...sessionData,
      tutorId,
      ...(subjectId ? { subjectId } : {}),
    };

    goToStep(2);
  });

  document.addEventListener('wizard:step2-completed', (event) => {
    const { date, duration, modality } = (event as CustomEvent<{
      date: string;
      duration: number;
      modality: Modality;
    }>).detail;

    sessionData = {
      ...sessionData,
      date,
      duration,
      modality,
    };

    goToStep(3);
  });

  document.addEventListener('wizard:step3-completed', (event) => {
    const { title, description } = (event as CustomEvent<{
      title: string;
      description: string;
    }>).detail;

    sessionData = {
      ...sessionData,
      title,
      description,
    };

    goToStep(4);
  });

  document.addEventListener('wizard:go-to-step', (event) => {
    const { step } = (event as CustomEvent<{ step: number }>).detail;
    goToStep(step);
  });

  document.addEventListener('wizard:confirm-session', () => {
    submitSession();
  });

  // Navegación inferior global
  backBtn?.addEventListener('click', () => {
    goToStep(currentStep - 1);
  });

  nextBtn?.addEventListener('click', () => {
    goToStep(currentStep + 1);
  });

  updateStepUI();
</script>
