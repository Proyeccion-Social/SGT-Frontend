---
interface Props {
  initialTutorId?: string;
  initialSubjectId?: string;
}

const { initialTutorId = '', initialSubjectId = '' } = Astro.props;
---

<div id="tutor-step" class="space-y-4" data-tutor-id={initialTutorId} data-subject-id={initialSubjectId}>
  <h3 class="text-lg font-semibold">Selecciona un tutor y materia</h3>

  <p class="text-sm text-gray-500">
    Busca el tutor o la materia para esta tutoría. Esta selección se usará en el resto del flujo.
  </p>

  <!-- Placeholder: aquí irá el componente de búsqueda de Lucho -->
  <div
    id="tutor-search-placeholder"
    class="rounded-lg border border-dashed border-gray-300 p-4 text-sm text-gray-500"
  >
    Aquí irá el componente de búsqueda de Lucho.
    Cuando el usuario seleccione un tutor, este componente deberá disparar un
    evento <code>tutor:selected</code> con <code>{'{ tutorId, subjectId? }'}</code>.
  </div>

  <div class="flex justify-end">
    <button
      id="step1-continue"
      type="button"
      class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white disabled:opacity-50"
      disabled={!initialTutorId}
    >
      Continuar
    </button>
  </div>
</div>

<script>
  const root = document.getElementById('tutor-step') as HTMLElement | null;
  const continueBtn = document.getElementById('step1-continue') as HTMLButtonElement | null;

  let tutorId: string | null = root?.dataset.tutorId || null;
  let subjectId: string | null = root?.dataset.subjectId || null;

  function updateButtonState() {
    if (!continueBtn) return;
    continueBtn.disabled = !tutorId;
  }

  // Escuchar selección de tutor desde el buscador de Lucho (cuando esté integrado)
  document.addEventListener('tutor:selected', (event: Event) => {
    const custom = event as CustomEvent<{ tutorId: string; subjectId?: string }>;
    tutorId = custom.detail.tutorId;
    subjectId = custom.detail.subjectId ?? null;

    if (root) {
      root.dataset.tutorId = tutorId;
      if (subjectId) root.dataset.subjectId = subjectId;
    }

    updateButtonState();
  });

  // Al hacer clic en "Continuar", avisar al contenedor del wizard
  continueBtn?.addEventListener('click', () => {
    if (!tutorId) return;

    root?.dispatchEvent(
      new CustomEvent('wizard:step1-completed', {
        detail: { tutorId, subjectId },
        bubbles: true,
      }),
    );
  });

  updateButtonState();
</script>
