---
import infoIcon from "@/features/tutorAvailability/assets/infoIcon.png";
import line from "@/features/tutorAvailability/assets/line.svg";
---

<dialog id="hours-config-dialog">
    <div class="container">
        <div class="title">
            <div class="line">Limite de horas</div> semanales
        </div>

        <p class="description">
            Evita sobrecargarte limitando la cantidad de horas semanales que impartes
        </p>

        <input
            id="hoursInput"
            type="number"
            min="1"
            placeholder="Ej: 10"
            class="hoursInput"
        />

        <!-- ✅ Label de máximo -->
        <p id="maxHoursLabel"
           style="font-size: 14px; color: #5f5f5f; margin-top: 10px;">
        </p>

        <!-- ✅ Error mínimo -->
        <p id="minHoursError"
           style="display: none; color: #f35761; font-size: 14px; margin-top: 5px;">
            El valor mínimo es 1 hora
        </p>

        <!-- ✅ Error máximo -->
        <p id="hoursError"
           style="display: none; color: #f35761; font-size: 14px; margin-top: 5px;">
        </p>

        <button id="enviarBtn" class="enviarBtn">
            Terminar y guardar
        </button>
    </div>
</dialog>

<style>
/* TODO tu CSS igual */
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const dialog = document.getElementById("hours-config-dialog") as HTMLDialogElement;
    const enviarBtn = document.getElementById("enviarBtn") as HTMLButtonElement;
    const hoursInput = document.getElementById("hoursInput") as HTMLInputElement;

    const errorText = document.getElementById("hoursError") as HTMLParagraphElement;
    const maxHoursLabel = document.getElementById("maxHoursLabel") as HTMLParagraphElement;
    const minHoursError = document.getElementById("minHoursError") as HTMLParagraphElement;
    let  hours = "";

    // 🔥 Abrir dialog
    window.addEventListener("open-hours-config-dialog", (e: any) => {
         hours = e.detail;

        hoursInput.value = hours;
        hoursInput.max = hours;

        maxHoursLabel.textContent =
            `Máximo permitido: ${hours} horas (Total de horas de franjas creadas)`;
        errorText.textContent = `El valor debe ser menor o igual a ${hours} horas`;

        // reset errores
        errorText.style.display = "none";
        minHoursError.style.display = "none";

        window.dispatchEvent(new CustomEvent("close-tutor-calendar-dialog"));
        dialog.showModal();
    });

    // 🔥 Guardar
    enviarBtn.addEventListener("click", async () => {
        const value = parseInt(hoursInput.value);
        const max = parseInt(hoursInput.max);

        // reset
        errorText.style.display = "none";
        maxHoursLabel.style.color = "#5f5f5f";
        minHoursError.style.display = "none";

        if (value > max) {
            maxHoursLabel.style.color = "red";
            return;
        }

        if (value < 1 || isNaN(value)) {
            minHoursError.style.display = "block";
            return;
        }

        try {
            const response = await fetch("/api/tutor-availability/patch-tutor-limits", {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ hours: value }),
            });

            if (response.ok) {
                window.dispatchEvent(new CustomEvent("refresh-slots"));
            }
        } catch (error) {
            console.log("Error al actualizar horas:", error);
        }

        dialog.close();
    });

    // 🔥 Validación en tiempo real
    hoursInput.addEventListener("input", () => {
        const value = parseInt(hoursInput.value);
        const max = parseInt(hoursInput.max);

        errorText.style.display = "none";
                maxHoursLabel.style.color = "#5f5f5f";

        minHoursError.style.display = "none";

        if (value > max) {
            maxHoursLabel.style.color = "red";
        }

        if (value < 1 || isNaN(value)) {
            minHoursError.style.display = "block";
        }
    });

});
</script>

<style>
    dialog {
        display: none;
        border: none;
        padding: 0;
        width: 100vw;
        height: 100vh;
        max-width: none;
        max-height: none;
        background-color: transparent;
        margin: 0;
    }

    dialog[open] {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
    }

    .title {
        font-size: 32px;
        font-weight: 600;
        letter-spacing: -2%;
        color: #1e293b;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 5px;
    }

    .line {
        background-image: url("/src/features/tutorAvailability/assets/line.svg");
        background-size: contain; /* 🔥 muestra TODA la imagen */
        background-repeat: no-repeat;
        background-position: center;

        display: inline-block;
        padding: 4px 10px;
    }

    .description {
        font-weight: 400;
        font-size: 16px;
        line-height: 20px;
        letter-spacing: -2%;
        text-align: center;
        color: #1e293b;
    }

    .hoursInput {
        align-self: center;
        margin-top: 35px;
        padding: 10px;
        width: 160px;
        height: 40px;
        opacity: 1;
        top: 197px;
        left: 202.7px;
        border-radius: 8.8px;
        border-width: 1.1px;
        border: 1px solid #c6c6c6;
    }

    .container {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;
        gap: 0px;
        background-color: white;
        padding: 60px;
        border-radius: 16px;
        border: 1px solid #c6c6c6;
        width: 570px;
        height: 320px;
    }

    .enviarBtn {
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 167px;
        height: 36px;
        background-color: #9f74ff;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        line-height: 20px;
        letter-spacing: -2%;
        transition: background-color 0.3s ease;
    }

    .enviarBtn:hover {
        background-color: #8751ff;
    }

    .enviarBtn:active {
        background-color: #8751ff;
    }
</style>