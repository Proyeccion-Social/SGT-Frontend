<dialog id='hours-config-dialog'>
  <div class='container'>
    <div class='title'>
      <div class='line'>Limite de horas</div> semanales
    </div>

    <p class='description'>
      Evita sobrecargarte limitando la cantidad de horas semanales que impartes
    </p>

    <input
      id='hoursInput'
      type='number'
      min='1'
      step='1'
      placeholder='Ej: 10'
      class='hoursInput'
    />

    <!-- ✅ Label de máximo -->
    <p
      id='maxHoursLabel'
      style='font-size: 14px; color: #5f5f5f; margin-top: 10px;'
    >
    </p>

    <!-- ✅ Error mínimo -->
    <p
      id='minHoursError'
      style='display: none; color: #f35761; font-size: 14px; margin-top: 5px;'
    >
      El valor mínimo es 1 hora
    </p>

    <!-- ✅ Error máximo -->
    <p
      id='hoursError'
      style='display: none; color: #f35761; font-size: 14px; margin-top: 5px;'
    >
    </p>

    <button id='enviarBtn' class='enviarBtn'> Terminar y guardar </button>
  </div>
</dialog>

<style>
  /* TODO tu CSS igual */
</style>

<script>
  import { sileo } from "sileo";
  document.addEventListener("astro:page-load", () => {
    const dialog = document.getElementById(
      "hours-config-dialog",
    ) as HTMLDialogElement;
    const enviarBtn = document.getElementById("enviarBtn") as HTMLButtonElement;
    const hoursInput = document.getElementById(
      "hoursInput",
    ) as HTMLInputElement;

    // Guard: if elements are not in the DOM (e.g. navigated away from tutor page), bail out
    if (!dialog || !enviarBtn || !hoursInput) return;

    // Evitar que se cierre con la tecla Escape
    dialog?.addEventListener("cancel", (event) => {
      event.preventDefault();
    });

    dialog?.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
      }
    });

    const errorText = document.getElementById(
      "hoursError",
    ) as HTMLParagraphElement;
    const maxHoursLabel = document.getElementById(
      "maxHoursLabel",
    ) as HTMLParagraphElement;
    const minHoursError = document.getElementById(
      "minHoursError",
    ) as HTMLParagraphElement;
    let hours = "";

    const unlockPointerEvents = () => {
      document.documentElement.style.pointerEvents = "auto";
      document.body.style.pointerEvents = "auto";
    };

    const redirectOnUnauthorized = (status: number) => {
      if (status === 401) {
        window.location.replace("/");
        return true;
      }
      return false;
    };

    // 🔥 Abrir dialog
    window.addEventListener("open-hours-config-dialog", (e: any) => {
      const totalHoursRaw = parseFloat(e.detail);
      const floorHours = Math.floor(totalHoursRaw);

      // Si total < 8, el limite es total. Si total >= 8, el limite es 8.
      const limit = floorHours < 8 ? floorHours : 8;

      hoursInput.value = limit.toString();
      hoursInput.max = limit.toString();

      maxHoursLabel.textContent = `Máximo permitido: ${limit} horas (Total de horas de franjas creadas ${totalHoursRaw})`;
      errorText.textContent = `El valor debe ser menor o igual a ${limit} horas`;

      // Actualizamos la variable global 'hours' que se usa en validaciones
      hours = limit.toString();
      // reset errores
      errorText.style.display = "none";
      minHoursError.style.display = "none";

      window.dispatchEvent(new CustomEvent("close-tutor-calendar-dialog"));
      unlockPointerEvents();

      // Espera a que termine la animación del drawer antes de abrir el modal

      if (dialog && dialog.isConnected && !dialog.open) {
        dialog.showModal();
      }
    });

    // 🔥 Prevenir escritura de decimales y otros caracteres no válidos
    hoursInput.addEventListener("keydown", (e) => {
      if (["e", "E", "+", "-", ".", ","].includes(e.key)) {
        e.preventDefault();
      }
    });

    // 🔥 Guardar
    enviarBtn.addEventListener("click", async () => {
      const value = parseInt(hoursInput.value);
      const max = parseInt(hoursInput.max);

      // reset
      errorText.style.display = "none";
      maxHoursLabel.style.color = "#5f5f5f";
      minHoursError.style.display = "none";

      if (value > max) {
        maxHoursLabel.style.color = "red";
        return;
      }

      if (value < 1 || isNaN(value)) {
        minHoursError.style.display = "block";
        return;
      }

      await sileo.promise(
        async () => {
          const response = await fetch(
            "/api/tutor-availability/patch-tutor-limits",
            {
              method: "PATCH",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({ hours: value }),
            },
          );

          if (redirectOnUnauthorized(response.status)) {
            return;
          }

          if (!response.ok) {
            const errorData = await response.json().catch(() => ({}));
            throw new Error(errorData.message || "Error al actualizar horas");
          }
          
          window.dispatchEvent(new CustomEvent("refresh-slots"));
          // Solo en onboarding: el dialog de horas no se abre en modo edición.
          setTimeout(() => {
              window.dispatchEvent(new CustomEvent('tutorial:start'));
          }, 500);
          dialog.close();
        },
        {
          loading: { title: "Guardando límites...", fill: "#8751ff" },
          success: { title: "Límites guardados con éxito", fill: "#58d68d" },
          error: {
            title: "Error",
            description: "No se pudo guardar el límite de horas",
            fill: "#f35761",
          },
        },
      );
    });

    // 🔥 Validación en tiempo real
    hoursInput.addEventListener("input", () => {
      const value = parseInt(hoursInput.value);
      const max = parseInt(hoursInput.max);

      errorText.style.display = "none";
      maxHoursLabel.style.color = "#5f5f5f";

      minHoursError.style.display = "none";

      if (value > max) {
        maxHoursLabel.style.color = "red";
      }

      if (value < 1 || isNaN(value)) {
        minHoursError.style.display = "block";
      }
    });
  });
</script>

