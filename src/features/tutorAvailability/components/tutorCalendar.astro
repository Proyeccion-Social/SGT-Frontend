---
import AvailabilitySideBar from "@/features/tutorAvailability/components/AvailabilitySideBar";
import HelpSideBar from "@/features/tutorAvailability/components/HelpSideBar";
import TutorCalendarGrid from "@/features/tutorAvailability/components/TutorCalendarGrid";
import closeIcon from "@/features/tutorAvailability/assets/closeHelpDialog.svg";
---

<div
  id="tutor-calendar-dialog"
  class="tutor-calendar-dialog hidden"
  data-mode="onboarding"
>
  <div class="tutor-calendar-outer">
    <div class="tutor-calendar-scroll">
      <TutorCalendarGrid client:only="react" />
    </div>
  </div>
  <AvailabilitySideBar client:only="react" slots={[]} />
  <div id="tutor-calendar-left-actions">
    <div id="help-sidebar-container">
      <HelpSideBar client:load />
    </div>
    <button
      type="button"
      id="tutor-calendar-close-btn"
      class="tutor-calendar-close-btn"
      aria-label="Cerrar calendario"
      hidden
    >
      <img src={closeIcon.src} alt="" aria-hidden="true" />
    </button>
  </div>
</div>

<style>
  .tutor-calendar-dialog {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
  }

  #tutor-calendar-left-actions {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    z-index: 1001;
  }

  #tutor-calendar-dialog[data-mode="edit"] #help-sidebar-container {
    display: none;
  }

  .tutor-calendar-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: none;
    border-radius: 9999px;
    background: var(--surface-action);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .tutor-calendar-close-btn:hover {
    background: var(--surface-action-hover);
  }

  .tutor-calendar-close-btn:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .tutor-calendar-close-btn[hidden] {
    display: none;
  }

  .tutor-calendar-outer {
    width: 100%;
    max-width: 1200px;
    max-height: 80vh;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    background: var(--neutral-blanco, #ffffff);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    border: 1px solid var(--neutral-200, #c6c6c6);
    position: relative;
  }

  .tutor-calendar-scroll {
    width: 100%;
    max-height: 80vh;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .tutor-calendar-scroll::-webkit-scrollbar {
    width: 8px;
  }

  .tutor-calendar-scroll::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  .tutor-calendar-scroll::-webkit-scrollbar-thumb {
    background: #c4b5fd;
    border-radius: 8px;
  }

  .tutor-calendar-scroll::-webkit-scrollbar-thumb:hover {
    background: #a78bfa;
  }

  .tutor-calendar-scroll::-webkit-scrollbar-button {
    height: 0 !important;
    width: 0 !important;
    display: block;
    background: transparent;
  }

  .tutor-calendar-scroll::-webkit-scrollbar-button:start:decrement,
  .tutor-calendar-scroll::-webkit-scrollbar-button:end:increment {
    height: 0;
    width: 0;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  import { sileo } from "sileo";

  type AvailabilityMode = "onboarding" | "edit";

  const getDialog = () =>
    document.getElementById("tutor-calendar-dialog") as HTMLElement | null;

  const getCloseBtn = () =>
    document.getElementById("tutor-calendar-close-btn") as HTMLButtonElement | null;

  const getMode = (): AvailabilityMode => {
    const mode = getDialog()?.dataset.mode;
    return mode === "edit" ? "edit" : "onboarding";
  };

  const setMode = (mode: AvailabilityMode) => {
    const dialog = getDialog();
    const closeBtn = getCloseBtn();
    if (!dialog) return;

    dialog.dataset.mode = mode;
    if (closeBtn) {
      closeBtn.hidden = mode !== "edit";
    }
  };

  const openDialog = (mode: AvailabilityMode = "onboarding") => {
    const dialog = getDialog();
    setMode(mode);
    dialog?.classList.remove("hidden");
    window.dispatchEvent(
      new CustomEvent("tutor-availability-mode-changed", { detail: { mode } }),
    );
  };

  const closeDialog = () => {
    const dialog = getDialog();
    const wasEdit = getMode() === "edit";
    dialog?.classList.add("hidden");
    window.dispatchEvent(new CustomEvent("close-availability-sidebar"));
    // CalendarSlots es SSR: recargar para reflejar franjas ya persistidas.
    if (
      wasEdit &&
      window.location.pathname.includes("/availability/tutor/slots")
    ) {
      setTimeout(() => window.location.reload(), 350);
    }
  };

  window.addEventListener("open-tutor-calendar-dialog", ((e: CustomEvent) => {
    const mode: AvailabilityMode =
      e.detail?.mode === "edit" ? "edit" : "onboarding";
    openDialog(mode);
  }) as EventListener);

  window.addEventListener("close-tutor-calendar-dialog", () => {
    closeDialog();
  });

  document.addEventListener("keydown", (event) => {
    const dialog = getDialog();
    if (!dialog || dialog.classList.contains("hidden")) return;
    if (event.key !== "Escape") return;
    if (getMode() !== "edit") {
      event.preventDefault();
      return;
    }
    closeDialog();
  });

  const onCloseClick = (e: MouseEvent) => {
    e.stopPropagation();
    if (getMode() === "edit") {
      closeDialog();
    }
  };

  const bindCloseBtn = () => {
    const btn = getCloseBtn();
    if (!btn || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";
    btn.addEventListener("click", onCloseClick);
  };

  bindCloseBtn();
  document.addEventListener("astro:page-load", bindCloseBtn);

  window.addEventListener("delete-slot", async (e: Event) => {
    const event = e as CustomEvent;

    await sileo.promise(
      async () => {
        const response = await fetch(
          "/api/tutor-availability/delete-slots-by-range",
          {
            method: "DELETE",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(event.detail),
          },
        );

        if (response.status === 401) {
          window.location.replace("/");
          return;
        }

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.message || "Error al eliminar el slot");
        }

        window.dispatchEvent(new CustomEvent("refresh-slots"));
      },
      {
        loading: { title: "Eliminando franja...", fill: "#8751ff" },
        success: { title: "Franja eliminada", fill: "#58d68d" },
        error: {
          title: "Error",
          description: "No se pudo eliminar la franja",
          fill: "#f35761",
        },
      },
    );
  });
</script>
