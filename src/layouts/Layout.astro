---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { TooltipProvider } from "@/components/ui/tooltip";
import ToasterReact from "@/components/ui/ToasterReact";
import StoreHydrator from "@/store/StoreHydrator";
import SEO from "@/components/seo/SEO.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object;
  noToaster?: boolean;
}

const {
  title,
  description = "Atlas es la plataforma de tutorías universitarias para la Universidad Distrital Francisco José de Caldas. Agenda sesiones con tutores especializados en Bogotá.",
  canonical,
  ogImage,
  noindex = false,
  schema,
  noToaster = false,
} = Astro.props;
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      schema={schema}
    />
    <ClientRouter />
  </head>
  <body>
    <TooltipProvider>
      <slot />
    </TooltipProvider>
    <StoreHydrator client:load transition:persist />
    {!noToaster && <ToasterReact client:load transition:persist />}
  </body>
</html>
