---
import MainLayout from "../Layout.astro";
import Sidebar from "@/features/dashboards/components/Sidebar.astro";
import UserHeader from "@/features/general/components/UserHeader.astro";
import Calendar from "@/features/availability/components/Calendar.astro";
import RightCalendarMenu from "@/features/availability/components/RightCalendarMenu.astro";
import type { Slot } from "@/features/availability/services/availabilityService";
import { getUserIdFromCookie } from "@/features/auth/utils/authUtils";
import { getWeekRangeFromOffset } from "@/features/availability/utils/dateUtils";
import { Image } from "astro:assets";
import { getTutorSlots } from "@/features/availability/services/availabilityService";
import BackArrowIcon from "@/features/availability/components/assets/imgs/BackArrowIcon.svg";
import ForwardArrowIcon from "@/features/availability/components/assets/imgs/ForwardArrowIcon.svg";
import ArrowUpIcon from "@/features/availability/components/assets/imgs/ArrowUpIcon.svg";

const tutorId = getUserIdFromCookie(Astro.cookies);

let Slots: Slot[] = [];

if (tutorId) {
  try {
    Slots = await getTutorSlots(tutorId);
  } catch (e: any) {}
}

const offsetParam = Astro.url.searchParams.get("offset");
const weekOffset = offsetParam ? parseInt(offsetParam, 10) : 0;

const { today, prevOffset, nextOffset, weekRangeStr } =
  getWeekRangeFromOffset(weekOffset);

const isMenuOpen = Astro.url.searchParams.get("openMenu") === "true";
---

<MainLayout title='Availability'>
  <div class='availability-container'>
    <div id='sidebar-container'>
      <Sidebar userRole='tutor' />
    </div>

    <main class={`content-wrapper ${isMenuOpen ? "no-scroll" : ""}`}>
      <div class={`overlay ${isMenuOpen ? "active" : ""}`} id='menu-overlay'>
      </div>
      <div class='calendar-header'>
        <div class='week-selector'>
          <h3>Tu Semana</h3>
          <p>{weekRangeStr}</p>
          <a href={`?offset=${prevOffset}`} class='nav-button'>
            <Image src={BackArrowIcon} alt='Back' />
          </a>
          <a href={`?offset=${nextOffset}`} class='nav-button'>
            <Image src={ForwardArrowIcon} alt='Forward' />
          </a>
          <button class='mes-btn' id='right-menu-toggle'
            >Mes <Image src={ArrowUpIcon} alt='Arrow Up' /></button
          >
          <UserHeader userRole='tutor' />
        </div>
        <div class='legend'>
          <p>Franjas horarias disponibles de tu semana</p>
        </div>
      </div>

      <div class='calendar-container'>
        <Calendar slots={Slots} baseDate={today} />
      </div>

      <div id='right-menu' class={isMenuOpen ? "active" : ""}>
        <RightCalendarMenu
          slots={Slots}
          baseDate={today}
          offset={weekOffset}
          prevOffset={prevOffset}
          nextOffset={nextOffset}
        />
      </div>
    </main>
  </div>
</MainLayout>

<style>
  body {
    margin: 0;
    padding: 0;
    overflow: hidden; /* Bloquea scroll vertical y horizontal global */
    width: 100vw;
    height: 100vh;
  }

  .availability-container {
    display: flex;
    width: 100%;
    height: 100vh;
    background-color: #f3edff;
    padding: 18px 20px 20px 0;
    box-sizing: border-box;
    overflow: hidden;
    align-items: stretch;
    z-index: 1001;
  }

  .content-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 16px;
    position: relative;
    justify-content: flex-start;
    overflow: hidden;
    z-index: 1000;
  }

  .content-wrapper.no-scroll {
    overflow-y: hidden;
  }

  .calendar-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .calendar-header {
    display: flex;
    flex-direction: column;
    justify-content: left;
    width: 100%;
    padding: 40px 50px 40px 50px;
    border-bottom: solid 1px #e7dcff;
  }

  .week-selector {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
  }

  .week-selector h3 {
    font-size: 32px;
    font-weight: bold;
    color: #9f74ff;
  }

  .week-selector p {
    font-size: 16px;
    font-weight: 400;
    font-style: normal;
    color: #5f5f5f;
    margin-top: 5px;
  }

  .week-selector .nav-button {
    height: 1.5rem;
    width: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
  }

  .legend {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    background: linear-gradient(
      90deg,
      #fff5dc,
      #e8f8e0,
      #f0ffd6,
      #dff0ff,
      #ede0ff,
      #ffe8d4
    );
    width: fit-content;
  }

  .legend p {
    font-weight: 400;
    font-style: normal;
    font-size: 13px;
    color: #3c3c3c;
    padding: 5px 14px;
    font-family: "Cabinet Grotesk Variable", sans-serif;
  }

  .calendar-body {
    padding: 20px;
    height: 100%;
    width: 100%;
  }

  .calendar-container::-webkit-scrollbar {
    width: 6px;
    height: 100px;
  }

  .calendar-container::-webkit-scrollbar-thumb {
    background: #e7dcff;
    border-radius: 10px;
  }

  #sidebar-container {
    z-index: 1001;
    top: 0;
    height: 100%;
    display: flex;
    position: relative;
    margin-top: -1rem;
    margin-bottom: -1.5rem;
  }

  /* Menu contextual */
  #right-menu {
    position: absolute;
    top: 0;
    right: -312px;
    width: 310px;
    height: 100%;
    background-color: #fff;
    border-radius: 0 16px 16px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    z-index: 1000;
    transition: right 0.3s ease-in-out;
  }

  #right-menu.active {
    right: 0;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 16px;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 900;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .overlay.active {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  .mes-btn {
    background-color: #daffaa;
    color: #4d662e;
    border: none;
    border-radius: 8px;
    padding: 0px 4px 0px 8px;
    font-size: 16px;
    font-weight: 400;
    font-style: normal;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }
</style>

<script>
  const setupMenu = () => {
    const toggleButton = document.getElementById("right-menu-toggle");
    const rightMenu = document.getElementById("right-menu");
    const overlay = document.getElementById("menu-overlay");
    const contentWrapper = document.querySelector(".content-wrapper");

    const openMenu = () => {
      rightMenu?.classList.add("active");
      overlay?.classList.add("active");
      contentWrapper?.classList.add("no-scroll");
      //   window.dispatchEvent(new CustomEvent("force-sidebar-expand"));
    };

    const closeMenu = () => {
      rightMenu?.classList.remove("active");
      overlay?.classList.remove("active");
      contentWrapper?.classList.remove("no-scroll");
      window.dispatchEvent(new CustomEvent("force-sidebar-collapse"));
    };

    if (rightMenu && overlay) {
      // 1. Click en botón Mes
      toggleButton?.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        openMenu();
      });

      // 2. Click en overlay (única forma de cerrar)
      overlay.addEventListener("click", () => {
        closeMenu();
      });
    }
  };

  // Ejecutar en carga inicial y en navegaciones de Astro
  document.addEventListener("DOMContentLoaded", setupMenu);
  document.addEventListener("astro:page-load", setupMenu);
</script>
