---
import { getUserIdFromCookie } from "@/features/auth/utils/authUtils";
import { getWeekRangeFromOffset } from "@/features/availability/utils/dateUtils";
import { getTutorSlots } from "@/features/availability/services/availabilityService";
import type { Slot } from "@/features/availability/services/availabilityService";

import ArrowUpIcon from "@/features/availability/components/assets/imgs/ArrowUpIcon.svg";

import Calendar from "@/features/availability/components/Calendar.astro";

const tutorId = getUserIdFromCookie(Astro.cookies);
const token = Astro.cookies.get("access_token")?.value;

let Slots: Slot[] = [];

if (tutorId) {
  try {
    Slots = await getTutorSlots(tutorId, undefined, token);
  } catch (e: any) {}
}

const offsetParam = Astro.url.searchParams.get("offset");
const weekOffset = offsetParam ? parseInt(offsetParam, 10) : 0;

const { today, weekRangeStr } = getWeekRangeFromOffset(weekOffset);
---

<main class="content-wrapper">
  <div class="calendar-header" id="weekMonthTutorTUTORIAL">
    <div class="week-selector">
      <h3>Tu Semana</h3>
      <p>{weekRangeStr}</p>
      <button
        type="button"
        class="actualizar-btn"
        id="actualizarDisponibilidadTutorTUTORIAL"
      >
        <span>Actualizar</span>
        <img src={ArrowUpIcon.src} alt="" aria-hidden="true" />
      </button>
    </div>
    <div class="legend">
      <p>Franjas horarias disponibles de tu semana</p>
    </div>
  </div>

  <div class="calendar-container" id="calendarTutorTUTORIAL">
    <Calendar slots={Slots} baseDate={today} />
  </div>
</main>

<style>
  .content-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--neutral-blanco, #fff);
    position: relative;
    justify-content: flex-start;
    overflow: hidden;
    border-radius: 32px 0px 0px 32px;
    border: 1px solid var(--neutral-200);
    height: 100%;
  }

  .calendar-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .calendar-header {
    display: flex;
    flex-direction: column;
    justify-content: left;
    width: 100%;
    padding: 50px 50px 40px;
    border-bottom: solid 1px var(--border-primary);
  }

  .week-selector {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .week-selector h3 {
    font-size: 32px;
    font-weight: bold;
    color: var(--primary-400);
  }

  .week-selector p {
    font-size: 16px;
    font-weight: 400;
    font-style: normal;
    color: #5f5f5f;
    margin-top: 5px;
  }

  .legend {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    background: linear-gradient(
      90deg,
      #fff5dc,
      #e8f8e0,
      #f0ffd6,
      #dff0ff,
      #ede0ff,
      #ffe8d4
    );
    width: fit-content;
  }

  .legend p {
    font-weight: 400;
    font-style: normal;
    font-size: 13px;
    color: #3c3c3c;
    padding: 5px 14px;
    font-family: "Cabinet Grotesk Variable", sans-serif;
  }

  .calendar-container::-webkit-scrollbar {
    width: 6px;
    height: 100px;
  }

  .calendar-container::-webkit-scrollbar-thumb {
    background: #e7dcff;
    border-radius: 10px;
  }

  .actualizar-btn {
    background-color: var(--secondary-default, #daffaa);
    color: var(--secondary-700, #4d662e);
    border: none;
    border-radius: var(--border-radius-md);
    padding: 0px 4px 0px 12px;
    font-size: 14px;
    font-weight: 400;
    font-style: normal;
    cursor: pointer;
    display: flex;
    align-items: center;
    /* gap: 4px; */
    transition: background-color 0.2s ease, opacity 0.2s ease;
    margin-top: 5px;
  }

  .actualizar-btn:hover {
    background-color: var(--secondary-500, #c5f08a);
  }

  .actualizar-btn:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .actualizar-btn:active {
    opacity: 0.9;
  }
</style>

<script>
  const setupActualizarBtn = () => {
    const btn = document.getElementById("actualizarDisponibilidadTutorTUTORIAL");
    if (!btn || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    btn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      window.dispatchEvent(
        new CustomEvent("open-tutor-calendar-dialog", {
          detail: { mode: "edit" },
        }),
      );
    });
  };

  document.addEventListener("DOMContentLoaded", setupActualizarBtn);
  document.addEventListener("astro:page-load", setupActualizarBtn);
</script>
