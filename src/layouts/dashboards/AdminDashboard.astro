---
import { Image } from "astro:assets";
import { WelcomeBanner } from "../../features/dashboards/components/WelcomeBanner";

import MainLayout from "../Layout.astro";
import Sidebar from "../../features/dashboards/components/Sidebar.astro";
import OptionButton from "../../features/dashboards/components/OptionButton.astro";

import RoleChangeIcon from "../../features/dashboards/components/icons/RoleChangeIcon.svg";
import UserIcon from "../../features/dashboards/components/icons/UserIcon.svg";
import { UserRole } from "@/constants/roles";

const token = Astro.cookies.get("access_token")?.value;
if (!token) return Astro.redirect("/");

const payload = JSON.parse(atob(token.split(".")[1]));
const userRole = payload.role as UserRole;
---

<MainLayout title="Dashboard">
  <div class="dashboard-container">
    <Sidebar userRole={userRole} />

    <main class="content-wrapper">
      <div class="dashboard-content">
        <div class="welcome-banner-slot">
          <WelcomeBanner client:only="react" />
        </div>

        <div class="buttons">
          <OptionButton
            backgroundColor="#B797FF"
            titleColor="#513199"
            title="Crear tutor"
          />
          <OptionButton
            backgroundColor="#CDFF8E"
            titleColor="#4D662E"
            title="Analíticas"
          />
          <OptionButton
            backgroundColor="#F7DF94"
            titleColor="#91792E"
            title="Materias"
          />
          <OptionButton
            backgroundColor="#A3A3A3"
            titleColor="#1A1A1A"
            title="Configuración"
          />
          <OptionButton
            backgroundColor="#58D68D"
            titleColor="#12522D"
            title="Gestionar tutores"
          />
        </div>

        <div class="user-header">
          <button class="role-change-button"
            ><Image
              src={RoleChangeIcon}
              alt="Change Role"
              class="role-change-img"
            /></button
          >
          <button class="avatar"><Image src={UserIcon} alt="User" /></button>
        </div>
      </div>
    </main>
  </div>
</MainLayout>

<style>
  .dashboard-container {
    display: flex;
    width: 100vw;
    height: 100%;
    overflow-x: hidden;
    background-color: #f3edff;
  }

  .content-wrapper {
    flex: 1;
    display: flex;
    padding: 18px 20px 20px 0;
    min-width: 0;
  }

  .dashboard-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 16px;
    overflow-y: auto;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
  }

  .welcome-banner-slot {
    min-height: 72px;
  }

  .welcome-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    font-size: 60px;
    font-weight: bold;
    color: #3c3c3c;
  }

  p {
    font-size: 60px;
    font-weight: bold;
    color: #3c3c3c;
  }

  .user-header {
    position: absolute;
    top: 63px;
    right: 70px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .color-change-button {
    background-color: #f5f1ff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 29px;
    height: 29px;
  }

  .avatar {
    width: 60px;
    height: 60px;
    border-radius: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .buttons {
    display: flex;
    gap: 24px;
    margin-top: 40px;
  }
</style>
