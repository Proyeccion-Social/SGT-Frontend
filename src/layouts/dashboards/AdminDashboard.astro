---
import { WelcomeBanner } from "@/features/dashboards/components/WelcomeBanner";
import BannerManager from "@/features/dashboards/components/BannerManager";
---

<main class='content-wrapper'>
  <div class='dashboard-content'>
    <div class='welcome-banner-slot'>
      <WelcomeBanner client:only='react' />
    </div>

    <div class='buttons'>
      <BannerManager client:only='react' />
    </div>
  </div>
</main>

<style>
  .content-wrapper {
    flex: 1;
    display: flex;
    min-width: 0;
  }

  .dashboard-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 32px 0 0 32px;
    border: 1px solid var(--neutral-200);
    overflow-y: auto;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .dashboard-content {
      border-radius: 0;
      justify-content: flex-start;
      padding-top: 8rem; /* Extra space for fixed header */
    }

    .buttons {
      flex-direction: column;
      width: 100%;
      padding: 0 2rem;
      margin-bottom: 2rem;
    }
  }

  .welcome-banner-slot {
    min-height: 72px;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
}
</style>
