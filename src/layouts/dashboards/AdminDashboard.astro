---
import { Image } from "astro:assets";
import { WelcomeBanner } from "@/features/dashboards/components/WelcomeBanner";
import OptionButton from "@/features/dashboards/components/OptionButton.astro";

import RoleChangeIcon from "@/features/dashboards/components/icons/RoleChangeIcon.svg";
import UserIcon from "@/features/dashboards/components/icons/UserIcon.svg";
---

<main class='content-wrapper'>
  <div class='dashboard-content'>
    <div class='welcome-banner-slot'>
      <WelcomeBanner client:only='react' />
    </div>

    <div class='buttons'>
      <OptionButton
        backgroundColor='#B797FF'
        titleColor='#513199'
        title='Crear tutor'
      />
      <OptionButton
        backgroundColor='#CDFF8E'
        titleColor='#4D662E'
        title='Analíticas'
      />
      <OptionButton
        backgroundColor='#F7DF94'
        titleColor='#91792E'
        title='Materias'
      />
      <OptionButton
        backgroundColor='#A3A3A3'
        titleColor='#1A1A1A'
        title='Configuración'
      />
      <OptionButton
        backgroundColor='#58D68D'
        titleColor='#12522D'
        title='Gestionar tutores'
      />
    </div>
  </div>
</main>

<style>
  .content-wrapper {
    flex: 1;
    display: flex;
    min-width: 0;
  }

  .dashboard-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 32px 0 0 32px;
    border: 1px solid var(--neutral-200);
    overflow-y: auto;
    align-items: center;
    justify-content: center;
    padding-top: 72px;
    width: 100%;
    min-height: 100vh;
  }

  @media (max-width: 768px) {
    .dashboard-content {
      border-radius: 0;
      justify-content: flex-start;
      padding-top: 8rem; /* Extra space for fixed header */
    }

    .buttons {
      flex-direction: column;
      width: 100%;
      padding: 0 2rem;
      margin-bottom: 2rem;
    }
  }

  .welcome-banner-slot {
    min-height: 72px;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-top: 40px;
  }
</style>
