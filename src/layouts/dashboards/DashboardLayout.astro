---
import Layout from "@/layouts/Layout.astro";
import Sidebar from "@/features/dashboards/components/Sidebar.astro";
import Dock from "@/features/general/components/Dock.astro";
import VaulDrawer from "@/components/ui/drawer";

import EmailActionController from "@/features/emailScreens/components/EmailActionController";
import { getUserIdFromCookie } from "@/features/auth/utils/authUtils";

import TutorAvailabilityOverlay from "@/features/tutorAvailability/components/TutorAvailabilityOverlay.astro";
import { UserRole } from "@/constants/roles";
import UserHeader from "@/features/general/components/UserHeader.astro";
import NotificationsPanel from "@features/dashboards/components/notifications/NotificationsPanel";
import TutorialInitializer from "@/driverTutorial/TutorialInitializer";

interface Props {
  title?: string;
  rol: UserRole;
}

const { rol, title = "Atlas" } = Astro.props;
const userId = getUserIdFromCookie(Astro.cookies);

---

<Layout title={title} noindex={true}>
  <div class='dashboardContainer'>
    <div>
      <UserHeader userRole={rol} transition:persist  />
    </div>
    <div>
      <Sidebar userRole={rol} transition:persist />
    </div>
    <main class='main-content' id="dashboardMainTUTORIAL">
      <Dock userRole={rol} transition:persist />
      <slot />
    </main>
  </div>
  <NotificationsPanel client:idle transition:persist />
  <!-- <FirstLoginSetup client:idle transition:persist /> -->
  {
    (rol === "tutor" || rol === "student") && (
      <>
        <VaulDrawer client:idle transition:persist />
        {rol === "tutor" && <TutorAvailabilityOverlay />}
      </>
    )
  }
  <EmailActionController client:only='react' userId={userId} />
  <TutorialInitializer client:load />
</Layout>

<style>
  .dashboardContainer {
    display: flex;
    width: 100%;
    height: 100vh;
    background-color: #f3edff;
    box-sizing: border-box;
    overflow-y: hidden;
  }

  .main-content {
    flex: 1;
    overflow-y: auto;
    height: 100dvh;
  }

  @media (max-width: 768px) {
    .dashboardContainer {
      height: 100vh;
      flex-direction: column;
      padding-top: 0;
    }

    .main-content {
      height: 100vh;
      background-color: #fff;
    }

    /* Global overrides to ensure white area has no rounded corners on mobile */
    :global(.content-wrapper),
    :global(.dashboard-content),
    :global(.block-container),
    :global(.search-page),
    :global(.history-layout) {
      border-radius: 0 !important;
      border: none !important;
    }

    /* Hide dock and floating elements when a modal is open */
    :global(body.modal-open .dock),
    :global(body.modal-open .notification-floating) {
      display: none !important;
    }
  }

  /* Hide user header globally when a modal is open (Desktop and Mobile) */
  :global(body.modal-open .user-header) {
    display: none !important;
  }
</style>
