---
import { Image } from "astro:assets";
import MainLayout from '../Layout.astro';
import Sidebar from '../../features/dashboards/components/Sidebar.astro';
import RoleBadge from '../../features/dashboards/components/RoleBadge.astro';
import IncomingSessionsCard from "../../features/dashboards/components/IncomingSessionsCard.astro";
import StatCard from "../../features/dashboards/components/StatCard.astro";
import UserHeader from "../../features/general/components/UserHeader.astro";
import ImageIcon from "../../features/dashboards/components/icons/ImageIcon.svg";

const userName = "Johan"; // Mock user name, replace with actual data in a real application
const userRole = "student";

const mockSessions = [
    {
        id: "1",
        title: "Introducción a derivadas y definición por límite",
        description: "En esta tutoría quiero que me expliquen la regla de la cadena",
        subject: "Cálculo Diferencial",
        status: "Cerrada",
        time: "Hoy 3:00 PM",
        timeLeft: "En 2h",
    },
    {
        id: "2",
        title: "Límites infinitos",
        description: "Revisión de asíntotas verticales y horizontales",
        subject: "Cálculo Diferencial",
        status: "Pendiente",
        time: "Mañana 10:00 AM",
        timeLeft: "En 1d",
    },
];

const studentStats = { value: 3, text: "Tutorías esta semana" };
---
<MainLayout title="Dashboard">
    <div class="dashboard-container">
        <Sidebar userRole={userRole} />

        <main class="content-wrapper">
            <div class="dashboard-content">
                <UserHeader userRole={userRole}/>

                <div class="welcome-container">
                    <p>¡Bienvenid@ <RoleBadge name={userName} role={userRole} />!</p>
                </div>

                <div class="cards-container">
                    <div class="left-side">
                        <div class="incoming-sessions-container">
                            <IncomingSessionsCard sessions={mockSessions} role={userRole} />
                        </div>

                        <div class="green-photo-space">
                            <Image src={ImageIcon} alt="Image" />
                        </div>
                    </div>
                    <div class="stats-container">
                        <StatCard value={studentStats.value} description={studentStats.text} />
                    </div>
                </div>
                
            </div>
        </main>
        
    </div>
</MainLayout>

<style>
    .dashboard-container {
        display: flex;
        width: 100%;
        height: 100vh;
        background-color: #f3edff;
        padding: 18px 20px 20px 0;
        box-sizing: border-box;
    }

    .content-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        background-color: #fff;
        border-radius: 16px;
        position: relative;
        justify-content: flex-start;
        overflow: hidden;
        overflow-y: auto;
        clip-path: inset(0 0 0 0 round 16px);
    }

    .content-wrapper::-webkit-scrollbar {
        width: 6px;
    }
    
    .content-wrapper::-webkit-scrollbar-thumb {
        background: #e8e8e8;
        border-radius: 10px;
    }

    .dashboard-content {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 1.5rem;
        box-sizing: border-box;
        padding-top: 0.5rem;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
    }

    .welcome-container {
        display: flex;
        flex-direction: row;
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: bold;
        flex-shrink: 0;
        padding: 0 10rem;
        color: #3c3c3c;
    }

    

    .cards-container {
        display: grid;
        grid-template-columns: 64fr 36fr;
        gap: clamp(15px, 3vw, 40px);
        margin: 0 10rem;
        width: auto;
        align-items: start;
        min-height: 0;
        height: auto;
        margin-bottom: 2rem;
    }

    .left-side {
        display: flex;
        flex-direction: column;
        gap: clamp(15px, 3vw, 40px);
    }

    .green-photo-space {
        background-color: #cdff8e;
        border-radius: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 280px;
        width: 100%;
    }
</style>