---
import { Image } from "astro:assets";
import { jwtDecode } from "jwt-decode";
import MainLayout from "../Layout.astro";
import Sidebar from "../../features/dashboards/components/Sidebar.astro";
import DashboardSessionManager from "@/features/dashboards/components/DashboardSessionManager";
import StatCard from "@/features/dashboards/components/StatCard";
import ImageIcon from "../../features/dashboards/components/icons/ImageIcon.svg";
import { WelcomeBanner } from "@/features/dashboards/components/WelcomeBanner";
import DashboardLoader from "@/features/dashboards/components/DashboardLoader";
import { UserRole } from "@/constants/roles";

const userRole = UserRole.STUDENT;
---

<main class='content-wrapper'>
  <DashboardLoader role={userRole} client:only='react' />
  <div class='dashboard-content'>

    <div class='welcome-banner-slot'>
      <WelcomeBanner client:only='react' />
    </div>

    <div class='cards-container'>
      <div class='left-side'>
        <div class='incoming-sessions-container' id="DashboardManagerTUTORIAL">
          <DashboardSessionManager role={userRole} client:only='react' />
        </div>

        <div class='stats-container'>
          <StatCard type='student' client:only='react' />
        </div>
      </div>

      <div class='green-photo-space'>
        <Image src={ImageIcon} alt='Image' />
      </div>
    </div>
  </div>
</main>

<style>
  .dashboard-container {
    display: flex;
    width: 100%;
    height: 100vh;
    background-color: #f3edff;
    box-sizing: border-box;
    overflow-y: hidden;
  }

  .content-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 32px 0px 0px 32px;
    position: relative;
    justify-content: flex-start;
    overflow: hidden;
    overflow-y: auto;
    border: 1px solid var(--neutral-200);
    height: 100%;
  }

  @media (max-width: 768px) {
    .content-wrapper {
      border-radius: 0;
      border: none;
    }
  }

  .content-wrapper::-webkit-scrollbar {
    width: 6px;
  }

  .content-wrapper::-webkit-scrollbar-thumb {
    background: #e8e8e8;
    border-radius: 10px;
  }

  .dashboard-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 1.5rem;
    box-sizing: border-box;
    padding-top: 72px;
  }

  @media (max-width: 768px) {
    .dashboard-content {
      padding-top: 8rem; /* Extra space for fixed header on mobile */
      margin-top: 0;
    }
  }

  .welcome-banner-slot {
    min-height: 72px;
  }

  .welcome-container {
    display: flex;
    flex-direction: row;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: bold;
    flex-shrink: 0;
    padding: 0 10rem;
    color: #3c3c3c;
  }

  .cards-container {
    display: flex;
    flex-direction: column;
    gap: clamp(15px, 3vw, 40px);
    margin: 0 10rem;
    width: auto;
    align-items: start;
    min-height: 0;
    height: auto;
    margin-bottom: 2rem;
  }

  @media (max-width: 1024px) {
    .cards-container {
      margin: 0 2rem;
    }
  }

  @media (max-width: 768px) {
    .cards-container {
      margin: 0 1rem;
      gap: 1.5rem;
    }
  }

  .left-side {
    display: flex;
    flex-direction: row;
    gap: 40px;
    width: 100%;
  }

  @media (max-width: 768px) {
    .left-side {
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  .incoming-sessions-container {
    width: 100%;
  }

  .green-photo-space {
    background-color: #cdff8e;
    border-radius: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 280px;
    width: 100%;
  }

  @media (max-width: 768px) {
    .green-photo-space {
      height: 200px;
    }
  }
</style>
