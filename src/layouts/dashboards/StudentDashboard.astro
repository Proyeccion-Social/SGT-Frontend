---
import { Image } from "astro:assets";
import MainLayout from '../Layout.astro';
import Sidebar from '../../features/dashboards/components/Sidebar.astro';
import ColorChangeIcon from "../../features/dashboards/components/icons/ColorChangeIcon.svg";
import UserIcon from "../../features/dashboards/components/icons/UserIcon.svg";
import RoleBadge from '../../features/dashboards/components/RoleBadge.astro';

const userName = "Johan"; // Mock user name, replace with actual data in a real application
const userRole = "student";
---
<MainLayout title="Dashboard">
    <div class="dashboard-container">
        <Sidebar userRole={userRole} />

        <main class="content-wrapper">
            <div class="dashboard-content">
                <div class="welcome-container">
                    <p>¡Bienvenid@ <RoleBadge name={userName} role={userRole} />!</p>
                </div>

                <div class="user-header">
                    <button class="color-change-button"><Image src={ColorChangeIcon} alt="Change Color" class="color-change-img"/></button>
                    <button class="avatar"><Image src={UserIcon} alt="User" /></button>
                </div>
            </div>
        </main>
        
    </div>
</MainLayout>

<style>
    .dashboard-container {
        display: flex;
        width: 100%;
        background-color: #F5F1FF;
    }

    .content-wrapper {
        flex: 1;
        display: flex;
        padding: 18px 20px 20px 0;
    }
    
    .dashboard-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        background-color: #fff;
        border-radius: 16px;
        overflow-y: auto;
        align-items: center;
        justify-content: center;
    }
    
    .welcome-container {
        display: flex;
        flex-direction: row;
        font-size: 60px;
        font-weight: bold;
        color: #3C3C3C;
        position: absolute;
        left: 242px;
        top: 164px;
    }

    p {
        font-size: 60px;
        font-weight: bold;
        color: #3C3C3C;
    }

    .user-header {
        position: absolute;
        top: 63px;
        right: 70px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .color-change-button {
        background-color: #F5F1FF;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 29px;
        height: 29px;
    }

    .avatar {
        width: 60px;
        height: 60px;
        border-radius: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .buttons {
        display: flex;
        gap: 24px;
        margin-top: 40px;
    }
</style>