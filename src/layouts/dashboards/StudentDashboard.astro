---
import { Image } from "astro:assets";
import MainLayout from '../Layout.astro';
import Sidebar from '../../features/dashboards/components/Sidebar.astro';
import UserIcon from "../../features/dashboards/components/icons/UserIcon.svg";
import RoleBadge from '../../features/dashboards/components/RoleBadge.astro';
import IncomingSessionsCard from "../../features/dashboards/components/IncomingSessionsCard.astro";
import StatCard from "../../features/dashboards/components/StatCard.astro";
import ImageIcon from "../../features/dashboards/components/icons/ImageIcon.svg";

const userName = "Johan"; // Mock user name, replace with actual data in a real application
const userRole = "student";

const mockSessions = [
  {
    id: "1",
    title: "Introducción a derivadas y definición por límite",
    description: "En esta tutoría quiero que me expliquen la regla de la cadena",
    subject: "Cálculo Diferencial",
    status: "Cerrada",
    time: "Hoy 3:00 PM",
    timeLeft: "En 2h"
  },
  {
    id: "2",
    title: "Límites infinitos",
    description: "Revisión de asíntotas verticales y horizontales",
    subject: "Cálculo Diferencial",
    status: "Pendiente",
    time: "Mañana 10:00 AM",
    timeLeft: "En 1d"
  }
];

const studentStats = { value: 3, text: "Tutorías esta semana" };
---
<MainLayout title="Dashboard">
    <div class="dashboard-container">
        <Sidebar userRole={userRole} />

        <div class="user-header">
            <button class="avatar"><Image src={UserIcon} alt="User" /></button>
        </div>

        <main class="content-wrapper">
            <div class="dashboard-content">
                <div class="welcome-container">
                    <p>¡Bienvenid@ <RoleBadge name={userName} role={userRole} />!</p>
                </div>

                <div class="cards-container">
                    <div class="left-side">
                        <div class="incoming-sessions-container">
                            <IncomingSessionsCard sessions={mockSessions} role={userRole} />
                        </div>

                        <div class="green-photo-space">
                            <Image src={ImageIcon} alt="Image" />
                        </div>
                    </div>
                    <div class="stats-container">
                        <StatCard value={studentStats.value} description={studentStats.text} />
                    </div>
                </div>
                
            </div>
        </main>
        
    </div>
</MainLayout>

<style>
    .dashboard-container {
        display: flex;
        width: 100%;
        height: 100%;
        background-color: #F5F1FF;
        padding: 18px 20px 20px 0;
    }

    .content-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        background-color: #fff;
        border-radius: 16px;
        overflow-y: auto;
        align-items: center;
        justify-content: center;
    }
    
    .dashboard-content {
        width: 100%;
        height: 100%;
        padding: 0 142px;
        box-sizing: border-box;
    }
    
    .welcome-container {
        display: flex;
        flex-direction: row;
        font-size: 60px;
        font-weight: bold;
        color: #3C3C3C;
        margin-top: 146px;
    }

    p {
        font-size: 60px;
        font-weight: bold;
        color: #3C3C3C;
    }

    .user-header {
        position: absolute;
        top: 63px;
        right: 70px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar {
        width: 60px;
        height: 60px;
        border-radius: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .cards-container {
        display: flex;
        flex-direction: row;
        gap: 40px;
        margin-top: 25px;
        width: 100%;
        height: auto;
    }

    .left-side {
        display: flex;
        flex-direction: column;
        gap: 40px;
        flex: 1;
    }

    .green-photo-space {
        background-color: #CDFF8E;
        border-radius: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 280px;
    }

    .cards-container > div {
        flex: 1;
    }

    .cards-container > .incoming-sessions-container {
        flex: 0 0 64%;
    }

    .cards-container > .green-photo-space {
        flex: 0 0 64%;
    }

    .cards-container > .stats-container {
        flex: 0 0 33.2%;
    }
</style>