---
import { WelcomeBanner } from "@/features/dashboards/components/WelcomeBanner";

import DashboardSessionManager from "@/features/dashboards/components/DashboardSessionManager";
import StatCard from "@/features/dashboards/components/StatCard";
import { TutorAvailabilityManager } from "@/features/dashboards/components/TutorAvailabilityManager";
import DashboardLoader from "@/features/dashboards/components/DashboardLoader";
import { UserRole } from "@/constants/roles";

const userRole = UserRole.TUTOR;
---

<main class='content-wrapper'>
  <DashboardLoader role={userRole} client:only='react' />
  <div class='dashboard-content'>

    <div class='welcome-banner-slot'>
      <WelcomeBanner client:only='react' />
    </div>

    <div class='hours-bar'>
      <TutorAvailabilityManager client:only='react' />
    </div>
    
    <div class='cards-container'>
      <div class='incoming-sessions-container' id="DashboardManagerTUTORIAL">
        <DashboardSessionManager role={userRole} client:only='react' />
      </div>

      <div class='stats-container'>
        <StatCard type='tutor' client:only='react' />
      </div>
    </div>
  </div>
</main>

<style>
  .content-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 32px 0px 0px 32px;
    border: 1px solid var(--neutral-200);
    position: relative;
    justify-content: flex-start;
    overflow-x: hidden;
    overflow-y: auto;
    height: 100%;
  }

  .incoming-sessions-container {
    min-width: 0;
  }

  .stats-container {
    width: 100%;
  }

  @media (max-width: 768px) {
    .content-wrapper {
      border-radius: 0;
      border: none;
    }
  }

  .content-wrapper::-webkit-scrollbar {
    width: 6px;
    height: 100px;
  }

  .content-wrapper::-webkit-scrollbar-thumb {
    background: #e7dcff;
    border-radius: 10px;
  }

  .dashboard-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 1.5rem;
    box-sizing: border-box;
    padding-top: 96px;
  }

  @media (max-width: 768px) {
    .dashboard-content {
      padding: 8rem 8px; /* Extra space for fixed header on mobile */
      margin-top: 0;
    }
  }

  .welcome-banner-slot {
    min-height: 72px;
  }

  .hours-bar {
    display: flex;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    margin: 0 clamp(1rem,12vw,10rem);
    width: auto;
  }

  @media (max-width: 1024px) {
    .hours-bar {
      margin: 0 clamp(1rem, 3vw, 2rem);
    }
  }

  @media (max-width: 768px) {
    .hours-bar {
      margin: 0 1rem;
    }
  }

  .hours-segment {
    display: flex;
    align-items: center;
    padding-left: 2rem;
    transition: width 0.4s ease;
  }

  .scheduled-hours-text {
    color: #4d662e;
    font-weight: 400;
    font-size: 20px;
  }

  .remaining-hours-text {
    color: #513199;
    font-weight: 400;
    font-size: 20px;
  }

  .cards-container {
    display: grid;
    grid-template-columns: 64fr 36fr;
    gap: clamp(15px, 3vw, 40px);
    padding: 0 clamp(1rem, 12vw, 10rem);
    width: 100%;
    box-sizing: border-box;
    align-items: start;
    min-height: 0;
    height: auto;
    margin-bottom: 2rem;
  }

  @media (max-width: 1024px) {
    .cards-container {
      padding: 0 clamp(1rem, 3vw, 2rem);
    }
  }

  @media (max-width: 768px) {
    .cards-container {
      grid-template-columns: 1fr;
      padding: 0 1rem;
      gap: 1.5rem;
    }
  }
</style>
