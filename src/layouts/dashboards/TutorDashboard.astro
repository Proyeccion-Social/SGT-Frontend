---
import { Image } from "astro:assets";
import MainLayout from '../Layout.astro';
import Sidebar from '../../features/dashboards/components/Sidebar.astro';
import RoleChangeIcon from "../../features/dashboards/components/icons/RoleChangeIcon.svg";
import UserIcon from "../../features/dashboards/components/icons/UserIcon.svg";
import RoleBadge from '../../features/dashboards/components/RoleBadge.astro';
import IncomingSessionsCard from "../../features/dashboards/components/IncomingSessionsCard.astro";
import StatCard from "../../features/dashboards/components/StatCard.astro";

const token = Astro.cookies.get("access_token")?.value;
if (!token) return Astro.redirect("/");

const payload = JSON.parse(atob(token.split(".")[1]));
const userName: string = payload.name;
const userRole = payload.role.toLowerCase() as 'admin' | 'tutor' | 'student';

const mockSessions = [
  {
    id: "1",
    title: "Introducción a derivadas y definición por límite",
    description: "En esta tutoría quiero que me expliquen la regla de la cadena",
    subject: "Cálculo Diferencial",
    status: "Cerrada",
    time: "Hoy 3:00 PM",
    timeLeft: "En 2h"
  },
  {
    id: "2",
    title: "Límites infinitos",
    description: "Revisión de asíntotas verticales y horizontales",
    subject: "Cálculo Diferencial",
    status: "Pendiente",
    time: "Mañana 10:00 AM",
    timeLeft: "En 1d"
  }
];

const tutorStats = { value: 20, text: "Estudiantes alcanzados" };
const mockWorkload = {
  scheduledHours: 2,
  weeklyLimit: 8,
};
const remainingHours = mockWorkload.weeklyLimit - mockWorkload.scheduledHours;
const usedPercent = Math.min((mockWorkload.scheduledHours / mockWorkload.weeklyLimit) * 100, 100);
---
<MainLayout title="Dashboard">
    <div class="dashboard-container">
        <Sidebar userRole={userRole} />

        <main class="content-wrapper">
            <div class="dashboard-content">
                        
                <div class="user-header">
                    <button class="role-change-button"><Image src={RoleChangeIcon} alt="Change Color" class="role-change-img"/></button>
                    <button class="avatar"><Image src={UserIcon} alt="User" /></button>
                </div>

                <div class="welcome-container">
                    <p>¡Bienvenid@ <RoleBadge name={userName} role={userRole} />!</p>
                </div>

                <div class="hours-bar">
                    <div class="hours-segment hours-scheduled" style={`width: ${usedPercent}%; background-color: #DAFFAA;`}>
                        <span class="scheduled-hours-text">{mockWorkload.scheduledHours} hora{mockWorkload.scheduledHours !== 1 ? "s" : ""} agendada{mockWorkload.scheduledHours !== 1 ? "s" : ""} esta semana</span>
                    </div>
                    <div class="hours-segment hours-remaining" style={`width: ${100 - usedPercent}%; background-color: #CFB9FF;`}>
                        <span class="remaining-hours-text">{remainingHours} hora{remainingHours !== 1 ? "s" : ""} restantes esta semana</span>
                    </div>
                </div>

                <div class="cards-container">
                    <div class="incoming-sessions-container">
                        <IncomingSessionsCard sessions={mockSessions} role={userRole as 'tutor' | 'student'} />
                    </div>

                    <div class="stats-container">
                        <StatCard value={tutorStats.value} description={tutorStats.text} />
                    </div>
                </div>
            </div>
        </main>
    </div>
</MainLayout>
