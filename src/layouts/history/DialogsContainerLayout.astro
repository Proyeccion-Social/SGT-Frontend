<div class="dialogs-layout">
  <div class="dialogs-backdrop" aria-hidden="true"></div>

  <slot name="dialog-one" />
  <slot name="dialog-two" />
</div>

<style is:global>
  .dialogs-layout {
    position: fixed;
    inset: 0;
    z-index: 99998;
    pointer-events: none;
  }

  .dialogs-layout.active {
    pointer-events: auto;
  }

  .dialogs-layout .dialogs-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease-out, visibility 0.2s ease-out;
    z-index: 99998;
  }

  .dialogs-layout .dialogs-backdrop.visible {
    opacity: 1;
    visibility: visible;
  }

  .dialogs-layout dialog::backdrop {
    background: transparent;
  }

  .dialogs-layout dialog {
    z-index: 99999;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const containers = document.querySelectorAll<HTMLElement>(".dialogs-layout");

    containers.forEach((container) => {
      const containerEl = container as HTMLElement;
      if (containerEl.dataset.backdropInitialized === "true") return;
      containerEl.dataset.backdropInitialized = "true";

      const backdrop = containerEl.querySelector(".dialogs-backdrop") as HTMLElement | null;
      if (!backdrop) return;

      let isSwitching = false;

      const applyEnteringFromSwitch = () => {
        const openDialog = Array.from(containerEl.querySelectorAll("dialog")).find(
          (dialog) => (dialog as HTMLDialogElement).open,
        ) as HTMLDialogElement | undefined;

        if (!openDialog) return;

        openDialog.classList.add("entering-from-switch");
        window.requestAnimationFrame(() => {
          openDialog.classList.remove("entering-from-switch");
        });

        isSwitching = false;
        syncBackdrop();
      };

      const syncBackdrop = () => {
        const hasOpenDialog = Array.from(containerEl.querySelectorAll("dialog")).some((dialog) =>
          (dialog as HTMLDialogElement).open,
        );
        const shouldShowBackdrop = hasOpenDialog || isSwitching;
        backdrop.classList.toggle("visible", shouldShowBackdrop);
        containerEl.classList.toggle("active", shouldShowBackdrop);
      };

      const observer = new MutationObserver(() => {
        syncBackdrop();
        if (isSwitching) {
          applyEnteringFromSwitch();
        }
      });

      observer.observe(containerEl, {
        subtree: true,
        childList: true,
        attributes: true,
        attributeFilter: ["open"],
      });

      const handleLifecycle = (event: Event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;
        if (!containerEl.contains(target)) return;
        syncBackdrop();
      };

      const handleSwitch = (event: Event) => {
        const customEvent = event as CustomEvent<{ active?: boolean }>;
        isSwitching = Boolean(customEvent.detail?.active);
        syncBackdrop();
      };

      const handleOpenEvaluation = () => {
        isSwitching = true;
        syncBackdrop();
      };

      document.addEventListener("close", handleLifecycle, true);
      document.addEventListener("cancel", handleLifecycle, true);
      window.addEventListener("history-dialog-switch", handleSwitch as EventListener);
      window.addEventListener("open-evaluation-dialog", handleOpenEvaluation);

      syncBackdrop();
    });
  });
</script>
