---
interface Props {
  dialogId: string;
  dialogClass: string;
}

const { dialogId, dialogClass } = Astro.props;
---

<dialog id={dialogId} class={`historyDialog ${dialogClass}`}>
  <div class="dialogContent">
    <slot />
  </div>
</dialog>

<style>
  .historyDialog {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease-out, visibility 0.2s ease-out;
  }

  .historyDialog[open] {
    opacity: 1;
    visibility: visible;
  }

  .historyDialog::backdrop {
    display: none;
  }

  .dialogContent {
    width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
    transform: scale(0.95) translateY(10px);
    opacity: 0;
    transition: transform 0.25s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.2s ease-out;
  }

  .historyDialog[open] .dialogContent {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .historyDialog.dialog-closing {
    opacity: 0;
  }

  .historyDialog.dialog-closing .dialogContent {
    transform: scale(0.95) translateY(10px);
    opacity: 0;
  }

  .historyDialog.switching .dialogContent {
    transform: scale(0.98) translateX(-20px);
    opacity: 0;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease-out;
  }

  .historyDialog.entering-from-switch .dialogContent {
    transform: scale(0.98) translateX(20px);
    opacity: 0;
  }

  .historyDialog.entering-from-switch[open] .dialogContent {
    transform: scale(1) translateX(0);
    opacity: 1;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const dialogs = document.querySelectorAll<HTMLDialogElement>(".historyDialog");

    dialogs.forEach((dialog) => {
      if (dialog.dataset.transitionInitialized === "true") return;
      dialog.dataset.transitionInitialized = "true";

      const DIALOG_TRANSITION_MS = 170;

      const closeWithTransition = () => {
        if (!dialog.open || dialog.dataset.closing === "true") return;

        dialog.dataset.closing = "true";
        dialog.classList.add("dialog-closing");

        window.setTimeout(() => {
          dialog.close();
          dialog.classList.remove("dialog-closing");
          dialog.dataset.closing = "false";
        }, DIALOG_TRANSITION_MS);
      };

      const handleCloseRequest = () => {
        closeWithTransition();
      };

      const handleCancel = (event: Event) => {
        event.preventDefault();
        closeWithTransition();
      };

      dialog.addEventListener("close-request", handleCloseRequest as EventListener);
      dialog.addEventListener("cancel", handleCancel);
    });
  });
</script>
