---
import MainLayout from "../../layouts/Layout.astro";
import Sidebar from "../../features/dashboards/components/Sidebar.astro";
import WeeklyCalendar from "../../features/availability/components/Calendar.astro";
import SchedulingWizard from "../../features/sessions/components/SchedulingWizard";
import { getAllTutorSlotsSSR } from "../../features/availability/services/availabilityService";
import type { Slot } from "../../features/availability/services/availabilityService";
import { Image } from "astro:assets";
import UserIcon from "../../features/dashboards/components/icons/UserIcon.svg";

const token = Astro.cookies.get("access_token")?.value!;
const payload = JSON.parse(atob(token.split(".")[1]));
const userRole = payload.role.toLowerCase() as "admin" | "tutor" | "student";

const slots = await getAllTutorSlotsSSR({ onlyAvailable: true }).catch(() => []);

const today = new Date();
const startOfWeek = new Date(today);
startOfWeek.setDate(today.getDate() - today.getDay() + 1);
const endOfWeek = new Date(startOfWeek);
endOfWeek.setDate(startOfWeek.getDate() + 5);

const formatDay = (date: Date) =>
  date.toLocaleDateString("es-CO", { day: "2-digit", month: "long" });
---

<MainLayout title="Agendamiento">
  <div class="dashboard-container">
    <Sidebar userRole={userRole} />

    <main class="content-wrapper">
      <div class="dashboard-content">

        <!-- Encabezado fijo (no scrollea) -->
        <div class="schedule-header">
          <div class="header-left">
            <div class="header-title">
              <h1>Tu Semana</h1>
              <span class="date-range">
                {formatDay(startOfWeek)} - {formatDay(endOfWeek)}
              </span>
            </div>
            <span class="badge">Espacios disponibles para tutoría</span>
          </div>
          <button class="avatar">
            <Image src={UserIcon} alt="User" />
          </button>
        </div>

        <!-- Área scrolleable solo vertical — igual que .calendar-container en el layout de tutor -->
        <div class="calendar-scroll-area">
          <WeeklyCalendar slots={slots} mode="student" />
        </div>

        <SchedulingWizard client:only="react" slots={slots} token={token} />
      </div>
    </main>
  </div>
</MainLayout>

<style>
  @import "@/styles/variables.css";

  /* ── Contenedor raíz ── */
  .dashboard-container {
    display: flex;
    width: 100vw;
    height: 100vh;        /* altura fija — igual que availability-container */
    background-color: #f3edff;
    box-sizing: border-box;
    overflow: hidden;     /* contención total, sin scroll en el root */
  }

  /* ── Columna derecha ── */
  .content-wrapper {
    flex: 1;
    display: flex;
    padding: 19px 20px 20px 0;
    min-width: 0;
    overflow: hidden;     /* punto de contención — igual que en layout de tutor */
  }

  /* ── Panel blanco ── */
  .dashboard-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 16px;
    overflow: hidden;     /* contiene el calendario — NO overflow-y: auto aquí */
    min-width: 0;
  }

  /* ── Encabezado (sticky, no scrollea) ── */
  .schedule-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    padding: 24px 32px 16px 32px;
    box-sizing: border-box;
    flex-shrink: 0;       /* nunca se comprime */
    border-bottom: 1px solid #e7dcff;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .header-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .header-title h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-moradops-400);
    margin: 0;
  }

  .date-range {
    font-size: 14px;
    color: #6b7280;
    font-weight: 400;
  }

  .badge {
    display: inline-block;
    background-color: #E2D5FF;
    color: #3C3C3C;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .avatar {
    width: 60px;
    height: 60px;
    border-radius: 100%;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* ── Área del calendario — scroll solo vertical, igual que .calendar-container ── */
  .calendar-scroll-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;   /* bloquea scroll horizontal aquí adentro */
    min-width: 0;
  }

  .calendar-scroll-area::-webkit-scrollbar {
    width: 6px;
  }

  .calendar-scroll-area::-webkit-scrollbar-thumb {
    background: #e7dcff;
    border-radius: 10px;
  }
</style>