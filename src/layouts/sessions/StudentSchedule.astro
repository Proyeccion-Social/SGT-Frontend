---
import MainLayout from "../../layouts/Layout.astro";
import Sidebar from "../../features/dashboards/components/Sidebar.astro";
import WeeklyCalendar from "../../features/availability/components/Calendar.astro";
import SchedulingWizard from "../../features/sessions/components/SchedulingWizard";
import { getWeekRangeFromOffset } from "../../features/availability/utils/dateUtils";
import { getAllTutorSlotsSSR } from "../../features/availability/services/availabilityService";
import type { Slot } from "../../features/availability/services/availabilityService";
import { Image } from "astro:assets";
import UserIcon from "../../features/dashboards/components/icons/UserIcon.svg";

const token = Astro.cookies.get("access_token")?.value!;
const payload = JSON.parse(atob(token.split(".")[1]));
const userRole = payload.role.toLowerCase() as "admin" | "tutor" | "student";

// Leer offset desde query params — igual que la vista del tutor
const offsetParam = Astro.url.searchParams.get("offset");
const weekOffset = offsetParam ? parseInt(offsetParam, 10) : 0;

const { monday, weekRangeStr, prevOffset, nextOffset } = getWeekRangeFromOffset(weekOffset);

const slots = await getAllTutorSlotsSSR({ onlyAvailable: true }).catch(() => []);
---

<MainLayout title="Agendamiento">
  <div class="dashboard-container">
    <Sidebar userRole={userRole} />

    <main class="content-wrapper">
      <div class="dashboard-content">

        <div class="schedule-header">
          <div class="header-left">
            <div class="header-title">
              <h1>Tu Semana</h1>
              <!-- Navegación de semanas -->
              <div class="week-nav">
                {weekOffset > 0 ? (
                  <a href={`?offset=${prevOffset}`} class="week-nav__arrow" aria-label="Semana anterior">
                    &#8592;
                  </a>
                ) : (
                  <span class="week-nav__arrow week-nav__arrow--disabled">&#8592;</span>
                )}
                <span class="date-range">{weekRangeStr}</span>
                {weekOffset < 1 ? (
                  <a href={`?offset=${nextOffset}`} class="week-nav__arrow" aria-label="Semana siguiente">
                    &#8594;
                  </a>
                ) : (
                  <span class="week-nav__arrow week-nav__arrow--disabled">&#8594;</span>
                )}
              </div>
            </div>
            <span class="badge">Espacios disponibles para tutoría</span>
          </div>
          <button class="avatar">
            <Image src={UserIcon} alt="User" />
          </button>
        </div>

        <div class="calendar-scroll-area">
          <!-- Pasar monday como baseDate para que el calendario muestre la semana correcta -->
          <WeeklyCalendar slots={slots} mode="student" baseDate={monday} />
        </div>

        <SchedulingWizard client:only="react" slots={slots} />
      </div>
    </main>
  </div>
</MainLayout>

<style>
  @import "@/styles/variables.css";

  /* ── Contenedor raíz ── */
  .dashboard-container {
    display: flex;
    width: 100vw;
    height: 100vh;        /* altura fija — igual que availability-container */
    background-color: #f3edff;
    box-sizing: border-box;
    overflow: hidden;     /* contención total, sin scroll en el root */
  }

  .week-nav__arrow--disabled {
  opacity: 0.3;
  cursor: not-allowed;
  pointer-events: none;
}

  .week-nav {
  display: flex;
  align-items: center;
  gap: 12px;
}

.week-nav__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: #f3edff;
  color: var(--color-moradops-400);
  text-decoration: none;
  font-size: 16px;
  font-weight: 600;
  transition: background 0.15s ease;
}

.week-nav__arrow:hover {
  background: #e9d5ff;
}

  /* ── Columna derecha ── */
  .content-wrapper {
    flex: 1;
    display: flex;
    padding: 19px 20px 20px 0;
    min-width: 0;
    overflow: hidden;     /* punto de contención — igual que en layout de tutor */
  }

  /* ── Panel blanco ── */
  .dashboard-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #fff;
    border-radius: 16px;
    overflow: hidden;     /* contiene el calendario — NO overflow-y: auto aquí */
    min-width: 0;
  }

  /* ── Encabezado (sticky, no scrollea) ── */
  .schedule-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    padding: 40px 50px 40px 50px;
    box-sizing: border-box;
    flex-shrink: 0;       /* nunca se comprime */
    border-bottom: 1px solid #e7dcff;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .header-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .header-title h1 {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-moradops-400);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .date-range {
    font-size: 14px;
    color: #6b7280;
    font-weight: 400;
  }

  .badge {
    display: inline-block;
    background-color: #E2D5FF;
    width: fit-content;
    color: #3C3C3C;
    font-size: 13px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .avatar {
    width: 60px;
    height: 60px;
    border-radius: 100%;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* ── Área del calendario — scroll solo vertical, igual que .calendar-container ── */
  .calendar-scroll-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;   /* bloquea scroll horizontal aquí adentro */
    min-width: 0;
  }

  .calendar-scroll-area::-webkit-scrollbar {
    width: 6px;
  }

  .calendar-scroll-area::-webkit-scrollbar-thumb {
    background: #e7dcff;
    border-radius: 10px;
  }
</style>