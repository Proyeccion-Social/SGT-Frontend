import ForgotPasswordCard from "@/features/auth/components/ForgotPasswordCard.astro";
import ForgotPasswordHeader from "@/features/auth/components/ForgotPasswordHeader.astro";
import ForgotPasswordForm from "@/features/auth/components/ForgotPasswordForm.astro";
---

<Layout title='Login Page'>
  <LoginCard>
    <LoginHeader />
    <LoginForm />
  </LoginCard>

  <ForgotPasswordCard>
    <ForgotPasswordHeader />
    <ForgotPasswordForm />
  </ForgotPasswordCard>
</Layout>
