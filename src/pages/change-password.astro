---
import Layout from "@/layouts/Layout.astro";
import ChangePassword from "@/features/auth/components/ChangePassword.astro";
import { fetchMe } from "@/features/auth/services/authService";

const token = Astro.cookies.get("access_token")?.value;

if (!token) {
  return Astro.redirect("/?session=expired");
}

let requiresPasswordChange = false;
try {
  const me = await fetchMe(token);
  requiresPasswordChange = me.requiresPasswordChange ?? false;
} catch {
  return Astro.redirect("/?session=expired");
}

if (!requiresPasswordChange) {
  return Astro.redirect("/dashboard");
}
---

<Layout title='Cambiar contraseña'>
  <ChangePassword />
</Layout>
