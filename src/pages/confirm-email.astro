---
import { Image } from "astro:assets";
import icon from "@/features/auth/assets/imgs/icon.svg";
import ConfirmEmailForm from "@/features/emailScreens/components/ConfirmEmailForm";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Confirmar Correo">
  <div class='containerConfirmEmail'>
    <section class='leftSideContainer'>
      <ConfirmEmailForm client:load />
    </section>
    <section class='rightSideContainer'>
      <Image src={icon} alt='Atlas' class='iconAtlas' />
    </section>
  </div>
</Layout>

<style>
  .containerConfirmEmail {
    display: flex;
    width: 100%;
    height: 100vh;
    padding: 24px;
    gap: 24px;
  }

  .leftSideContainer {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: 1px solid #C6C6C6;
    border-radius: 24px;
    padding: 40px;
    position: relative;
    background: white;
  }

  .rightSideContainer {
    flex: 1;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(180deg, #8751FF 0%, #E7DCFF 100%);
  }

  .iconAtlas {
    position: absolute;
    bottom: -310px;
    right: -200px;
    height: 900px;
    width: 900px;
    transform: rotate(-22.83deg);
  }
</style>
