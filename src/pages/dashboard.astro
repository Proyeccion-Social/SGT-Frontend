---
//Imports 
import AdminLayout from '../layouts/dashboards/AdminDashboard.astro'
import StudentLayout from '../layouts/dashboards/StudentDashboard.astro'
import TutorLayout from '../layouts/dashboards/TutorDashboard.astro'

//Mock user role, in a real application this would come from authentication context
const userRole = 'tutor'; // Change this to 'student' or 'tutor' to test different layouts

//UserRole information space 
---

{userRole === 'admin' && (
  <AdminLayout title="Admin Dashboard"/>
)}

{userRole === 'student' && (
  <StudentLayout title="Student Dashboard"/>
)}

{userRole === 'tutor' && (
  <TutorLayout title="Tutor Dashboard"/>
)}

