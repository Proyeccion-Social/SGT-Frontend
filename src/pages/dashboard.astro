---
import AdminDashboard from "../layouts/dashboards/AdminDashboard.astro";
import StudentDashboard from "../layouts/dashboards/StudentDashboard.astro";
import TutorDashboard from "../layouts/dashboards/TutorDashboard.astro";

export const prerender = false;

const token = Astro.cookies.get("access_token")?.value;

if (!token) {
  return Astro.redirect("/");
}

const payload = JSON.parse(atob(token.split(".")[1]));
const userRole = payload.role; // 'ADMIN', 'TUTOR', 'STUDENT'
---

{userRole === "ADMIN" && <AdminDashboard title="Admin Dashboard" />}
{userRole === "TUTOR" && <TutorDashboard title="Tutor Dashboard" />}
{userRole === "STUDENT" && <StudentDashboard title="Student Dashboard" />}
