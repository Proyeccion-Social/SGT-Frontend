---
export const prerender = false;
//Imports
import AdminLayout from "../layouts/dashboards/AdminDashboard.astro";
import StudentLayout from "../layouts/dashboards/StudentDashboard.astro";
import TutorLayout from "../layouts/dashboards/TutorDashboard.astro";
import { jwtDecode } from "jwt-decode";

// Auth guard: redirect unauthenticated users to home page
const token = Astro.cookies.get("access_token")?.value;
if (!token) {
  return Astro.redirect("/");
}

let userRole: string = "tutor";
try {
  const decoded = jwtDecode(token) as any;
  userRole = decoded.role ? decoded.role.toLowerCase() : "tutor";
} catch (e) {
  console.error("Error decoding token in dashboard:", e);
  return Astro.redirect("/");
}
---

{userRole === "admin" && <AdminLayout title="Dashboard" />}

{userRole === "student" && <StudentLayout title="Dashboard" />}

{userRole === "tutor" && <TutorLayout title="Dashboard" />}
