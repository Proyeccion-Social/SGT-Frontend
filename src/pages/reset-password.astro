---
import { Image } from "astro:assets";
import icon from "@/features/auth/assets/imgs/icon.svg";
import ResetPasswordForm from "@/features/emailScreens/components/ResetPasswordForm";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Restablecer Contraseña">
  <div class='containerChangePassword'>
    <section class='leftSideContainer'>
      <ResetPasswordForm client:load />
    </section>
    <section class='rightSideContainer'>
      <Image src={icon} alt='Atlas' class='iconAtlas' />
    </section>
  </div>
</Layout>

<style>
  .containerChangePassword {
    display: flex;
    width: 100%;
    height: 100vh;
    padding: 24px;
    gap: 24px;
  }

  .leftSideContainer {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: 1px solid #C6C6C6;
    border-radius: 24px;
    padding: 40px;
    position: relative;
    background: white;
  }

  .rightSideContainer {
    flex: 1;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(180deg, #8751FF 0%, #E7DCFF 100%);
  }

  .iconAtlas {
    position: absolute;
    bottom: -310px;
    right: -200px;
    height: 900px;
    width: 900px;
    transform: rotate(-22.83deg);
  }

  .sideBgImage {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
  }

  /* ── Mobile ─────────────────────────────────── */
  @media (max-width: 1024px) {
    .containerChangePassword {
      padding: 16px;
      gap: 0;
      height: 100dvh;
    }

    .rightSideContainer {
      display: none;
    }

    .leftSideContainer {
      padding: 40px 48px;
      border-radius: 20px;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .containerChangePassword {
      padding: 12px;
    }

    .leftSideContainer {
      padding: 28px 20px;
      border-radius: 16px;
    }
  }

  @media (max-width: 400px) {
    .leftSideContainer {
      padding: 24px 16px;
    }
  }
</style>
