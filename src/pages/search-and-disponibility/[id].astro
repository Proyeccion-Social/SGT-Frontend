---
export const prerender = false;

const { id } = Astro.params;

const res = await fetch(
  `http://localhost:4321/api/search-and-disponibility/${id}`,
);
const tutor = await res.json();
---

<h1>{tutor.name}</h1>

<p>
  <strong>Materias:</strong>
  {tutor.subjects?.map((s) => s.name).join(", ")}
</p>
<p>
  <strong>Calificación:</strong>
  {tutor.averageRating} ({tutor.totalRatings} valoraciones)
</p>
<p><strong>Modalidades:</strong> {tutor.availableModalities?.join(", ")}</p>

<a href={`/search-and-disponibility/${id}/availability`}>
  Ver disponibilidad
</a>
