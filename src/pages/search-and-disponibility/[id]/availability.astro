---
export const prerender = false;

const { id } = Astro.params;

const res = await fetch(
  `http://localhost:4321/api/search-and-disponibility/${id}/availability`,
);
const slotsData = await res.json();
---

<h1>Disponibilidad de {slotsData.tutorName}</h1>

<ul>
  {
    slotsData.availableSlots.map((slot) => (
      <li>
        {slot.dayOfWeek} - {slot.startTime} a {slot.endTime} ({slot.modality})
      </li>
    ))
  }
</ul>
