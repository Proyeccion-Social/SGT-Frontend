---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../features/search/components/SearchBar.astro";
import DialogFilter from "../../features/search/components/DialogFilter.astro";
import TutorList from "../../features/search/components/TutorList.astro";
import TutorDetail from "../../features/search/components/TutorDetail.astro";
import Sidebar from "@/features/dashboards/components/Sidebar.astro";



---

<Layout title="Explorar tutores">
  <div class="page-wrapper">
    <Sidebar userRole="student" />

    <div class="search-page">
      <SearchBar />
      <DialogFilter />
      
        <TutorList />
        <TutorDetail />
      
    </div>
  </div>
</Layout>

<style>
  .page-wrapper {
    display: flex;
    height: 100vh;
  }

  .search-page {
    justify-content: start;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem;
    overflow-y: scroll

  }

  .search-content {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .search-content {
      flex-direction: column;
    }
  }
</style>
