---
import DashboardLayout from "@/layouts/dashboards/DashboardLayout.astro";
import SessionDetailOpener from "@/features/sessions/components/SessionDetailOpener";
import { getUserIdFromCookie } from "@/features/auth/utils/authUtils";
import { UserRole } from "@/constants/roles";

const { id } = Astro.params;

const token = Astro.cookies.get("access_token")?.value;
if (!token || !id) {
  return Astro.redirect("/?session=expired");
}

const payload = JSON.parse(atob(token.split(".")[1]));
const userRole = payload.role.toLowerCase() as UserRole;
const titles: Record<string, string> = {
  admin: "Detalle de sesión | Atlas",
  tutor: "Detalle de sesión | Atlas",
  student: "Detalle de sesión | Atlas",
};
---

<DashboardLayout title={titles[userRole]} rol={userRole}>
  <article>
    <SessionDetailOpener sessionId={id} client:only='react' />
  </article>
</DashboardLayout>
