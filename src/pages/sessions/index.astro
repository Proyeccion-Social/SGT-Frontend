---
import StudentSchedule from "@features/sessions/components/StudentSchedule.astro";
import { fade } from "astro:transitions";
import DashboardLayout from "@/layouts/dashboards/DashboardLayout.astro";
import { UserRole } from "@/constants/roles";

const token = Astro.cookies.get("access_token")?.value;

if (!token) {
  return Astro.redirect("/?session=expired");
}
---

<DashboardLayout title="Programar sesión" rol={UserRole.STUDENT}>
  <article class="sessions-wrapper" transition:animate={fade({ duration: "0.3s" })}>
    <StudentSchedule />
  </article>
</DashboardLayout>

<style>
  .sessions-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    height: 100%;
  }
</style>
