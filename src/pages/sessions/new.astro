---
import Calendar from '../../features/availability/components/Calendar.astro';
import type { Slot } from '../../features/availability/services/availabilityService';

// Verificar auth (patrón existente)
const token = Astro.cookies.get('access_token')?.value;
if (!token) {
  return Astro.redirect('/');
}

// Llamar al endpoint de TODOS los slots de todos los tutores
const availabilityParams = new URLSearchParams({
  modality: 'VIRT',
  onlyAvailable: 'true',
});

const API_URL = import.meta.env.API_URL;

console.log('API_URL:', API_URL); // ← AÑADE ESTO
console.log('PUBLIC_API_URL:', import.meta.env.API_URL); // ← Y ESTO

const res = await fetch(
  `${API_URL}/availability/tutors/slots`,
  {
    headers: {
      'Cookie': `access_token=${token}`,
    },
  },
);

if (!res.ok) {
  console.error('Error cargando disponibilidad:', await res.text());
  // Fallback: slots vacíos o página de error
  return Astro.redirect('/dashboard');
}

const { slots } = await res.json() as { slots: Slot[] };
---

<html>
  <head>
    <title>Agendar tutoría - Atlas</title>
  </head>
  <body>
    <main class="max-w-7xl mx-auto p-8">
      <header class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Agendar tutoría</h1>
        <p class="text-lg text-gray-600">
          Selecciona un slot disponible en el calendario para comenzar.
        </p>
      </header>

      <!-- Calendario con slots de TODOS los tutores -->
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <Calendar slots={slots} />
      </div>

      <!-- Modal del wizard (Steps 3-4) -->
      <div id="wizard-modal" class="fixed inset-0 z-50 hidden">
        <div
          class="fixed inset-0 bg-black/60 backdrop-blur-sm"
          id="wizard-modal-overlay"
        ></div>
        <div
          id="wizard-modal-content"
          class="fixed left-1/2 top-1/2 z-50 w-full max-w-2xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-6 shadow-2xl max-h-[90vh] overflow-y-auto"
        ></div>
      </div>
    </main>
  </body>
</html>

<script>
    
    import type {CreateSessionDTO} from '../../features/sessions/types/session.types'
    const calendar = document.querySelector('.calendar-wrapper');
    const modal = document.getElementById('wizard-modal') as HTMLElement | null;
    const overlay = document.getElementById('wizard-modal-overlay') as HTMLElement | null;
    const content = document.getElementById('wizard-modal-content') as HTMLElement | null;

    if (!modal || !overlay || !content) {
        console.error('Modal elements not found');
    }

    // Escuchar clicks en slots desde Calendar.astro
    document.addEventListener('slot:clicked', (event) => {
        const slot = (event as CustomEvent<any>).detail;
        openWizardModal(slot);
    });

    function openWizardModal(slotData: any) {
        const wizardData = {
        tutorId: slotData.tutorId || '',
        date: slotData.date,
        duration: slotData.duration,
        modality: slotData.modality,
        };
        content!.innerHTML = generateWizardContent(wizardData);
        modal!.classList.remove('hidden');
    }

    function closeWizardModal() {
        modal?.classList.add('hidden');
    }

    overlay?.addEventListener('click', closeWizardModal);
        document.addEventListener('click', (event) => {
            if (!event.target) return;
            const target = event.target as HTMLElement;
            if (target.id === 'wizard-close') {
            closeWizardModal();
            }
    });

    // Helpers
    function calculateDuration(start: string, end: string): number {
        const [sh, sm] = start.split(':').map(Number);
        const [eh, em] = end.split(':').map(Number);
        const startMin = sh * 60 + sm;
        const endMin = eh * 60 + em;
        return (endMin - startMin) / 60;
    }

    function getDateFromSlot(slot: any): string {
        // TODO: implementar según tu lógica de dayOfWeek → fecha
        // Por ahora placeholder basado en semana actual
        return '2026-03-23';
    }

    function generateWizardContent(wizardData: any): string {
        return `
        <div class="wizard-modal-content">
            <header class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-semibold">Nueva tutoría</h3>
            <button id="wizard-close" class="text-gray-400 hover:text-gray-600">×</button>
            </header>

            <!-- Resumen del slot seleccionado -->
            <div class="mb-8 rounded-lg border border-gray-200 bg-gray-50 p-4">
            <h4 class="font-medium mb-2">Slot seleccionado</h4>
            <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                <span class="text-gray-600">Fecha/Hora:</span>
                <p class="font-medium">${wizardData.date}</p>
                </div>
                <div>
                <span class="text-gray-600">Duración:</span>
                <p class="font-medium">${wizardData.duration} h</p>
                </div>
                <div>
                <span class="text-gray-600">Modalidad:</span>
                <p class="font-medium">${wizardData.modality}</p>
                </div>
            </div>
            </div>

            <!-- Step 3: Título y descripción -->
            <div id="wizard-step3" class="space-y-6">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Título</label>
                <input
                id="wizard-title"
                type="text"
                class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
                maxlength="150"
                placeholder="Ej: Ayuda con derivadas"
                />
                <div id="wizard-title-counter" class="flex justify-between text-xs text-gray-500">
                0/100 caracteres
                </div>
            </div>

            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Descripción</label>
                <textarea
                id="wizard-description"
                class="min-h-[100px] w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
                maxlength="500"
                placeholder="Describe qué necesitas..."
                ></textarea>
                <div id="wizard-desc-counter" class="flex justify-between text-xs text-gray-500">
                0/500 caracteres
                </div>
            </div>

            <button
                id="wizard-next"
                class="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white"
                disabled
            >
                Continuar
            </button>
            </div>

            <!-- Step 4: Preview (inicialmente oculto) -->
            <div id="wizard-step4" class="hidden space-y-6">
            <!-- Preview del DTO completo -->
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                <h4 class="font-medium mb-4">Resumen de la tutoría</h4>
                <div id="wizard-preview" class="text-sm space-y-2"></div>
            </div>

            <div class="flex gap-3">
                <button
                id="wizard-back"
                type="button"
                class="flex-1 rounded-md border border-gray-300 px-4 py-2 text-sm"
                >
                Editar detalles
                </button>
                <button
                id="wizard-submit"
                type="button"
                class="flex-1 rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white"
                >
                Confirmar sesión
                </button>
            </div>
            </div>
        </div>
        `;
    }

    calendar?.addEventListener('click', (event) => {
        if (!event.target) return;
        
        const target = event.target as HTMLElement;
        const slotElement = target.closest('.slot-block');
        
        if (!slotElement || 
            !(slotElement instanceof HTMLElement) ||
            slotElement.classList.contains('slot-booked') || 
            slotElement.classList.contains('slot-past')) {
            return;
        }

        const slotBlock = slotElement as HTMLElement;
        
        const slotData = {
            id: slotBlock.dataset.slotIds?.split(',')[0] || '',
            dayOfWeek: slotBlock.dataset.day as string,
            startTime: slotBlock.dataset.start as string,
            endTime: slotBlock.dataset.end as string,
            modality: slotBlock.dataset.modality as string,
        };

        openWizardModal(slotData);
    });

        // Listener del modal (separado)
        document.addEventListener('click', (event) => {
        if (!event.target) return;
        
        const target = event.target as HTMLElement;
        
        if (target.id === 'wizard-close') {
            closeWizardModal();
        }
        // otros botones del modal...
        });


    async function handleWizardSubmit(slotData: any) {
        const title = (document.getElementById('wizard-title') as HTMLInputElement)?.value || '';
        const description = (document.getElementById('wizard-description') as HTMLTextAreaElement)?.value || '';

        if (!title.trim() || !description.trim()) {
        alert('Título y descripción son requeridos');
        return;
        }

        const sessionData: CreateSessionDTO = {
        tutorId: slotData.tutorId || '',
        date: slotData.date,
        duration: slotData.duration,
        title,
        description,
        modality: slotData.modality,
        };

        try {
        const res = await fetch('/sessions', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(sessionData),
        });

        if (!res.ok) {
            const error = await res.json();
            alert(error.message || 'Error al agendar sesión');
            return;
        }

        closeWizardModal();
        // Éxito
        alert('¡Sesión agendada exitosamente!');
        window.location.reload(); // o redirigir a dashboard
        } catch (error) {
        alert('Error de red al agendar');
        }
    }
</script>
